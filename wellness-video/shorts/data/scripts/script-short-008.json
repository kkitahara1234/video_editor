      "emphasis": []
    },
    {
      "text": "しています",
      "startSec": 93.24666666666644,
      "endSec": 93.67999999999984,
      "emphasis": []
    },
    {
      "text": "さらにはですね",
      "startSec": 94.26000000000022,
      "endSec": 95.10000000000036,
      "emphasis": []
    },
    {
      "text": "このメンバーシップに",

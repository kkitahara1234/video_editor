{
  "shortId": "short-003",
  "title": "夜の筋トレのリスク",
  "startSec": 400,
  "endSec": 463.16,
  "telops": [
    {
      "text": "逆にですねあの",
      "startSec": 0.01999999999998181,
      "endSec": 1.2300000000000182,
      "emphasis": []
    },
    {
      "text": "会食が終わった",
      "startSec": 1.2300000000000182,
      "endSec": 2.4399999999999977,
      "emphasis": []
    },
    {
      "text": "後とかにですね",
      "startSec": 2.4399999999999977,
      "endSec": 4.100000000000023,
      "emphasis": []
    },
    {
      "text": "あのジムに行って",
      "startSec": 4.100000000000023,
      "endSec": 5.759999999999991,
      "emphasis": []
    },
    {
      "text": "もうがっつり筋トレ",
      "startSec": 5.759999999999991,
      "endSec": 6.328750000000014,
      "emphasis": [
        {
          "start": 2,
          "end": 7,
          "label": "がっつり筋"
        }
      ]
    },
    {
      "text": "しちゃう",
      "startSec": 6.328750000000014,
      "endSec": 6.783711538461546,
      "emphasis": []
    },
    {
      "text": "人とかいらっしゃる",
      "startSec": 6.783711538461546,
      "endSec": 7.466153846153873,
      "emphasis": []
    },
    {
      "text": "んですけれども",
      "startSec": 7.466153846153873,
      "endSec": 7.939999999999998,
      "emphasis": []
    },
    {
      "text": "夜21時とか22時とかに",
      "startSec": 8.120000000000005,
      "endSec": 10.100000000000023,
      "emphasis": []
    },
    {
      "text": "ですね筋トレしてしまうと",
      "startSec": 10.100000000000023,
      "endSec": 11.699999999999989,
      "emphasis": [
        {
          "start": 3,
          "end": 6,
          "label": "筋トレ"
        }
      ]
    },
    {
      "text": "コルチゾール",
      "startSec": 11.699999999999989,
      "endSec": 12.462352941176448,
      "emphasis": [
        {
          "start": 0,
          "end": 6,
          "label": "コルチゾール"
        }
      ]
    },
    {
      "text": "がですねものすごい量で",
      "startSec": 12.462352941176448,
      "endSec": 13.860000000000014,
      "emphasis": [
        {
          "start": 4,
          "end": 10,
          "label": "ものすごい量"
        }
      ]
    },
    {
      "text": "出てしまって",
      "startSec": 13.860000000000014,
      "endSec": 14.597142857142842,
      "emphasis": []
    },
    {
      "text": "交換神経も非常に",
      "startSec": 14.597142857142842,
      "endSec": 15.579999999999984,
      "emphasis": []
    },
    {
      "text": "活性化してしまいますので",
      "startSec": 15.579999999999984,
      "endSec": 16.680000000000007,
      "emphasis": []
    },
    {
      "text": "結果的にですねやっぱ",
      "startSec": 16.680000000000007,
      "endSec": 17.980000000000018,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "結果的に"
        }
      ]
    },
    {
      "text": "睡眠の質がかなり",
      "startSec": 17.980000000000018,
      "endSec": 19.019999999999982,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "睡眠の質"
        }
      ]
    },
    {
      "text": "落ちてきたりします",
      "startSec": 19.019999999999982,
      "endSec": 20.69999999999999,
      "emphasis": []
    },
    {
      "text": "でまぁ結局",
      "startSec": 20.69999999999999,
      "endSec": 21.54000000000002,
      "emphasis": []
    },
    {
      "text": "筋力トレーニングって",
      "startSec": 21.54000000000002,
      "endSec": 22.59882352941173,
      "emphasis": [
        {
          "start": 0,
          "end": 8,
          "label": "筋力トレーニング"
        }
      ]
    },
    {
      "text": "まあストレスを",
      "startSec": 22.59882352941173,
      "endSec": 23.339999999999975,
      "emphasis": []
    },
    {
      "text": "与えてタンパク質をとって",
      "startSec": 23.339999999999975,
      "endSec": 25.100000000000023,
      "emphasis": []
    },
    {
      "text": "急速させるっていう",
      "startSec": 25.100000000000023,
      "endSec": 25.75999999999999,
      "emphasis": []
    },
    {
      "text": "このサイクルの中でですね",
      "startSec": 25.75999999999999,
      "endSec": 27.879999999999995,
      "emphasis": []
    },
    {
      "text": "筋肥大は起こりますし",
      "startSec": 27.879999999999995,
      "endSec": 28.97999999999996,
      "emphasis": []
    },
    {
      "text": "体の機能って",
      "startSec": 28.97999999999996,
      "endSec": 29.579999999999984,
      "emphasis": []
    },
    {
      "text": "上がっていくものですので",
      "startSec": 29.579999999999984,
      "endSec": 31.25999999999999,
      "emphasis": []
    },
    {
      "text": "まぁこう寝る",
      "startSec": 31.25999999999999,
      "endSec": 32.724000000000046,
      "emphasis": []
    },
    {
      "text": "前にですね運動して",
      "startSec": 32.724000000000046,
      "endSec": 33.660000000000025,
      "emphasis": []
    },
    {
      "text": "まぁ一見こうやったぞ",
      "startSec": 33.660000000000025,
      "endSec": 34.22117647058826,
      "emphasis": []
    },
    {
      "text": "っていう",
      "startSec": 34.22117647058826,
      "endSec": 34.92173542720258,
      "emphasis": []
    },
    {
      "text": "感じになるんですけれども",
      "startSec": 34.92173542720258,
      "endSec": 36.60307692307691,
      "emphasis": []
    },
    {
      "text": "実際には",
      "startSec": 36.60307692307691,
      "endSec": 37.44,
      "emphasis": []
    },
    {
      "text": "この回復の部分をですね",
      "startSec": 37.44,
      "endSec": 38.81333333333333,
      "emphasis": []
    },
    {
      "text": "非常に効率を",
      "startSec": 38.81333333333333,
      "endSec": 39.5,
      "emphasis": []
    },
    {
      "text": "落としてしまう",
      "startSec": 39.5,
      "endSec": 40.43000000000001,
      "emphasis": []
    },
    {
      "text": "ことになるので",
      "startSec": 40.43000000000001,
      "endSec": 41.360000000000014,
      "emphasis": []
    },
    {
      "text": "トータルで考えたら",
      "startSec": 41.360000000000014,
      "endSec": 42.379999999999995,
      "emphasis": []
    },
    {
      "text": "むしろですねあの体が",
      "startSec": 42.379999999999995,
      "endSec": 43.660000000000025,
      "emphasis": []
    },
    {
      "text": "むくみやすく",
      "startSec": 43.660000000000025,
      "endSec": 44.34800000000001,
      "emphasis": []
    },
    {
      "text": "なっちゃったりとかですね",
      "startSec": 44.34800000000001,
      "endSec": 45.69499999999999,
      "emphasis": []
    },
    {
      "text": "あのマイナスな方向に行く",
      "startSec": 45.69499999999999,
      "endSec": 46.639999999999986,
      "emphasis": []
    },
    {
      "text": "可能性も",
      "startSec": 46.639999999999986,
      "endSec": 47.194285714285684,
      "emphasis": []
    },
    {
      "text": "ありますということで",
      "startSec": 47.194285714285684,
      "endSec": 48.579999999999984,
      "emphasis": []
    },
    {
      "text": "どうしてもな",
      "startSec": 48.579999999999984,
      "endSec": 49.30000000000001,
      "emphasis": []
    },
    {
      "text": "理由がない限りは",
      "startSec": 49.30000000000001,
      "endSec": 50.25999999999999,
      "emphasis": []
    },
    {
      "text": "深夜ですね",
      "startSec": 50.30000000000001,
      "endSec": 51.192499999999995,
      "emphasis": []
    },
    {
      "text": "寝る前とかにハードな",
      "startSec": 51.192499999999995,
      "endSec": 52.68000000000001,
      "emphasis": []
    },
    {
      "text": "筋トレをするって",
      "startSec": 52.68000000000001,
      "endSec": 53.23466666666667,
      "emphasis": []
    },
    {
      "text": "のはやめた方が",
      "startSec": 53.23466666666667,
      "endSec": 53.72000000000003,
      "emphasis": []
    },
    {
      "text": "いいのでせめてですね",
      "startSec": 53.72000000000003,
      "endSec": 55.05333333333334,
      "emphasis": []
    },
    {
      "text": "会食終わった後に",
      "startSec": 55.05333333333334,
      "endSec": 56.120000000000005,
      "emphasis": []
    },
    {
      "text": "20分から",
      "startSec": 56.120000000000005,
      "endSec": 56.59333333333336,
      "emphasis": []
    },
    {
      "text": "40分ぐらいちょっと",
      "startSec": 56.59333333333336,
      "endSec": 57.54000000000002,
      "emphasis": []
    },
    {
      "text": "こう軽く",
      "startSec": 57.54000000000002,
      "endSec": 58.21733333333333,
      "emphasis": []
    },
    {
      "text": "ウォーキングしてあげて",
      "startSec": 58.21733333333333,
      "endSec": 60.079999999999984,
      "emphasis": []
    },
    {
      "text": "血中の糖をですね",
      "startSec": 60.079999999999984,
      "endSec": 60.75999999999999,
      "emphasis": []
    },
    {
      "text": "使ってあげるぐらいに",
      "startSec": 60.75999999999999,
      "endSec": 61.60000000000002,
      "emphasis": []
    },
    {
      "text": "留めるのがいいんじゃ",
      "startSec": 61.60000000000002,
      "endSec": 62.26999999999998,
      "emphasis": []
    },
    {
      "text": "ないかなという",
      "startSec": 62.26999999999998,
      "endSec": 62.74000000000001,
      "emphasis": []
    },
    {
      "text": "ふうに考えています",
      "startSec": 62.74000000000001,
      "endSec": 63.160000000000025,
      "emphasis": []
    }
  ],
  "cameraSwitches": [
    {
      "atSec": 0,

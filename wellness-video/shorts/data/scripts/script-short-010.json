{
  "shortId": "short-010",
  "title": "無形資産の重要性",
  "startSec": 465.04,
  "endSec": 600,
  "telops": [
    {
      "text": "でですね今世界でもですね",
      "startSec": 0,
      "endSec": 2.579999999999984,
      "emphasis": []
    },
    {
      "text": "このLongevity",
      "startSec": 2.579999999999984,
      "endSec": 3.5095000000000027,
      "emphasis": []
    },
    {
      "text": "というワードがですね",
      "startSec": 3.5095000000000027,
      "endSec": 4.882352941176464,
      "emphasis": []
    },
    {
      "text": "あのものすごい盛り",
      "startSec": 4.882352941176464,
      "endSec": 5.919999999999959,
      "emphasis": []
    },
    {
      "text": "上がってきていまして",
      "startSec": 5.919999999999959,
      "endSec": 6.819999999999993,
      "emphasis": []
    },
    {
      "text": "Longevity",
      "startSec": 7.139999999999986,
      "endSec": 8.183999999999969,
      "emphasis": []
    },
    {
      "text": "ってもまさに健康に長く",
      "startSec": 8.183999999999969,
      "endSec": 9.45999999999998,
      "emphasis": []
    },
    {
      "text": "生きるっていう",
      "startSec": 9.45999999999998,
      "endSec": 10.455294117647043,
      "emphasis": []
    },
    {
      "text": "ことなんですけれども",
      "startSec": 10.455294117647043,
      "endSec": 11.877142857142815,
      "emphasis": []
    },
    {
      "text": "皆さん",
      "startSec": 11.877142857142815,
      "endSec": 12.279999999999973,
      "emphasis": []
    },
    {
      "text": "ブライアン・\u0000PN1\u0000",
      "startSec": 12.939999999999998,
      "endSec": 13.921538461538432,
      "emphasis": []
    },
    {
      "text": "っていうですねアメリカの",
      "startSec": 13.921538461538432,
      "endSec": 15.299999999999955,
      "emphasis": []
    },
    {
      "text": "富裕層の方は",
      "startSec": 15.299999999999955,
      "endSec": 16.019999999999982,
      "emphasis": []
    },
    {
      "text": "知ってますかね",
      "startSec": 16.019999999999982,
      "endSec": 16.859999999999957,
      "emphasis": []
    },
    {
      "text": "Netflixっていう",
      "startSec": 16.859999999999957,
      "endSec": 17.939999999999998,
      "emphasis": []
    },
    {
      "text": "番組でですね",
      "startSec": 17.939999999999998,
      "endSec": 19.051249999999982,
      "emphasis": []
    },
    {
      "text": "Don't Die",
      "startSec": 19.051249999999982,
      "endSec": 20.47999999999996,
      "emphasis": []
    },
    {
      "text": "っていう番組があったり",
      "startSec": 20.47999999999996,
      "endSec": 21.91999999999996,
      "emphasis": []
    },
    {
      "text": "しますけれども",
      "startSec": 21.91999999999996,
      "endSec": 22.639999999999986,
      "emphasis": []
    },
    {
      "text": "とにかくですね",
      "startSec": 22.939999999999998,
      "endSec": 24.217499999999973,
      "emphasis": []
    },
    {
      "text": "年間数億円を自分の",
      "startSec": 24.217499999999973,
      "endSec": 25.859999999999957,
      "emphasis": []
    },
    {
      "text": "健康に投資",
      "startSec": 25.859999999999957,
      "endSec": 26.66666666666663,
      "emphasis": []
    },
    {
      "text": "して寿命を伸ばそうと",
      "startSec": 26.66666666666663,
      "endSec": 28.279999999999973,
      "emphasis": []
    },
    {
      "text": "しているような方",
      "startSec": 28.279999999999973,
      "endSec": 29.70933333333329,
      "emphasis": []
    },
    {
      "text": "になっています",
      "startSec": 29.70933333333329,
      "endSec": 30.95999999999998,
      "emphasis": []
    },
    {
      "text": "彼自身もですねやっぱ",
      "startSec": 31.21999999999997,
      "endSec": 32.99647058823524,
      "emphasis": []
    },
    {
      "text": "こう多額の富を",
      "startSec": 32.99647058823524,
      "endSec": 34.23999999999995,
      "emphasis": []
    },
    {
      "text": "得てすごくお金を",
      "startSec": 34.23999999999995,
      "endSec": 35.73647058823525,
      "emphasis": []
    },
    {
      "text": "得たんですけれども",
      "startSec": 35.73647058823525,
      "endSec": 37.41999999999996,
      "emphasis": []
    },
    {
      "text": "それと引き換えにですね",
      "startSec": 37.639999999999986,
      "endSec": 39.28352941176473,
      "emphasis": []
    },
    {
      "text": "自分の健康を",
      "startSec": 39.28352941176473,
      "endSec": 40.18000000000001,
      "emphasis": []
    },
    {
      "text": "失ってパフォーマンスが",
      "startSec": 40.18000000000001,
      "endSec": 41.65999999999997,
      "emphasis": []
    },
    {
      "text": "高くなかったり",
      "startSec": 41.65999999999997,
      "endSec": 43.011999999999944,
      "emphasis": []
    },
    {
      "text": "人間関係の大切さをですね",
      "startSec": 43.011999999999944,
      "endSec": 45.039999999999964,
      "emphasis": []
    },
    {
      "text": "一時的に",
      "startSec": 45.039999999999964,
      "endSec": 45.54285714285709,
      "emphasis": []
    },
    {
      "text": "忘れてしまって本当に",
      "startSec": 45.54285714285709,
      "endSec": 46.799999999999955,
      "emphasis": []
    },
    {
      "text": "お金ばかり",
      "startSec": 46.799999999999955,
      "endSec": 47.307142857142765,
      "emphasis": []
    },
    {
      "text": "追いかけてしまった",
      "startSec": 47.307142857142765,
      "endSec": 48.21999999999997,
      "emphasis": []
    },
    {
      "text": "みたいなことに",
      "startSec": 48.21999999999997,
      "endSec": 49.097333333333324,
      "emphasis": []
    },
    {
      "text": "後悔をしてですね",
      "startSec": 49.097333333333324,
      "endSec": 50.099999999999966,
      "emphasis": []
    },
    {
      "text": "これからはやっぱ",
      "startSec": 50.099999999999966,
      "endSec": 51.117142857142824,
      "emphasis": []
    },
    {
      "text": "自分の健康を",
      "startSec": 51.117142857142824,
      "endSec": 51.87999999999994,
      "emphasis": []
    },
    {
      "text": "維持するっていうことが",
      "startSec": 51.87999999999994,
      "endSec": 52.96428571428561,
      "emphasis": []
    },
    {
      "text": "何より",
      "startSec": 52.96428571428561,
      "endSec": 53.259999999999934,
      "emphasis": []
    },
    {
      "text": "大事だっていうことを",
      "startSec": 53.259999999999934,
      "endSec": 54.49999999999994,
      "emphasis": []
    },
    {
      "text": "発信しているような",
      "startSec": 54.49999999999994,
      "endSec": 55.68588235294118,
      "emphasis": []
    },
    {
      "text": "方になっています",
      "startSec": 55.68588235294118,
      "endSec": 56.73999999999995,
      "emphasis": []
    },
    {
      "text": "でまあ皆さんもですね",
      "startSec": 57.579999999999984,
      "endSec": 59.03714285714278,
      "emphasis": []
    },
    {
      "text": "あのこの",
      "startSec": 59.03714285714278,
      "endSec": 59.61999999999995,
      "emphasis": []
    },
    {
      "text": "動画見ている方は",
      "startSec": 59.61999999999995,
      "endSec": 60.590666666666664,
      "emphasis": []
    },
    {
      "text": "多分ビジネスを",
      "startSec": 60.590666666666664,
      "endSec": 61.44,
      "emphasis": []
    },
    {
      "text": "バリバリされていたりとか",
      "startSec": 61.44,
      "endSec": 62.579999999999984,
      "emphasis": []
    },
    {
      "text": "投資を頑張っていたりとか",
      "startSec": 62.63999999999993,
      "endSec": 64.36730434782606,
      "emphasis": []
    },
    {
      "text": "ですねですね",
      "startSec": 64.36730434782606,
      "endSec": 65.25217391304346,
      "emphasis": []
    },
    {
      "text": "まあこう何かしら",
      "startSec": 65.25217391304346,
      "endSec": 66.47652173913042,
      "emphasis": []
    },
    {
      "text": "自分のやりたいこととか",
      "startSec": 66.47652173913042,
      "endSec": 68.16000000000003,
      "emphasis": []
    },
    {
      "text": "夢に向かってですね",
      "startSec": 68.49999999999994,
      "endSec": 69.56999999999988,
      "emphasis": []
    },
    {
      "text": "頑張っている方だと思う",
      "startSec": 69.56999999999988,
      "endSec": 70.61499999999995,
      "emphasis": []
    },
    {
      "text": "んですけれども",
      "startSec": 70.61499999999995,
      "endSec": 71.28000000000003,
      "emphasis": []
    },
    {
      "text": "多くの方はですねやっぱり",
      "startSec": 72.11999999999995,
      "endSec": 74.45999999999998,
      "emphasis": []
    },
    {
      "text": "有形",
      "startSec": 74.45999999999998,
      "endSec": 74.73999999999995,
      "emphasis": []
    },
    {
      "text": "資産といって目に見える",
      "startSec": 74.73999999999995,
      "endSec": 76.28000000000003,
      "emphasis": []
    },
    {
      "text": "資産にですね目が",
      "startSec": 76.28000000000003,
      "endSec": 77.3341176470588,
      "emphasis": []
    },
    {
      "text": "行きがちなんですね",
      "startSec": 77.3341176470588,
      "endSec": 78.51999999999992,
      "emphasis": []
    },
    {
      "text": "お金だったり車だったり",
      "startSec": 78.59999999999997,
      "endSec": 80.57999999999998,
      "emphasis": []
    },
    {
      "text": "時計だったり",
      "startSec": 80.57999999999998,
      "endSec": 81.30749999999995,
      "emphasis": []
    },
    {
      "text": "不動産だったりですね",
      "startSec": 81.30749999999995,
      "endSec": 82.51999999999992,
      "emphasis": []
    },
    {
      "text": "こういう目に",
      "startSec": 82.78000000000003,
      "endSec": 83.61999999999995,
      "emphasis": []
    },
    {
      "text": "見えるものっていう",
      "startSec": 83.61999999999995,
      "endSec": 84.87999999999994,
      "emphasis": []
    },
    {
      "text": "ものを追いかけ",
      "startSec": 84.87999999999994,
      "endSec": 85.57999999999998,
      "emphasis": []
    },
    {
      "text": "がちなんですけれども",
      "startSec": 85.57999999999998,
      "endSec": 86.57999999999998,
      "emphasis": []
    },
    {
      "text": "実際にはですね無形資産と",
      "startSec": 87.07999999999998,
      "endSec": 89.42000000000002,
      "emphasis": []
    },
    {
      "text": "いってですね",
      "startSec": 89.42000000000002,
      "endSec": 90.08857142857147,
      "emphasis": []
    },
    {
      "text": "目に見えない資産",
      "startSec": 90.08857142857147,
      "endSec": 90.97999999999996,
      "emphasis": []
    },
    {
      "text": "というのがものすごく",
      "startSec": 90.97999999999996,
      "endSec": 92.47999999999996,
      "emphasis": []
    },
    {
      "text": "重要ですよと",
      "startSec": 92.47999999999996,
      "endSec": 93.37999999999994,
      "emphasis": []
    },
    {
      "text": "健康ももちろん",
      "startSec": 93.37999999999994,
      "endSec": 94.63999999999993,
      "emphasis": []
    },
    {
      "text": "そうですし健康だからこそ",
      "startSec": 94.63999999999993,
      "endSec": 96.80000000000001,
      "emphasis": []
    },
    {
      "text": "らこそ",
      "startSec": 96.80000000000001,
      "endSec": 97.13600000000002,
      "emphasis": []
    },
    {
      "text": "得られる体験だったりとか",
      "startSec": 97.13600000000002,
      "endSec": 98.47999999999996,
      "emphasis": []
    },
    {
      "text": "それから人間",
      "startSec": 98.87999999999994,
      "endSec": 99.71199999999993,
      "emphasis": []
    },
    {
      "text": "関係ですねまあ家族",
      "startSec": 99.71199999999993,
      "endSec": 100.95999999999998,
      "emphasis": []
    },
    {
      "text": "だったり友人だったり",
      "startSec": 100.95999999999998,
      "endSec": 102.18222222222226,
      "emphasis": []
    },
    {
      "text": "仲間みたいなもの",
      "startSec": 102.18222222222226,
      "endSec": 103.16000000000003,
      "emphasis": []
    },
    {
      "text": "を得られているかどうか",
      "startSec": 103.16000000000003,
      "endSec": 104.83999999999997,
      "emphasis": []
    },
    {
      "text": "こういうもののすべての",
      "startSec": 104.83999999999997,
      "endSec": 106.13999999999993,
      "emphasis": []
    },
    {
      "text": "トータルがですね",
      "startSec": 106.13999999999993,
      "endSec": 107.60666666666663,
      "emphasis": []
    },
    {
      "text": "人生の豊かさだったり",
      "startSec": 107.60666666666663,
      "endSec": 109.44,
      "emphasis": []
    },
    {
      "text": "人生で得た資産の",
      "startSec": 109.44,
      "endSec": 110.80470588235295,
      "emphasis": []
    },
    {
      "text": "合計になりますよと",
      "startSec": 110.80470588235295,
      "endSec": 112.33999999999997,
      "emphasis": []
    },
    {
      "text": "いうことでですね",
      "startSec": 112.33999999999997,
      "endSec": 113.69111111111107,
      "emphasis": []
    },
    {
      "text": "あのまあ結構やっぱり",
      "startSec": 113.69111111111107,
      "endSec": 115.37999999999994,
      "emphasis": []
    },
    {
      "text": "こう資本主義社会になって",
      "startSec": 115.37999999999994,
      "endSec": 116.92000000000002,
      "emphasis": []
    },
    {
      "text": "こうある意味",
      "startSec": 116.92000000000002,
      "endSec": 117.92000000000002,
      "emphasis": []
    },
    {
      "text": "経営をしていたり",
      "startSec": 117.92000000000002,
      "endSec": 119.03157894736847,
      "emphasis": []
    },
    {
      "text": "投資をしていたりすると",
      "startSec": 119.03157894736847,
      "endSec": 120.56,
      "emphasis": []
    },
    {
      "text": "こう会社の",
      "startSec": 120.56,
      "endSec": 121.52923076923076,
      "emphasis": []
    },
    {
      "text": "業績がどうだとか",
      "startSec": 121.52923076923076,
      "endSec": 123.07999999999998,
      "emphasis": []
    },
    {
      "text": "持っている資産額が",
      "startSec": 123.42000000000002,
      "endSec": 124.63999999999993,
      "emphasis": []
    },
    {
      "text": "いくらだとかですね",
      "startSec": 124.63999999999993,
      "endSec": 125.71999999999997,
      "emphasis": []
    },
    {
      "text": "この数字で測れるもの",
      "startSec": 125.71999999999997,
      "endSec": 126.92000000000002,
      "emphasis": []
    },
    {
      "text": "で評価をされがちですし",
      "startSec": 126.92000000000002,
      "endSec": 128.71999999999997,
      "emphasis": []
    },
    {
      "text": "自分自身のこともですね",
      "startSec": 128.71999999999997,
      "endSec": 130.37999999999994,
      "emphasis": []
    },
    {
      "text": "そういうふうに",
      "startSec": 130.37999999999994,
      "endSec": 131.06133333333327,
      "emphasis": []
    },
    {
      "text": "評価してしまう人",
      "startSec": 131.06133333333327,
      "endSec": 131.83999999999997,
      "emphasis": []
    },
    {
      "text": "っていうのが",
      "startSec": 131.83999999999997,
      "endSec": 132.21999999999997,
      "emphasis": []
    }
  ],

      "endSec": 55.1753846153847,
      "emphasis": []
    },
    {
      "text": "自分の健康データをすべて",
      "startSec": 55.1753846153847,
      "endSec": 56.61250000000018,
      "emphasis": []
    },
    {
      "text": "管理してですね",
      "startSec": 56.61250000000018,

{
  "shortId": "short-012",
  "title": "サプリメントの選び方",
  "startSec": 3101.96,
  "endSec": 3187.46,
  "telops": [
    {
      "text": "実際にこの",
      "startSec": 0,
      "endSec": 0.533333333333303,
      "emphasis": []
    },
    {
      "text": "サプリメントを飲んだ",
      "startSec": 0.533333333333303,
      "endSec": 1.599999999999909,
      "emphasis": []
    },
    {
      "text": "結果どのデータが",
      "startSec": 1.599999999999909,
      "endSec": 2.400000000000091,
      "emphasis": []
    },
    {
      "text": "どういうふうに",
      "startSec": 2.400000000000091,
      "endSec": 3.099999999999909,
      "emphasis": []
    },
    {
      "text": "変わったのかという",
      "startSec": 3.099999999999909,
      "endSec": 3.980000000000018,
      "emphasis": []
    },
    {
      "text": "こともですね",
      "startSec": 3.980000000000018,
      "endSec": 4.639999999999873,
      "emphasis": []
    },
    {
      "text": "しっかり分析",
      "startSec": 4.639999999999873,
      "endSec": 5.273333333333085,
      "emphasis": [
        {
          "start": 0,
          "end": 6,
          "label": "しっかり分析"
        }
      ]
    },
    {
      "text": "できるようになっています",
      "startSec": 5.273333333333085,
      "endSec": 6.539999999999964,
      "emphasis": []
    },
    {
      "text": "結構皆さんサプリメ",
      "startSec": 6.539999999999964,
      "endSec": 7.680000000000291,
      "emphasis": []
    },
    {
      "text": "ントとかもね友達に",
      "startSec": 7.680000000000291,
      "endSec": 8.820000000000164,
      "emphasis": []
    },
    {
      "text": "勧められてなんか",
      "startSec": 8.820000000000164,
      "endSec": 10.042857142857429,
      "emphasis": []
    },
    {
      "text": "これ飲んだら",
      "startSec": 10.042857142857429,
      "endSec": 10.960000000000036,
      "emphasis": []
    },
    {
      "text": "いいよとか元気",
      "startSec": 10.960000000000036,
      "endSec": 12.06117647058818,
      "emphasis": []
    },
    {
      "text": "になるよとか疲れが",
      "startSec": 12.06117647058818,
      "endSec": 13.300000000000182,
      "emphasis": []
    },
    {
      "text": "取れるよとかですね",
      "startSec": 13.300000000000182,
      "endSec": 14.764000000000124,
      "emphasis": []
    },
    {
      "text": "感覚で始めて",
      "startSec": 14.764000000000124,
      "endSec": 15.739999999999782,
      "emphasis": []
    },
    {
      "text": "なんとなく聞いてるのが",
      "startSec": 15.739999999999782,
      "endSec": 16.64444444444416,
      "emphasis": []
    },
    {
      "text": "聞いてないのか",
      "startSec": 16.64444444444416,
      "endSec": 17.2199999999998,
      "emphasis": []
    },
    {
      "text": "わからなくて気づいたらや",
      "startSec": 17.2199999999998,
      "endSec": 18.326666666666824,
      "emphasis": []
    },
    {
      "text": "めているとか",
      "startSec": 18.326666666666824,
      "endSec": 18.88000000000011,
      "emphasis": []
    },
    {
      "text": "逆に漫然ともう何年も",
      "startSec": 18.88000000000011,
      "endSec": 20.7199999999998,
      "emphasis": []
    },
    {
      "text": "飲み続けてし",
      "startSec": 20.7199999999998,
      "endSec": 21.253333333333103,
      "emphasis": []
    },
    {
      "text": "まっているみたいなことに",
      "startSec": 21.253333333333103,
      "endSec": 22.320000000000164,
      "emphasis": []
    },
    {
      "text": "なりがちですけれども",
      "startSec": 22.320000000000164,
      "endSec": 23.706666666666933,
      "emphasis": []
    },
    {
      "text": "何かしらの",
      "startSec": 23.706666666666933,
      "endSec": 24.40000000000009,
      "emphasis": []
    },
    {
      "text": "データを改善するためにね",
      "startSec": 24.40000000000009,
      "endSec": 26.019999999999982,
      "emphasis": []
    },
    {
      "text": "サプリメント飲むもの",
      "startSec": 26.019999999999982,
      "endSec": 27.23999999999978,
      "emphasis": []
    },
    {
      "text": "だったりしますので",
      "startSec": 27.23999999999978,
      "endSec": 28.26705882352917,
      "emphasis": []
    },
    {
      "text": "まぁ実際彼それを",
      "startSec": 28.26705882352917,
      "endSec": 29.179999999999836,
      "emphasis": []
    },
    {
      "text": "取ったことによって",
      "startSec": 29.179999999999836,
      "endSec": 30.28571428571422,
      "emphasis": []
    },
    {
      "text": "自分の体がどう変化したか",
      "startSec": 30.28571428571422,
      "endSec": 31.759999999999764,
      "emphasis": []
    },
    {
      "text": "っていうのを",
      "startSec": 31.759999999999764,
      "endSec": 32.41142857142813,
      "emphasis": []
    },
    {
      "text": "統合管理していく",
      "startSec": 32.41142857142813,
      "endSec": 33.279999999999745,
      "emphasis": []
    },
    {
      "text": "ことっていうのが",
      "startSec": 33.279999999999745,
      "endSec": 34.340000000000146,
      "emphasis": []
    },
    {
      "text": "よりですね健康寿命を",
      "startSec": 34.340000000000146,
      "endSec": 36.13999999999987,
      "emphasis": []
    },
    {
      "text": "伸ばす上でも",
      "startSec": 36.13999999999987,
      "endSec": 36.9588235294118,
      "emphasis": []
    },
    {
      "text": "重要になってきますので",
      "startSec": 36.9588235294118,
      "endSec": 38.460000000000036,
      "emphasis": []
    },
    {
      "text": "幅広くしっかりと",
      "startSec": 38.940000000000055,
      "endSec": 40.059999999999945,
      "emphasis": []
    },
    {
      "text": "搭載していたりします",
      "startSec": 40.059999999999945,
      "endSec": 42.614444444444416,
      "emphasis": []
    },
    {
      "text": "あくまでですね",
      "startSec": 42.614444444444416,
      "endSec": 44.23999999999978,
      "emphasis": []
    },
    {
      "text": "このアプリっていう",
      "startSec": 44.23999999999978,
      "endSec": 45.48714285714277,
      "emphasis": []
    },
    {
      "text": "のは材料の",
      "startSec": 45.48714285714277,
      "endSec": 46.179999999999836,
      "emphasis": []
    },
    {
      "text": "1個でしかない",
      "startSec": 46.179999999999836,
      "endSec": 46.80000000000018,
      "emphasis": []
    },
    {
      "text": "んですけれども",
      "startSec": 46.80000000000018,
      "endSec": 47.42000000000007,
      "emphasis": []
    },
    {
      "text": "やっぱりですね",
      "startSec": 47.659999999999854,
      "endSec": 48.75846153846123,
      "emphasis": []
    },
    {
      "text": "今の時代その",
      "startSec": 48.75846153846123,
      "endSec": 49.69999999999982,
      "emphasis": []
    },
    {
      "text": "感覚ではなくてデータに",
      "startSec": 49.69999999999982,
      "endSec": 51.36000000000013,
      "emphasis": []
    },
    {
      "text": "基づいてですね",
      "startSec": 51.36000000000013,
      "endSec": 52.286153846153866,
      "emphasis": []
    },
    {
      "text": "健康の戦略を",
      "startSec": 52.286153846153866,
      "endSec": 53.07999999999993,
      "emphasis": []
    },
    {
      "text": "立てていくということが",
      "startSec": 53.07999999999993,
      "endSec": 54.29733333333297,
      "emphasis": []
    },
    {
      "text": "何よりも",
      "startSec": 54.29733333333297,
      "endSec": 54.73999999999978,
      "emphasis": []
    },
    {
      "text": "重要ですのでこの",
      "startSec": 54.73999999999978,
      "endSec": 55.615294117646954,
      "emphasis": []
    },
    {
      "text": "アプリケーションを",
      "startSec": 55.615294117646954,
      "endSec": 56.59999999999991,
      "emphasis": []
    },
    {
      "text": "活用することで今の自分",
      "startSec": 56.59999999999991,
      "endSec": 58.659999999999854,
      "emphasis": []
    },
    {
      "text": "そして未来の自分にとって",
      "startSec": 58.659999999999854,
      "endSec": 60.19999999999982,
      "emphasis": []
    },
    {
      "text": "重要なですね",
      "startSec": 60.19999999999982,
      "endSec": 61.072000000000116,
      "emphasis": []
    },
    {
      "text": "この健康戦略の基盤",
      "startSec": 61.072000000000116,
      "endSec": 62.38000000000011,
      "emphasis": []
    },
    {
      "text": "というのを作っている",
      "startSec": 62.38000000000011,
      "endSec": 63.86999999999989,
      "emphasis": []
    },
    {
      "text": "という形になっています",
      "startSec": 63.86999999999989,
      "endSec": 65.36000000000013,
      "emphasis": []
    },
    {
      "text": "今我々のですねこの",
      "startSec": 65.36000000000013,
      "endSec": 66.92000000000007,
      "emphasis": []
    },
    {
      "text": "\u0000PN1\u0000って",
      "startSec": 66.92000000000007,
      "endSec": 68.92000000000007,
      "emphasis": []
    },
    {
      "text": "言うですねまぁサービスが",
      "startSec": 68.92000000000007,
      "endSec": 70.11999999999989,
      "emphasis": []
    },
    {
      "text": "できる前でもですね",
      "startSec": 70.11999999999989,
      "endSec": 71.86285714285714,
      "emphasis": []
    },
    {
      "text": "いわゆる",
      "startSec": 71.86285714285714,
      "endSec": 72.55999999999995,
      "emphasis": []
    },
    {
      "text": "富裕層向けの",
      "startSec": 72.55999999999995,
      "endSec": 73.19529411764688,
      "emphasis": []
    },
    {
      "text": "人間ドックっていうのは",
      "startSec": 73.19529411764688,
      "endSec": 74.36000000000013,
      "emphasis": []
    },
    {
      "text": "世の中にたくさん",
      "startSec": 74.36000000000013,
      "endSec": 75.06857142857143,
      "emphasis": []
    },
    {
      "text": "あるんですね",
      "startSec": 75.06857142857143,
      "endSec": 75.59999999999991,
      "emphasis": []
    },
    {
      "text": "よくこれは",
      "startSec": 75.59999999999991,
      "endSec": 76.24285714285725,
      "emphasis": []
    },
    {
      "text": "そういうものと何が",
      "startSec": 76.24285714285725,
      "endSec": 77.40000000000009,
      "emphasis": []
    },
    {
      "text": "違うんですかっていう",
      "startSec": 77.40000000000009,
      "endSec": 78.72307692307686,
      "emphasis": []
    },
    {
      "text": "お話を",
      "startSec": 78.72307692307686,
      "endSec": 79.11999999999989,
      "emphasis": []
    },
    {
      "text": "いただくんですけれども",
      "startSec": 79.11999999999989,
      "endSec": 80.07999999999993,
      "emphasis": []
    },
    {
      "text": "一つはですねさっき",
      "startSec": 80.07999999999993,
      "endSec": 81.7642857142855,
      "emphasis": []
    },
    {
      "text": "話した通り",
      "startSec": 81.7642857142855,
      "endSec": 82.69999999999982,
      "emphasis": []
    },
    {
      "text": "人間ドックの定義を",
      "startSec": 82.69999999999982,
      "endSec": 83.90000000000009,
      "emphasis": [
        {
          "start": 0,
          "end": 8,
          "label": "人間ドックの定義"
        }
      ]
    },
    {
      "text": "変えているということです",
      "startSec": 83.90000000000009,
      "endSec": 85.5,
      "emphasis": []
    }
  ],
  "cameraSwitches": [
    {
      "atSec": 0,

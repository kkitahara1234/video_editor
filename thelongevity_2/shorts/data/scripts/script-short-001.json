{
  "shortId": "short-001",
  "title": "朝の運動のメリット",
  "startSec": 106.3,
  "endSec": 242.42888888888888,
  "telops": [
    {
      "text": "結論から簡単に先に",
      "startSec": 2.019999999999996,
      "endSec": 5.780000000000001,
      "emphasis": []
    },
    {
      "text": "言ってしまいますと",
      "startSec": 5.780000000000001,
      "endSec": 7.159999999999997,
      "emphasis": []
    },
    {
      "text": "ゾーン2トレーニング",
      "startSec": 7.159999999999997,
      "endSec": 8,
      "emphasis": []
    },
    {
      "text": "というですね",
      "startSec": 8,
      "endSec": 8.75200000000001,
      "emphasis": []
    },
    {
      "text": "いわゆる有酸素運動",
      "startSec": 8.75200000000001,
      "endSec": 9.88000000000001,
      "emphasis": [
        {
          "start": 4,
          "end": 9,
          "label": "有酸素運動"
        }
      ]
    },
    {
      "text": "というのはできれば",
      "startSec": 9.88000000000001,
      "endSec": 11.20750000000001,
      "emphasis": []
    },
    {
      "text": "朝に行った方が",
      "startSec": 11.20750000000001,
      "endSec": 12.240000000000009,
      "emphasis": []
    },
    {
      "text": "いいですそして",
      "startSec": 12.240000000000009,
      "endSec": 14.600000000000009,
      "emphasis": []
    },
    {
      "text": "筋力トレーニングですね",
      "startSec": 14.600000000000009,
      "endSec": 16.066666666666677,
      "emphasis": [
        {
          "start": 0,
          "end": 8,
          "label": "筋力トレーニング"
        }
      ]
    },
    {
      "text": "これに関しては",
      "startSec": 16.066666666666677,
      "endSec": 17,
      "emphasis": []
    },
    {
      "text": "夕方以降ですね",
      "startSec": 17,
      "endSec": 17.89999999999999,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "夕方以降"
        }
      ]
    },
    {
      "text": "具体的に言うと",
      "startSec": 17.89999999999999,
      "endSec": 18.799999999999997,
      "emphasis": []
    },
    {
      "text": "15時から",
      "startSec": 18.799999999999997,
      "endSec": 19.10000000000001,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "15時"
        }
      ]
    },
    {
      "text": "19時の間ぐらいが",
      "startSec": 19.10000000000001,
      "endSec": 20.5123076923077,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "19時"
        }
      ]
    },
    {
      "text": "理想的だと言われてますが",
      "startSec": 20.5123076923077,
      "endSec": 22.374285714285705,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "理想的"
        }
      ]
    },
    {
      "text": "これぐらいの",
      "startSec": 22.374285714285705,
      "endSec": 23.179999999999993,
      "emphasis": []
    },
    {
      "text": "タイミングで設計",
      "startSec": 23.179999999999993,
      "endSec": 24.000000000000014,
      "emphasis": []
    },
    {
      "text": "していく方がのが",
      "startSec": 24.000000000000014,
      "endSec": 24.820000000000007,
      "emphasis": []
    },
    {
      "text": "いいというふうに",
      "startSec": 24.820000000000007,
      "endSec": 25.555999999999997,
      "emphasis": []
    },
    {
      "text": "言われてまして",
      "startSec": 25.555999999999997,
      "endSec": 26.200000000000003,
      "emphasis": []
    },
    {
      "text": "これちょっと理由について",
      "startSec": 26.200000000000003,
      "endSec": 27.500000000000014,
      "emphasis": []
    },
    {
      "text": "話していけたらいいと思う",
      "startSec": 27.500000000000014,
      "endSec": 29.676000000000002,
      "emphasis": []
    },
    {
      "text": "んですけど",
      "startSec": 29.676000000000002,
      "endSec": 30.582666666666668,
      "emphasis": []
    },
    {
      "text": "まずですねあの",
      "startSec": 30.582666666666668,
      "endSec": 32.019999999999996,
      "emphasis": []
    },
    {
      "text": "寝てる間ですね",
      "startSec": 32.019999999999996,
      "endSec": 32.8,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "寝てる間"
        }
      ]
    },
    {
      "text": "人はまあ必ず睡眠を",
      "startSec": 32.92,
      "endSec": 34.89999999999999,
      "emphasis": []
    },
    {
      "text": "とるわけですけれども",
      "startSec": 34.89999999999999,
      "endSec": 36.13444444444444,
      "emphasis": []
    },
    {
      "text": "寝ている間って",
      "startSec": 36.13444444444444,
      "endSec": 36.92,
      "emphasis": []
    },
    {
      "text": "体の中のですね",
      "startSec": 36.92,
      "endSec": 38.3,
      "emphasis": []
    },
    {
      "text": "もちろん夜ご飯が",
      "startSec": 38.3,
      "endSec": 39.67999999999999,
      "emphasis": []
    },
    {
      "text": "残ってたら血中の",
      "startSec": 39.67999999999999,
      "endSec": 40.82133333333333,
      "emphasis": []
    },
    {
      "text": "まず糖を使って",
      "startSec": 40.82133333333333,
      "endSec": 41.82000000000001,
      "emphasis": []
    },
    {
      "text": "後ですね肝臓とか筋肉に",
      "startSec": 42.06000000000002,
      "endSec": 44.33999999999999,
      "emphasis": []
    },
    {
      "text": "蓄えられている",
      "startSec": 44.33999999999999,
      "endSec": 45.050769230769234,
      "emphasis": []
    },
    {
      "text": "グリコーゲン",
      "startSec": 45.050769230769234,
      "endSec": 45.66000000000001,
      "emphasis": []
    },
    {
      "text": "というですね",
      "startSec": 45.66000000000001,
      "endSec": 46.447500000000005,
      "emphasis": []
    },
    {
      "text": "あの貯蔵するための",
      "startSec": 46.447500000000005,
      "endSec": 47.459999999999994,
      "emphasis": []
    },
    {
      "text": "糖を使っていきます",
      "startSec": 47.459999999999994,
      "endSec": 48.459999999999994,
      "emphasis": []
    },
    {
      "text": "でこの糖が枯渇してくると",
      "startSec": 48.480000000000004,
      "endSec": 50.500000000000014,
      "emphasis": []
    },
    {
      "text": "今度脂肪酸代謝という",
      "startSec": 50.500000000000014,
      "endSec": 51.63666666666667,
      "emphasis": []
    },
    {
      "text": "のを回していく",
      "startSec": 51.63666666666667,
      "endSec": 52.36,
      "emphasis": []
    },
    {
      "text": "ことになるわけ",
      "startSec": 52.36,
      "endSec": 53.042666666666676,
      "emphasis": []
    },
    {
      "text": "なんですけれども",
      "startSec": 53.042666666666676,
      "endSec": 53.64,
      "emphasis": []
    },
    {
      "text": "要はですね朝起きた",
      "startSec": 54.040000000000006,
      "endSec": 54.98235294117647,
      "emphasis": []
    },
    {
      "text": "ときっていうのは",
      "startSec": 54.98235294117647,
      "endSec": 55.82000000000001,
      "emphasis": []
    },
    {
      "text": "若干飢餓寄りの",
      "startSec": 55.82000000000001,
      "endSec": 57.500000000000014,
      "emphasis": []
    },
    {
      "text": "状態なんですよね",
      "startSec": 57.500000000000014,
      "endSec": 59.42,
      "emphasis": []
    },
    {
      "text": "この状態で朝ですね",
      "startSec": 59.42,
      "endSec": 61.0175,
      "emphasis": []
    },
    {
      "text": "ご飯を食べずに",
      "startSec": 61.0175,
      "endSec": 62.260000000000005,
      "emphasis": []
    },
    {
      "text": "ゾーン2ぐらいのですね",
      "startSec": 62.260000000000005,
      "endSec": 63.82444444444444,
      "emphasis": []
    },
    {
      "text": "軽めの軽度から中等度",
      "startSec": 63.82444444444444,
      "endSec": 64.96,
      "emphasis": []
    },
    {
      "text": "ぐらいのですね",
      "startSec": 64.96,
      "endSec": 65.8164705882353,
      "emphasis": []
    },
    {
      "text": "運動を入れてあげると",
      "startSec": 65.8164705882353,
      "endSec": 67.04,
      "emphasis": []
    },
    {
      "text": "残っている",
      "startSec": 67.04,
      "endSec": 67.70428571428572,
      "emphasis": []
    },
    {
      "text": "グリコーゲンを全部",
      "startSec": 67.70428571428572,
      "endSec": 68.89999999999999,
      "emphasis": []
    },
    {
      "text": "消費した上でですね",
      "startSec": 68.89999999999999,
      "endSec": 69.76,
      "emphasis": []
    },
    {
      "text": "しっかりと",
      "startSec": 69.76,
      "endSec": 70.29846153846155,
      "emphasis": []
    },
    {
      "text": "この脂肪酸代謝が",
      "startSec": 70.29846153846155,
      "endSec": 71.16000000000001,
      "emphasis": []
    },
    {
      "text": "回っていきます",
      "startSec": 71.16000000000001,
      "endSec": 72.18000000000002,
      "emphasis": []
    },
    {
      "text": "これはやっぱ特に",
      "startSec": 72.18000000000002,
      "endSec": 73.2,
      "emphasis": []
    },
    {
      "text": "減量中の人とかですね",
      "startSec": 73.2,
      "endSec": 74.47058823529413,
      "emphasis": []
    },
    {
      "text": "脂肪を落として",
      "startSec": 74.47058823529413,
      "endSec": 75.36,
      "emphasis": []
    },
    {
      "text": "いきたいよって",
      "startSec": 75.36,
      "endSec": 76.0270588235294,
      "emphasis": []
    },
    {
      "text": "人にはものすごくいい",
      "startSec": 76.0270588235294,
      "endSec": 76.98,
      "emphasis": []
    },
    {
      "text": "ことですし",
      "startSec": 76.98,
      "endSec": 77.7975,
      "emphasis": []
    },
    {
      "text": "まあ人間ドックとかで",
      "startSec": 77.7975,
      "endSec": 79.16000000000001,
      "emphasis": []
    },
    {
      "text": "いうと中性脂肪とかね",
      "startSec": 79.16000000000001,
      "endSec": 80.42,
      "emphasis": []
    },
    {
      "text": "空腹時血糖値とか",
      "startSec": 80.42,
      "endSec": 81.12222222222222,
      "emphasis": []
    },
    {
      "text": "こういうのを落として",
      "startSec": 81.12222222222222,
      "endSec": 82.00000000000001,
      "emphasis": []
    },
    {
      "text": "いきたい人に",
      "startSec": 82.00000000000001,
      "endSec": 82.6646153846154,
      "emphasis": []
    },
    {
      "text": "も非常に有効な",
      "startSec": 82.6646153846154,
      "endSec": 83.44000000000001,
      "emphasis": []
    },
    {
      "text": "考え方です",
      "startSec": 83.44000000000001,
      "endSec": 84.1284210526316,
      "emphasis": []
    },
    {
      "text": "なんで朝起きた",
      "startSec": 84.1284210526316,
      "endSec": 84.93157894736844,
      "emphasis": []
    },
    {
      "text": "ときにですね",
      "startSec": 84.93157894736844,
      "endSec": 85.61999999999999,
      "emphasis": []
    },
    {
      "text": "いきなりこう食べ物を",
      "startSec": 85.61999999999999,
      "endSec": 87.26,
      "emphasis": []
    },
    {
      "text": "取らずに",
      "startSec": 87.26,
      "endSec": 87.72769230769232,
      "emphasis": []
    },
    {
      "text": "水だけちょっと軽く",
      "startSec": 87.72769230769232,
      "endSec": 88.78000000000002,
      "emphasis": []
    },
    {
      "text": "入れてですね",
      "startSec": 88.78000000000002,
      "endSec": 89.46470588235296,
      "emphasis": []
    },
    {
      "text": "20分から40分ぐらい",
      "startSec": 89.46470588235296,
      "endSec": 90.72000000000001,
      "emphasis": []
    },
    {
      "text": "今軽度から中等度ぐらいで",
      "startSec": 90.72000000000001,
      "endSec": 92.83999999999999,
      "emphasis": []
    },
    {
      "text": "散歩してあげるとかですね",
      "startSec": 92.83999999999999,
      "endSec": 94.17999999999999,
      "emphasis": []
    },
    {
      "text": "軽く坂道ウォークを",
      "startSec": 94.17999999999999,
      "endSec": 95.08999999999999,
      "emphasis": []
    },
    {
      "text": "してあげるみたいな",
      "startSec": 95.08999999999999,
      "endSec": 96.00000000000001,
      "emphasis": []
    },
    {
      "text": "ことはまあ非常に",
      "startSec": 96.00000000000001,
      "endSec": 97.31000000000002,
      "emphasis": []
    },
    {
      "text": "理にかなっていて",
      "startSec": 97.31000000000002,
      "endSec": 98.61999999999999,
      "emphasis": []
    },
    {
      "text": "グリコーゲンを枯渇させた",
      "startSec": 98.61999999999999,
      "endSec": 100.56000000000002,
      "emphasis": []
    },
    {
      "text": "状態でですね",
      "startSec": 100.56000000000002,
      "endSec": 101.16000000000001,
      "emphasis": []
    },
    {
      "text": "脂肪酸代謝をうまく",
      "startSec": 101.16000000000001,
      "endSec": 102.06000000000002,
      "emphasis": []
    },
    {
      "text": "回していくことでその",
      "startSec": 102.06000000000002,
      "endSec": 103.52,
      "emphasis": []
    },
    {
      "text": "運動の時間内でですね",
      "startSec": 103.52,
      "endSec": 105.55529411764705,
      "emphasis": []
    },
    {
      "text": "しっかりとあの",
      "startSec": 105.55529411764705,
      "endSec": 106.98,
      "emphasis": []
    },
    {
      "text": "もちろんカロリー",
      "startSec": 106.98,
      "endSec": 107.65999999999998,
      "emphasis": []
    },
    {
      "text": "消費をして脂肪を",
      "startSec": 107.65999999999998,
      "endSec": 108.33999999999999,
      "emphasis": []
    },
    {
      "text": "燃やしていける",
      "startSec": 108.33999999999999,
      "endSec": 109.33428571428571,
      "emphasis": []
    },
    {
      "text": "って話が一つ",
      "startSec": 109.33428571428571,
      "endSec": 110.08,
      "emphasis": []
    },
    {
      "text": "あとはですねその朝に",
      "startSec": 110.08,
      "endSec": 111.46,
      "emphasis": []
    },
    {
      "text": "適度なですね",
      "startSec": 111.46,
      "endSec": 112.14571428571428,
      "emphasis": []
    },
    {
      "text": "ゾーン2の運動を",
      "startSec": 112.14571428571428,
      "endSec": 113.06000000000002,
      "emphasis": []
    },
    {
      "text": "入れてあげると",
      "startSec": 113.06000000000002,
      "endSec": 113.90000000000002,
      "emphasis": []
    },
    {
      "text": "ニートっていうふうに",
      "startSec": 113.90000000000002,
      "endSec": 115.10000000000001,
      "emphasis": []
    },
    {
      "text": "いいますけれども",
      "startSec": 115.10000000000001,
      "endSec": 115.92,
      "emphasis": []
    },
    {
      "text": "ノンエクササイズ",
      "startSec": 116.16000000000001,
      "endSec": 117.48266666666667,
      "emphasis": []
    },
    {
      "text": "アクティビティですね",
      "startSec": 117.48266666666667,
      "endSec": 119.27272727272727,
      "emphasis": []
    },
    {
      "text": "まあ要は動かずに",
      "startSec": 119.27272727272727,
      "endSec": 120.5381818181818,
      "emphasis": []
    },
    {
      "text": "普通に生活をしている",
      "startSec": 120.5381818181818,
      "endSec": 122.11999999999999,
      "emphasis": []
    },
    {
      "text": "ちょっとこう",
      "startSec": 122.11999999999999,
      "endSec": 123.04470588235294,
      "emphasis": []
    },
    {
      "text": "トイレに行くとか階段を",
      "startSec": 123.04470588235294,
      "endSec": 124.74,
      "emphasis": []
    },
    {
      "text": "登るとか隣のオフィスまで",
      "startSec": 124.74,
      "endSec": 127.50000000000001,
      "emphasis": []
    },
    {
      "text": "行くとかですね",
      "startSec": 127.50000000000001,
      "endSec": 128.59714285714284,
      "emphasis": []
    },
    {
      "text": "まあそういう",
      "startSec": 128.59714285714284,
      "endSec": 129.42000000000002,
      "emphasis": []
    },
    {
      "text": "ちょっとした",
      "startSec": 129.42000000000002,
      "endSec": 130.25142857142856,
      "emphasis": []
    },
    {
      "text": "日常動作の中での",
      "startSec": 130.25142857142856,
      "endSec": 131.36,
      "emphasis": []
    },
    {
      "text": "活動ベースの活動",
      "startSec": 131.36,
      "endSec": 132.16000000000003,
      "emphasis": []
    },
    {
      "text": "消費量というものが",
      "startSec": 132.16000000000003,
      "endSec": 133.06,
      "emphasis": []
    },
    {
      "text": "朝に軽く運動を",
      "startSec": 133.06,
      "endSec": 133.76933333333335,
      "emphasis": []
    },
    {
      "text": "入れておくことで",
      "startSec": 133.76933333333335,
      "endSec": 134.57999999999998,
      "emphasis": []
    },
    {
      "text": "上がるということが",
      "startSec": 134.57999999999998,
      "endSec": 135.16000000000003,
      "emphasis": []
    },
    {
      "text": "わかっています",
      "startSec": 135.16000000000003,
      "endSec": 136.12888888888887,
      "emphasis": []
    }
  ],
  "cameraSwitches": [
    {
      "atSec": 0,
      "camera": "front"
    }
  ]
}
{
  "shortId": "short-003",
  "title": "健康を守る重要性",
  "startSec": 765,
  "endSec": 843.34,
  "telops": [
    {
      "text": "生きるという",
      "startSec": 0,
      "endSec": 0.6000000000000227,
      "emphasis": []
    },
    {
      "text": "部分だけはですねどんな",
      "startSec": 0.6000000000000227,
      "endSec": 2.07442307692304,
      "emphasis": []
    },
    {
      "text": "時代になってもですね人に",
      "startSec": 2.07442307692304,
      "endSec": 4.740000000000009,
      "emphasis": []
    },
    {
      "text": "託すことはできないですし",
      "startSec": 4.740000000000009,
      "endSec": 6.360000000000014,
      "emphasis": []
    },
    {
      "text": "スティーブ・ジョブズ",
      "startSec": 6.360000000000014,
      "endSec": 7.648888888888905,
      "emphasis": []
    },
    {
      "text": "もね最後死に際に",
      "startSec": 7.648888888888905,
      "endSec": 8.67999999999995,
      "emphasis": []
    },
    {
      "text": "言ってますけれども",
      "startSec": 8.67999999999995,
      "endSec": 10.1099999999999,
      "emphasis": []
    },
    {
      "text": "本当にどんな人でも",
      "startSec": 10.1099999999999,
      "endSec": 11.539999999999964,
      "emphasis": []
    },
    {
      "text": "自分は雇う",
      "startSec": 11.539999999999964,
      "endSec": 12.139999999999986,
      "emphasis": []
    },
    {
      "text": "ことができるけれども",
      "startSec": 12.139999999999986,
      "endSec": 13.139999999999986,
      "emphasis": []
    },
    {
      "text": "病気にですね",
      "startSec": 13.5,
      "endSec": 14.330769230769192,
      "emphasis": []
    },
    {
      "text": "自分の代わりになっ",
      "startSec": 14.330769230769192,
      "endSec": 15.299185520361902,
      "emphasis": []
    },
    {
      "text": "てくれる人だけは",
      "startSec": 15.299185520361902,
      "endSec": 16.159999999999968,
      "emphasis": []
    },
    {
      "text": "雇うことが",
      "startSec": 16.159999999999968,
      "endSec": 16.699999999999932,
      "emphasis": []
    },
    {
      "text": "できないというふうに",
      "startSec": 16.699999999999932,
      "endSec": 17.779999999999973,
      "emphasis": []
    },
    {
      "text": "言っています",
      "startSec": 17.779999999999973,
      "endSec": 19.019999999999982,
      "emphasis": []
    },
    {
      "text": "なのでですね",
      "startSec": 19.360000000000014,
      "endSec": 20.122352941176473,
      "emphasis": []
    },
    {
      "text": "これだけテクノロジーが",
      "startSec": 20.122352941176473,
      "endSec": 21.519999999999982,
      "emphasis": []
    },
    {
      "text": "進化",
      "startSec": 21.519999999999982,
      "endSec": 21.781538461538503,
      "emphasis": []
    },
    {
      "text": "して便利な時代に皆さん",
      "startSec": 21.781538461538503,
      "endSec": 23.220000000000027,
      "emphasis": []
    },
    {
      "text": "生きていると思いますので",
      "startSec": 23.220000000000027,
      "endSec": 24.75999999999999,
      "emphasis": []
    },
    {
      "text": "この時代だからこそですね",
      "startSec": 24.75999999999999,
      "endSec": 26.639999999999986,
      "emphasis": []
    },
    {
      "text": "こういう目に",
      "startSec": 26.639999999999986,
      "endSec": 28.09194570135753,
      "emphasis": []
    },
    {
      "text": "見えるお金とか車とか",
      "startSec": 28.09194570135753,
      "endSec": 30.460000000000036,
      "emphasis": []
    },
    {
      "text": "そういう",
      "startSec": 30.460000000000036,
      "endSec": 30.86500000000001,
      "emphasis": []
    },
    {
      "text": "計算だけではなくてですね",
      "startSec": 30.86500000000001,
      "endSec": 32.08000000000004,
      "emphasis": []
    },
    {
      "text": "自分の健康っていう",
      "startSec": 32.120000000000005,
      "endSec": 33.3905882352941,
      "emphasis": [
        {
          "start": 3,
          "end": 5,
          "label": "健康"
        }
      ]
    },
    {
      "text": "資産に目を向けて",
      "startSec": 33.3905882352941,
      "endSec": 34.51999999999998,
      "emphasis": []
    },
    {
      "text": "もらえたらと思います",
      "startSec": 34.51999999999998,
      "endSec": 36.3835294117647,
      "emphasis": []
    },
    {
      "text": "でも実際僕も",
      "startSec": 36.3835294117647,
      "endSec": 37.39999999999998,
      "emphasis": []
    },
    {
      "text": "現場でね",
      "startSec": 37.39999999999998,
      "endSec": 37.81230769230763,
      "emphasis": []
    },
    {
      "text": "いろんな患者さんを",
      "startSec": 37.81230769230763,
      "endSec": 38.74000000000001,
      "emphasis": []
    },
    {
      "text": "見ましたけれどもやっぱ",
      "startSec": 38.74000000000001,
      "endSec": 39.998888888888814,
      "emphasis": []
    },
    {
      "text": "どれだけ人生が",
      "startSec": 39.998888888888814,
      "endSec": 40.799999999999955,
      "emphasis": []
    },
    {
      "text": "うまくいっていてお金を",
      "startSec": 40.799999999999955,
      "endSec": 42.64250000000004,
      "emphasis": []
    },
    {
      "text": "手に入れて",
      "startSec": 42.64250000000004,
      "endSec": 43.48000000000002,
      "emphasis": []
    },
    {
      "text": "素敵な家族が",
      "startSec": 43.48000000000002,
      "endSec": 44.7190950226244,
      "emphasis": []
    },
    {
      "text": "いた人もですね健康を",
      "startSec": 44.7190950226244,
      "endSec": 46.74000000000001,
      "emphasis": [
        {
          "start": 7,
          "end": 9,
          "label": "健康"
        }
      ]
    },
    {
      "text": "失ってしまうと",
      "startSec": 46.74000000000001,
      "endSec": 47.58000000000004,
      "emphasis": []
    },
    {
      "text": "その瞬間ですねもう",
      "startSec": 47.58000000000004,
      "endSec": 48.65999999999997,
      "emphasis": []
    },
    {
      "text": "自分の健康を取り戻す",
      "startSec": 48.65999999999997,
      "endSec": 49.76999999999998,
      "emphasis": []
    },
    {
      "text": "ことにすべての脳がね",
      "startSec": 49.76999999999998,
      "endSec": 50.879999999999995,
      "emphasis": []
    },
    {
      "text": "リソースが",
      "startSec": 51,
      "endSec": 51.5866666666667,
      "emphasis": []
    },
    {
      "text": "行っちゃうんですよね",
      "startSec": 51.5866666666667,
      "endSec": 52.75999999999999,
      "emphasis": []
    },
    {
      "text": "なんでまああの",
      "startSec": 52.75999999999999,
      "endSec": 54.21764705882356,
      "emphasis": []
    },
    {
      "text": "健康ってこう失うまで",
      "startSec": 54.21764705882356,
      "endSec": 56.299999999999955,
      "emphasis": []
    },
    {
      "text": "気づかないものだったりも",
      "startSec": 56.299999999999955,
      "endSec": 58.17999999999995,
      "emphasis": []
    },
    {
      "text": "するんですけれども",
      "startSec": 58.17999999999995,
      "endSec": 59.08000000000004,
      "emphasis": []
    },
    {
      "text": "やっぱりこう失ってから",
      "startSec": 59.39999999999998,
      "endSec": 60.72000000000003,
      "emphasis": []
    },
    {
      "text": "では遅いものでも",
      "startSec": 60.72000000000003,
      "endSec": 61.904820512820606,
      "emphasis": [
        {
          "start": 2,
          "end": 4,
          "label": "遅い"
        }
      ]
    },
    {
      "text": "ありますし",
      "startSec": 61.904820512820606,
      "endSec": 62.64533333333338,
      "emphasis": []
    },
    {
      "text": "失った時に他の",
      "startSec": 62.64533333333338,
      "endSec": 63.700000000000045,
      "emphasis": []
    },
    {
      "text": "すべても一緒に失う",
      "startSec": 63.700000000000045,
      "endSec": 65.03999999999996,
      "emphasis": []
    },
    {
      "text": "ものでも",
      "startSec": 65.03999999999996,
      "endSec": 65.73538461538453,
      "emphasis": []
    },
    {
      "text": "ありますので何より",
      "startSec": 65.73538461538453,
      "endSec": 67.29999999999995,
      "emphasis": []
    },
    {
      "text": "重要なですね",
      "startSec": 67.29999999999995,
      "endSec": 67.96000000000004,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "重要な"
        }
      ]
    },
    {
      "text": "資産として",
      "startSec": 67.96000000000004,
      "endSec": 68.90375000000006,
      "emphasis": [
        {
          "start": 0,
          "end": 2,
          "label": "資産"
        }
      ]
    },
    {
      "text": "守っていくということが",
      "startSec": 68.90375000000006,
      "endSec": 70.98000000000002,
      "emphasis": []
    },
    {
      "text": "大切かなという",
      "startSec": 70.98000000000002,
      "endSec": 71.98000000000002,
      "emphasis": []
    },
    {
      "text": "ふうに思いますじゃあ",
      "startSec": 71.98000000000002,
      "endSec": 73.38,
      "emphasis": []
    },
    {
      "text": "実際にですね",
      "startSec": 73.38,
      "endSec": 74.22000000000003,
      "emphasis": []
    },
    {
      "text": "どうやってその健康資産を",
      "startSec": 74.22000000000003,
      "endSec": 75.89999999999998,
      "emphasis": []
    },
    {
      "text": "守っていくのかっていう",
      "startSec": 75.89999999999998,
      "endSec": 76.98000000000002,
      "emphasis": []
    },
    {
      "text": "ことですけれども",
      "startSec": 76.98000000000002,
      "endSec": 78.34000000000003,
      "emphasis": []
    }
  ],
  "cameraSwitches": [
    {
      "atSec": 0,

{
  "shortId": "short-002",
  "title": "健康で豊かな人生",
  "startSec": 348.42,
  "endSec": 464.64,
  "telops": [
    {
      "text": "我々の会社の",
      "startSec": 0,
      "endSec": 1.1399999999999864,
      "emphasis": []
    },
    {
      "text": "ゴールはですねただ",
      "startSec": 1.1399999999999864,
      "endSec": 2.3774999999999977,
      "emphasis": []
    },
    {
      "text": "病気にさせない",
      "startSec": 2.3774999999999977,
      "endSec": 3.339999999999975,
      "emphasis": []
    },
    {
      "text": "ということではなくて",
      "startSec": 3.339999999999975,
      "endSec": 4.996470588235297,
      "emphasis": []
    },
    {
      "text": "人々の人生を",
      "startSec": 4.996470588235297,
      "endSec": 5.899999999999977,
      "emphasis": []
    },
    {
      "text": "豊かにするために",
      "startSec": 5.899999999999977,
      "endSec": 6.995384615384637,
      "emphasis": []
    },
    {
      "text": "予防医療を",
      "startSec": 6.995384615384637,
      "endSec": 7.680000000000007,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "予防医療"
        }
      ]
    },
    {
      "text": "通じてですね",
      "startSec": 7.680000000000007,
      "endSec": 8.240000000000009,
      "emphasis": []
    },
    {
      "text": "健康な良い人生を",
      "startSec": 8.240000000000009,
      "endSec": 9.46285714285716,
      "emphasis": []
    },
    {
      "text": "送れるように",
      "startSec": 9.46285714285716,
      "endSec": 10.379999999999995,
      "emphasis": []
    },
    {
      "text": "していくということを",
      "startSec": 10.379999999999995,
      "endSec": 11.820384615384626,
      "emphasis": []
    },
    {
      "text": "掲げてこの",
      "startSec": 11.820384615384626,
      "endSec": 12.519999999999982,
      "emphasis": []
    },
    {
      "text": "ウェルネスという",
      "startSec": 12.519999999999982,
      "endSec": 13.70999999999998,
      "emphasis": []
    },
    {
      "text": "社名にしています",
      "startSec": 13.70999999999998,
      "endSec": 14.899999999999977,
      "emphasis": []
    },
    {
      "text": "予防医療ってねあの",
      "startSec": 15.979999999999961,
      "endSec": 17.489999999999952,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "予防医療"
        }
      ]
    },
    {
      "text": "皆さんも聞いたこと",
      "startSec": 17.489999999999952,
      "endSec": 19,
      "emphasis": []
    },
    {
      "text": "あると思うんですけれども",
      "startSec": 19,
      "endSec": 20.039999999999964,
      "emphasis": []
    },
    {
      "text": "基本的にはやっぱり病気に",
      "startSec": 20.039999999999964,
      "endSec": 21.626086956521704,
      "emphasis": []
    },
    {
      "text": "ならないとか病気を早く",
      "startSec": 21.626086956521704,
      "endSec": 23.079999999999984,
      "emphasis": []
    },
    {
      "text": "見つけるっていう",
      "startSec": 23.079999999999984,
      "endSec": 23.871111111111077,
      "emphasis": []
    },
    {
      "text": "考え方だというふうに",
      "startSec": 23.871111111111077,
      "endSec": 24.859999999999957,
      "emphasis": []
    },
    {
      "text": "思っています",
      "startSec": 24.859999999999957,
      "endSec": 26.221111111111043,
      "emphasis": []
    },
    {
      "text": "予防医療1.0っていう",
      "startSec": 26.221111111111043,
      "endSec": 28.359999999999957,
      "emphasis": [
        {
          "start": 0,
          "end": 7,
          "label": "予防医療1.0"
        }
      ]
    },
    {
      "text": "一番最初の予防",
      "startSec": 28.359999999999957,
      "endSec": 29.00555555555553,
      "emphasis": []
    },
    {
      "text": "医療って何だったかって",
      "startSec": 29.00555555555553,
      "endSec": 30.019999999999982,
      "emphasis": []
    },
    {
      "text": "言うとですね",
      "startSec": 30.019999999999982,
      "endSec": 30.80000000000001,
      "emphasis": []
    },
    {
      "text": "とにかく寿命を",
      "startSec": 30.80000000000001,
      "endSec": 32.12461538461537,
      "emphasis": []
    },
    {
      "text": "伸ばすという",
      "startSec": 32.12461538461537,
      "endSec": 33.25999999999999,
      "emphasis": []
    },
    {
      "text": "ことですね",
      "startSec": 33.25999999999999,
      "endSec": 34.563999999999965,
      "emphasis": []
    },
    {
      "text": "実際日本は今世界で",
      "startSec": 34.563999999999965,
      "endSec": 36.51999999999998,
      "emphasis": []
    },
    {
      "text": "一番ねあの",
      "startSec": 36.51999999999998,
      "endSec": 38.01999999999998,
      "emphasis": []
    },
    {
      "text": "高齢社会で寿命の",
      "startSec": 38.01999999999998,
      "endSec": 40.41999999999996,
      "emphasis": []
    },
    {
      "text": "健康長寿の国だって",
      "startSec": 40.41999999999996,
      "endSec": 41.60124999999999,
      "emphasis": []
    },
    {
      "text": "言われていると思う",
      "startSec": 41.60124999999999,
      "endSec": 42.399296875000005,
      "emphasis": []
    },
    {
      "text": "んですけれども",
      "startSec": 42.399296875000005,
      "endSec": 43.01999999999998,
      "emphasis": []
    },
    {
      "text": "これがライフスパン",
      "startSec": 43.47999999999996,
      "endSec": 44.25999999999999,
      "emphasis": []
    },
    {
      "text": "というふうに",
      "startSec": 44.25999999999999,
      "endSec": 44.77999999999997,
      "emphasis": []
    },
    {
      "text": "言いますね",
      "startSec": 44.77999999999997,
      "endSec": 45.85999999999996,
      "emphasis": []
    },
    {
      "text": "普通に生きている時間を",
      "startSec": 45.85999999999996,
      "endSec": 47.839999999999975,
      "emphasis": []
    },
    {
      "text": "最大化するということが",
      "startSec": 47.839999999999975,
      "endSec": 49.723749999999995,
      "emphasis": []
    },
    {
      "text": "予防医療の",
      "startSec": 49.723749999999995,
      "endSec": 50.579999999999984,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "予防医療"
        }
      ]
    },
    {
      "text": "最初の目的でした",
      "startSec": 50.579999999999984,
      "endSec": 51.39999999999998,
      "emphasis": []
    },
    {
      "text": "最近ですねこの",
      "startSec": 52.56,
      "endSec": 53.39999999999998,
      "emphasis": []
    },
    {
      "text": "ヘルススパンというのが",
      "startSec": 53.39999999999998,
      "endSec": 54.71999999999997,
      "emphasis": []
    },
    {
      "text": "注目されていますけれども",
      "startSec": 54.71999999999997,
      "endSec": 55.91999999999996,
      "emphasis": []
    },
    {
      "text": "予防医療2.0",
      "startSec": 55.91999999999996,
      "endSec": 57.015294117647045,
      "emphasis": [
        {
          "start": 0,
          "end": 7,
          "label": "予防医療2.0"
        }
      ]
    },
    {
      "text": "というふうにね我々は",
      "startSec": 57.015294117647045,
      "endSec": 58.579999999999984,
      "emphasis": []
    },
    {
      "text": "言ってますけれども",
      "startSec": 58.579999999999984,
      "endSec": 59.120000000000005,
      "emphasis": []
    },
    {
      "text": "ただ生きているとい",
      "startSec": 60.65999999999997,
      "endSec": 61.70823529411763,
      "emphasis": []
    },
    {
      "text": "うだけではなくて",
      "startSec": 61.70823529411763,
      "endSec": 62.639999999999986,
      "emphasis": []
    },
    {
      "text": "やっぱり健康に",
      "startSec": 62.639999999999986,
      "endSec": 63.55538461538458,
      "emphasis": []
    },
    {
      "text": "動ける時間を",
      "startSec": 63.55538461538458,
      "endSec": 64.33999999999997,
      "emphasis": []
    },
    {
      "text": "最大化しましょう",
      "startSec": 64.33999999999997,
      "endSec": 65.52285714285716,
      "emphasis": []
    },
    {
      "text": "というのが",
      "startSec": 65.52285714285716,
      "endSec": 66.18,
      "emphasis": []
    },
    {
      "text": "今世の中でねすごい",
      "startSec": 66.18,
      "endSec": 67.1925,
      "emphasis": []
    },
    {
      "text": "言われるように",
      "startSec": 67.1925,
      "endSec": 67.97999999999996,
      "emphasis": []
    },
    {
      "text": "なってきまして",
      "startSec": 67.97999999999996,
      "endSec": 68.71999999999997,
      "emphasis": []
    },
    {
      "text": "世界でもこの健康",
      "startSec": 69.06,
      "endSec": 70.41000000000003,
      "emphasis": []
    },
    {
      "text": "寿命を伸ばすとか",
      "startSec": 70.41000000000003,
      "endSec": 71.75999999999999,
      "emphasis": []
    },
    {
      "text": "Longevity",
      "startSec": 71.75999999999999,
      "endSec": 73.00615384615384,
      "emphasis": []
    },
    {
      "text": "とかって",
      "startSec": 73.00615384615384,
      "endSec": 73.56,
      "emphasis": []
    },
    {
      "text": "言ってですね",
      "startSec": 73.56,
      "endSec": 74.13749999999999,
      "emphasis": []
    },
    {
      "text": "まあいうマーケットが",
      "startSec": 74.13749999999999,
      "endSec": 75.09999999999997,
      "emphasis": []
    },
    {
      "text": "すごく大きく",
      "startSec": 75.09999999999997,
      "endSec": 75.565,
      "emphasis": []
    },
    {
      "text": "なってきているんです",
      "startSec": 75.565,
      "endSec": 76.33999999999997,
      "emphasis": []
    },
    {
      "text": "けれども",
      "startSec": 76.39999999999998,
      "endSec": 77.36249999999995,
      "emphasis": []
    },
    {
      "text": "病気がない状態で動ける",
      "startSec": 77.36249999999995,
      "endSec": 79.47999999999996,
      "emphasis": []
    },
    {
      "text": "状態で長生き",
      "startSec": 79.47999999999996,
      "endSec": 80.47749999999996,
      "emphasis": []
    },
    {
      "text": "しましょうというのが",
      "startSec": 80.47749999999996,
      "endSec": 82.13999999999999,
      "emphasis": []
    },
    {
      "text": "予防医療2.0です",
      "startSec": 82.13999999999999,
      "endSec": 83.18,
      "emphasis": [
        {
          "start": 0,
          "end": 7,
          "label": "予防医療2.0"
        }
      ]
    },
    {
      "text": "我々はですねさらに",
      "startSec": 83.63999999999999,
      "endSec": 85.06615384615384,
      "emphasis": []
    },
    {
      "text": "その先を",
      "startSec": 85.06615384615384,
      "endSec": 85.69999999999999,
      "emphasis": []
    },
    {
      "text": "目指してまして",
      "startSec": 85.69999999999999,
      "endSec": 86.53999999999996,
      "emphasis": []
    },
    {
      "text": "予防医療3.0",
      "startSec": 86.53999999999996,
      "endSec": 87.68666666666667,
      "emphasis": [
        {
          "start": 0,
          "end": 7,
          "label": "予防医療3.0"
        }
      ]
    },
    {
      "text": "まあウェルネス寿命を",
      "startSec": 87.68666666666667,
      "endSec": 89.12,
      "emphasis": []
    },
    {
      "text": "伸ばすということですね",
      "startSec": 89.12,
      "endSec": 90.51999999999998,
      "emphasis": []
    },
    {
      "text": "なのでただ病気がなく",
      "startSec": 90.63999999999999,
      "endSec": 92.1576470588235,
      "emphasis": []
    },
    {
      "text": "長生きしている",
      "startSec": 92.1576470588235,
      "endSec": 93.21999999999997,
      "emphasis": []
    },
    {
      "text": "というだけではなくて",
      "startSec": 93.21999999999997,
      "endSec": 94.66222222222223,
      "emphasis": []
    },
    {
      "text": "かついい人生を",
      "startSec": 94.66222222222223,
      "endSec": 95.57999999999998,
      "emphasis": []
    },
    {
      "text": "やっぱり",
      "startSec": 95.57999999999998,
      "endSec": 96.15142857142854,
      "emphasis": []
    },
    {
      "text": "送るということです",
      "startSec": 96.15142857142854,
      "endSec": 97.18,
      "emphasis": []
    },
    {
      "text": "なんでこう",
      "startSec": 97.18,
      "endSec": 97.91333333333336,
      "emphasis": []
    },
    {
      "text": "素敵な体験をするとか",
      "startSec": 97.91333333333336,
      "endSec": 99.38,
      "emphasis": []
    },
    {
      "text": "いろんな人に",
      "startSec": 99.38,
      "endSec": 100.33999999999997,
      "emphasis": []
    },
    {
      "text": "出会えるとかですね",
      "startSec": 100.33999999999997,
      "endSec": 101.77999999999997,
      "emphasis": []
    },
    {
      "text": "もちろん経済的にも",
      "startSec": 101.77999999999997,
      "endSec": 103.38999999999999,
      "emphasis": []
    },
    {
      "text": "不安がないとかって",
      "startSec": 103.38999999999999,
      "endSec": 105,
      "emphasis": []
    },
    {
      "text": "いうのもそうですけれども",
      "startSec": 105,
      "endSec": 105.85999999999996,
      "emphasis": []
    },
    {
      "text": "いろんな観点でですね",
      "startSec": 105.85999999999996,
      "endSec": 107.58941176470586,
      "emphasis": []
    },
    {
      "text": "不安なく本当に",
      "startSec": 107.58941176470586,
      "endSec": 108.80000000000001,
      "emphasis": []
    },
    {
      "text": "自分の人生いいなっていう",
      "startSec": 108.80000000000001,
      "endSec": 110.17333333333329,
      "emphasis": []
    },
    {
      "text": "ふうに思える",
      "startSec": 110.17333333333329,
      "endSec": 110.85999999999996,
      "emphasis": []
    },
    {
      "text": "状態を一緒に",
      "startSec": 110.85999999999996,
      "endSec": 112.08888888888885,
      "emphasis": []
    },
    {
      "text": "作りに行くっていうのが",
      "startSec": 112.08888888888885,
      "endSec": 114.01999999999998,
      "emphasis": []
    },
    {
      "text": "我々が考えている思",
      "startSec": 114.01999999999998,
      "endSec": 115.18470588235294,
      "emphasis": []
    },
    {
      "text": "想になっています",
      "startSec": 115.18470588235294,
      "endSec": 116.21999999999997,
      "emphasis": []
    }
  ],

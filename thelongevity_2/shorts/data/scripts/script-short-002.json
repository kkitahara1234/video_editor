{
  "shortId": "short-002",
  "title": "筋トレは夕方がベスト",
  "startSec": 320.1,
  "endSec": 399.7,
  "telops": [
    {
      "text": "逆に筋トレはですね",
      "startSec": 0.03999999999996362,
      "endSec": 1.4058823529411484,
      "emphasis": []
    },
    {
      "text": "可能なのであれば",
      "startSec": 1.4058823529411484,
      "endSec": 2.6200000000000045,
      "emphasis": []
    },
    {
      "text": "夕方ですね15時から",
      "startSec": 2.6200000000000045,
      "endSec": 3.690588235294115,
      "emphasis": []
    },
    {
      "text": "19時ぐらいに",
      "startSec": 3.690588235294115,
      "endSec": 4.439999999999998,
      "emphasis": []
    },
    {
      "text": "やるのが良い",
      "startSec": 4.439999999999998,
      "endSec": 4.969411764705853,
      "emphasis": []
    },
    {
      "text": "と言われてますけれども",
      "startSec": 4.969411764705853,
      "endSec": 5.939999999999998,
      "emphasis": []
    },
    {
      "text": "これ理由に関して",
      "startSec": 5.939999999999998,
      "endSec": 6.704444444444448,
      "emphasis": []
    },
    {
      "text": "はですねこれぐらいの",
      "startSec": 6.704444444444448,
      "endSec": 7.659999999999968,
      "emphasis": []
    },
    {
      "text": "時間帯が最も人間の",
      "startSec": 7.659999999999968,
      "endSec": 8.799999999999955,
      "emphasis": [
        {
          "start": 6,
          "end": 9,
          "label": "人間の"
        }
      ]
    },
    {
      "text": "深部体温が",
      "startSec": 8.799999999999955,
      "endSec": 9.3642857142857,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "深部体温"
        }
      ]
    },
    {
      "text": "上がってですねこう",
      "startSec": 9.3642857142857,
      "endSec": 10.379999999999995,
      "emphasis": []
    },
    {
      "text": "神経伝達速度が",
      "startSec": 10.379999999999995,
      "endSec": 11.071249999999964,
      "emphasis": [
        {
          "start": 0,
          "end": 6,
          "label": "神経伝達速度"
        }
      ]
    },
    {
      "text": "上がるということが",
      "startSec": 11.071249999999964,
      "endSec": 11.95999999999998,
      "emphasis": []
    },
    {
      "text": "わかっています",
      "startSec": 11.95999999999998,
      "endSec": 12.978947368421018,
      "emphasis": []
    },
    {
      "text": "なのでまあ筋力トレって",
      "startSec": 12.978947368421018,
      "endSec": 14.379999999999995,
      "emphasis": [
        {
          "start": 5,
          "end": 9,
          "label": "筋力トレ"
        }
      ]
    },
    {
      "text": "ですねもちろん",
      "startSec": 14.379999999999995,
      "endSec": 14.942499999999995,
      "emphasis": []
    },
    {
      "text": "ですけれどもあの",
      "startSec": 14.942499999999995,
      "endSec": 16.17999999999995,
      "emphasis": []
    },
    {
      "text": "ギリギリまで追い込んで",
      "startSec": 16.17999999999995,
      "endSec": 16.939999999999998,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "ギリギリ"
        }
      ]
    },
    {
      "text": "いくみたいなことがすごく",
      "startSec": 16.939999999999998,
      "endSec": 17.879999999999995,
      "emphasis": [
        {
          "start": 9,
          "end": 12,
          "label": "すごく"
        }
      ]
    },
    {
      "text": "重要だったりもしますので",
      "startSec": 17.879999999999995,
      "endSec": 20.120000000000005,
      "emphasis": []
    },
    {
      "text": "追い込むって",
      "startSec": 20.120000000000005,
      "endSec": 20.664615384615388,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "追い込む"
        }
      ]
    },
    {
      "text": "いってもですね",
      "startSec": 20.664615384615388,
      "endSec": 21.299999999999955,
      "emphasis": []
    },
    {
      "text": "これもまた面白い",
      "startSec": 21.299999999999955,
      "endSec": 22.297647058823486,
      "emphasis": []
    },
    {
      "text": "話なんですけどあの",
      "startSec": 22.297647058823486,
      "endSec": 23.41999999999996,
      "emphasis": []
    },
    {
      "text": "なんていうんでしょう",
      "startSec": 23.41999999999996,
      "endSec": 23.779999999999973,
      "emphasis": []
    },
    {
      "text": "今まではですね",
      "startSec": 23.779999999999973,
      "endSec": 24.139999999999986,
      "emphasis": []
    },
    {
      "text": "もう1回ももう",
      "startSec": 24.139999999999986,
      "endSec": 25.19999999999999,
      "emphasis": []
    },
    {
      "text": "上がらないみたいな",
      "startSec": 25.19999999999999,
      "endSec": 26.063999999999965,
      "emphasis": []
    },
    {
      "text": "ところまでね",
      "startSec": 26.063999999999965,
      "endSec": 26.639999999999986,
      "emphasis": []
    },
    {
      "text": "追い込むのがいいみたいな",
      "startSec": 26.639999999999986,
      "endSec": 27.519999999999982,
      "emphasis": []
    },
    {
      "text": "理論がですね",
      "startSec": 27.519999999999982,
      "endSec": 28.26666666666665,
      "emphasis": []
    },
    {
      "text": "ずーっとあってもそれを",
      "startSec": 28.26666666666665,
      "endSec": 29.439999999999998,
      "emphasis": []
    },
    {
      "text": "パーソナルトレーナー",
      "startSec": 29.439999999999998,
      "endSec": 29.755384615384628,
      "emphasis": []
    },
    {
      "text": "たちも",
      "startSec": 29.755384615384628,
      "endSec": 30.25999999999999,
      "emphasis": []
    },
    {
      "text": "一生懸命ですね",
      "startSec": 30.25999999999999,
      "endSec": 30.798461538461538,
      "emphasis": []
    },
    {
      "text": "ギリギリまで",
      "startSec": 30.798461538461538,
      "endSec": 31.25999999999999,
      "emphasis": []
    },
    {
      "text": "やらせたりしてたわけ",
      "startSec": 31.25999999999999,
      "endSec": 31.859999999999957,
      "emphasis": []
    },
    {
      "text": "なんですが最新の",
      "startSec": 31.91999999999996,
      "endSec": 32.64947368421048,
      "emphasis": []
    },
    {
      "text": "エビデンスだとですね",
      "startSec": 32.64947368421048,
      "endSec": 33.45999999999998,
      "emphasis": []
    },
    {
      "text": "あと1回から3回ぐらい",
      "startSec": 33.45999999999998,
      "endSec": 35.35999999999996,
      "emphasis": []
    },
    {
      "text": "できるぐらいの重さでも",
      "startSec": 35.35999999999996,
      "endSec": 37.19999999999999,
      "emphasis": []
    },
    {
      "text": "効果が変わらない",
      "startSec": 37.19999999999999,
      "endSec": 37.620000000000005,
      "emphasis": []
    },
    {
      "text": "ということは",
      "startSec": 37.620000000000005,
      "endSec": 37.81999999999999,
      "emphasis": []
    },
    {
      "text": "わかってきています",
      "startSec": 37.81999999999999,
      "endSec": 38.120000000000005,
      "emphasis": []
    },
    {
      "text": "なんであの超",
      "startSec": 38.120000000000005,
      "endSec": 39.36615384615385,
      "emphasis": []
    },
    {
      "text": "追い込む必要は",
      "startSec": 39.36615384615385,
      "endSec": 40.81999999999999,
      "emphasis": []
    },
    {
      "text": "ないんですけれども",
      "startSec": 40.81999999999999,
      "endSec": 41.862105263157844,
      "emphasis": []
    },
    {
      "text": "まあとはいえですね",
      "startSec": 41.862105263157844,
      "endSec": 42.799999999999955,
      "emphasis": []
    },
    {
      "text": "一定の追い込みが",
      "startSec": 42.799999999999955,
      "endSec": 44.17846153846148,
      "emphasis": []
    },
    {
      "text": "必要ですし",
      "startSec": 44.17846153846148,
      "endSec": 45.039999999999964,
      "emphasis": []
    },
    {
      "text": "一定のパフォーマンスが",
      "startSec": 45.039999999999964,
      "endSec": 46.579999999999984,
      "emphasis": []
    },
    {
      "text": "高い状態で",
      "startSec": 46.579999999999984,
      "endSec": 47.27999999999997,
      "emphasis": []
    },
    {
      "text": "まぁ少しずつ",
      "startSec": 47.27999999999997,
      "endSec": 47.88923076923072,
      "emphasis": []
    },
    {
      "text": "高重量を上げて",
      "startSec": 47.88923076923072,
      "endSec": 48.599999999999966,
      "emphasis": []
    },
    {
      "text": "行ったりとかですね",
      "startSec": 48.599999999999966,
      "endSec": 49.299999999999955,
      "emphasis": []
    },
    {
      "text": "まあこういう",
      "startSec": 49.299999999999955,
      "endSec": 49.71999999999997,
      "emphasis": []
    },
    {
      "text": "ことはやっぱり",
      "startSec": 49.71999999999997,
      "endSec": 50.33249999999998,
      "emphasis": []
    },
    {
      "text": "筋力を上げてくるとすごく",
      "startSec": 50.33249999999998,
      "endSec": 51.632000000000005,
      "emphasis": []
    },
    {
      "text": "大切なことなんですがこの",
      "startSec": 51.632000000000005,
      "endSec": 53.67999999999995,
      "emphasis": []
    },
    {
      "text": "パフォーマンス",
      "startSec": 53.67999999999995,
      "endSec": 53.71999999999997,
      "emphasis": []
    },
    {
      "text": "を最大化",
      "startSec": 53.71999999999997,
      "endSec": 54.11384615384611,
      "emphasis": []
    },
    {
      "text": "するという意味では",
      "startSec": 54.11384615384611,
      "endSec": 55,
      "emphasis": []
    },
    {
      "text": "夕方がですね",
      "startSec": 55,
      "endSec": 55.80250000000001,
      "emphasis": []
    },
    {
      "text": "もっとも合理的だろう",
      "startSec": 55.80250000000001,
      "endSec": 57.139999999999986,
      "emphasis": []
    },
    {
      "text": "というふうに",
      "startSec": 57.139999999999986,
      "endSec": 57.9028571428571,
      "emphasis": []
    },
    {
      "text": "考えられています",
      "startSec": 57.9028571428571,
      "endSec": 58.91999999999996,
      "emphasis": []
    },
    {
      "text": "なんでですね",
      "startSec": 59.77999999999997,
      "endSec": 60.379999999999995,
      "emphasis": []
    },
    {
      "text": "まぁ特に経営者とか",
      "startSec": 60.379999999999995,
      "endSec": 61.27999999999997,
      "emphasis": []
    },
    {
      "text": "やってるとまあ",
      "startSec": 61.27999999999997,
      "endSec": 62.054117647058774,
      "emphasis": []
    },
    {
      "text": "夜にね会食とかも結構",
      "startSec": 62.054117647058774,
      "endSec": 63.15999999999997,
      "emphasis": []
    },
    {
      "text": "あってインテークですね",
      "startSec": 63.15999999999997,
      "endSec": 64.94,
      "emphasis": []
    },
    {
      "text": "カロリーの消費",
      "startSec": 64.94,
      "endSec": 65.79999999999995,
      "emphasis": []
    },
    {
      "text": "摂取量が",
      "startSec": 65.79999999999995,
      "endSec": 66.6553846153846,
      "emphasis": []
    },
    {
      "text": "増えたりとか",
      "startSec": 66.6553846153846,
      "endSec": 67.8016752136752,
      "emphasis": []
    },
    {
      "text": "すると思いますので",
      "startSec": 67.8016752136752,
      "endSec": 69.52111111111111,
      "emphasis": []
    },
    {
      "text": "事前にですねそれぐらい",
      "startSec": 69.52111111111111,
      "endSec": 71,
      "emphasis": []
    },
    {
      "text": "の夕方の時間にちょっと",
      "startSec": 71,
      "endSec": 71.88,
      "emphasis": []
    },
    {
      "text": "こう筋トレを",
      "startSec": 71.88,
      "endSec": 72.35999999999996,
      "emphasis": []
    },
    {
      "text": "入れてあげてから会食に",
      "startSec": 72.35999999999996,
      "endSec": 73.33999999999997,
      "emphasis": []
    },
    {
      "text": "向かってあげると",
      "startSec": 73.33999999999997,
      "endSec": 73.83999999999997,
      "emphasis": []
    },
    {
      "text": "ですね筋合成もしっかり",
      "startSec": 73.83999999999997,
      "endSec": 75.07999999999998,
      "emphasis": []
    },
    {
      "text": "進みますし非常に",
      "startSec": 75.07999999999998,
      "endSec": 76.59999999999997,
      "emphasis": []
    },
    {
      "text": "効率的なんじゃないかな",
      "startSec": 76.59999999999997,
      "endSec": 77.63529411764705,
      "emphasis": []
    },
    {
      "text": "というふうに",
      "startSec": 77.63529411764705,
      "endSec": 78.19999999999999,
      "emphasis": []
    },
    {
      "text": "考えてます",
      "startSec": 78.19999999999999,
      "endSec": 79.56,
      "emphasis": []
    }
  ],
  "cameraSwitches": [
    {
      "atSec": 0,
      "camera": "front"
    }
  ]
}
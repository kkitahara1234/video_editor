{
  "shortId": "short-002",
  "title": "安定性の重要性",
  "startSec": 763,
  "endSec": 837.8,
  "telops": [
    {
      "text": "そして3つ目ですね",
      "startSec": 0.01999999999998181,
      "endSec": 2.2000000000000455,
      "emphasis": []
    },
    {
      "text": "安定性ですね",
      "startSec": 2.2000000000000455,
      "endSec": 3.2663865546218176,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "安定性"
        }
      ]
    },
    {
      "text": "これは特にですねあの",
      "startSec": 3.2663865546218176,
      "endSec": 5.019999999999982,
      "emphasis": []
    },
    {
      "text": "成果が大好きな",
      "startSec": 5.019999999999982,
      "endSec": 5.909411764705851,
      "emphasis": [
        {
          "start": 3,
          "end": 6,
          "label": "大好き"
        }
      ]
    },
    {
      "text": "経営者は結構忘れがち",
      "startSec": 5.909411764705851,
      "endSec": 7.17999999999995,
      "emphasis": []
    },
    {
      "text": "なんですけれども",
      "startSec": 7.17999999999995,
      "endSec": 7.980000000000018,
      "emphasis": []
    },
    {
      "text": "筋肉ばっかり",
      "startSec": 8.480000000000018,
      "endSec": 9.217142857142903,
      "emphasis": [
        {
          "start": 0,
          "end": 6,
          "label": "筋肉ばっかり"
        }
      ]
    },
    {
      "text": "ゴリゴリゴリゴリ",
      "startSec": 9.217142857142903,
      "endSec": 10.200000000000045,
      "emphasis": [
        {
          "start": 0,
          "end": 8,
          "label": "ゴリゴリゴリゴリ"
        }
      ]
    },
    {
      "text": "増やしていってですね",
      "startSec": 10.200000000000045,
      "endSec": 11.616250000000036,
      "emphasis": []
    },
    {
      "text": "この安定性",
      "startSec": 11.616250000000036,
      "endSec": 12.259999999999991,
      "emphasis": [
        {
          "start": 2,
          "end": 5,
          "label": "安定性"
        }
      ]
    },
    {
      "text": "というのを忘れた結果",
      "startSec": 12.259999999999991,
      "endSec": 13.82000000000005,
      "emphasis": []
    },
    {
      "text": "結果的にですね",
      "startSec": 13.82000000000005,
      "endSec": 14.581249999999955,
      "emphasis": []
    },
    {
      "text": "あのヘルニアとか",
      "startSec": 14.581249999999955,
      "endSec": 15.256250000000023,
      "emphasis": []
    },
    {
      "text": "になっちゃってですね",
      "startSec": 15.256250000000023,
      "endSec": 16.100000000000023,
      "emphasis": []
    },
    {
      "text": "今までやってた",
      "startSec": 16.24000000000001,
      "endSec": 16.940000000000055,
      "emphasis": []
    },
    {
      "text": "トレーニングも",
      "startSec": 16.940000000000055,
      "endSec": 17.639999999999986,
      "emphasis": []
    },
    {
      "text": "できなくなってなんなら",
      "startSec": 17.639999999999986,
      "endSec": 18.899999999999977,
      "emphasis": []
    },
    {
      "text": "ゴルフやってたのに",
      "startSec": 18.899999999999977,
      "endSec": 19.744615384615372,
      "emphasis": []
    },
    {
      "text": "ゴルフも",
      "startSec": 19.744615384615372,
      "endSec": 20.120000000000005,
      "emphasis": []
    },
    {
      "text": "いけなくなってみたいな人",
      "startSec": 20.120000000000005,
      "endSec": 21.920000000000073,
      "emphasis": []
    },
    {
      "text": "結構いらっしゃいます",
      "startSec": 21.920000000000073,
      "endSec": 23,
      "emphasis": []
    },
    {
      "text": "これはまあ",
      "startSec": 23,
      "endSec": 23.66428571428571,
      "emphasis": []
    },
    {
      "text": "スタビリティですね",
      "startSec": 23.66428571428571,
      "endSec": 24.860000000000014,
      "emphasis": [
        {
          "start": 0,
          "end": 6,
          "label": "スタビリティ"
        }
      ]
    },
    {
      "text": "安定性の",
      "startSec": 24.860000000000014,
      "endSec": 25.561538461538476,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "安定性"
        }
      ]
    },
    {
      "text": "話なんですけれども",
      "startSec": 25.561538461538476,
      "endSec": 27.139999999999986,
      "emphasis": []
    },
    {
      "text": "普通のですねマシン",
      "startSec": 27.139999999999986,
      "endSec": 28.347058823529437,
      "emphasis": []
    },
    {
      "text": "トレーニングとか",
      "startSec": 28.347058823529437,
      "endSec": 29.41999999999996,
      "emphasis": []
    },
    {
      "text": "ウェイトトレーニングを",
      "startSec": 29.82000000000005,
      "endSec": 30.779999999999973,
      "emphasis": []
    },
    {
      "text": "やっているだけ",
      "startSec": 30.779999999999973,
      "endSec": 31.29058823529408,
      "emphasis": []
    },
    {
      "text": "だとですね意外とこの",
      "startSec": 31.29058823529408,
      "endSec": 32.01999999999998,
      "emphasis": []
    },
    {
      "text": "安定性っていうのはですね",
      "startSec": 32.01999999999998,
      "endSec": 33.476,
      "emphasis": []
    },
    {
      "text": "あの維持できないんですね",
      "startSec": 33.476,
      "endSec": 34.620000000000005,
      "emphasis": []
    },
    {
      "text": "ただ",
      "startSec": 34.960000000000036,
      "endSec": 35.180000000000064,
      "emphasis": []
    },
    {
      "text": "これがなくなってしまうと",
      "startSec": 35.180000000000064,
      "endSec": 36.5,
      "emphasis": []
    },
    {
      "text": "どれだけ筋肉が",
      "startSec": 36.5,
      "endSec": 37.2741176470588,
      "emphasis": []
    },
    {
      "text": "ついてもですね重りが",
      "startSec": 37.2741176470588,
      "endSec": 38.379999999999995,
      "emphasis": []
    },
    {
      "text": "重くなっているだけで",
      "startSec": 38.379999999999995,
      "endSec": 39.5447058823529,
      "emphasis": []
    },
    {
      "text": "それを支える",
      "startSec": 39.5447058823529,
      "endSec": 40.17999999999995,
      "emphasis": []
    },
    {
      "text": "体がないとですね",
      "startSec": 40.17999999999995,
      "endSec": 41.200000000000045,
      "emphasis": []
    },
    {
      "text": "結局に怪我の",
      "startSec": 41.200000000000045,
      "endSec": 41.88307692307694,
      "emphasis": []
    },
    {
      "text": "リスクとかって",
      "startSec": 41.88307692307694,
      "endSec": 42.67999999999995,
      "emphasis": []
    },
    {
      "text": "いうかむしろ",
      "startSec": 42.67999999999995,
      "endSec": 43.264999999999986,
      "emphasis": []
    },
    {
      "text": "上がってしまうという",
      "startSec": 43.264999999999986,
      "endSec": 44.24000000000001,
      "emphasis": []
    },
    {
      "text": "ことですね",
      "startSec": 44.24000000000001,
      "endSec": 44.928,
      "emphasis": []
    },
    {
      "text": "まあじゃあどういう",
      "startSec": 44.928,
      "endSec": 45.960000000000036,
      "emphasis": []
    },
    {
      "text": "トレーニングすれば",
      "startSec": 45.960000000000036,
      "endSec": 46.713750000000005,
      "emphasis": []
    },
    {
      "text": "いいかというと",
      "startSec": 46.713750000000005,
      "endSec": 47.299999999999955,
      "emphasis": []
    },
    {
      "text": "有名なので言うと",
      "startSec": 47.299999999999955,
      "endSec": 48.15999999999997,
      "emphasis": []
    },
    {
      "text": "ブルガリアンスクワット",
      "startSec": 48.15999999999997,
      "endSec": 49.04000000000008,
      "emphasis": []
    },
    {
      "text": "とかあとは",
      "startSec": 49.04000000000008,
      "endSec": 49.46086956521742,
      "emphasis": []
    },
    {
      "text": "片足立ちとかですかね",
      "startSec": 49.46086956521742,
      "endSec": 50.33043478260879,
      "emphasis": []
    },
    {
      "text": "そういうものをですね",
      "startSec": 50.33043478260879,
      "endSec": 51.200000000000045,
      "emphasis": []
    },
    {
      "text": "日頃のトレーニングに",
      "startSec": 51.200000000000045,
      "endSec": 52.360000000000014,
      "emphasis": []
    },
    {
      "text": "取り組んで",
      "startSec": 52.360000000000014,
      "endSec": 52.940000000000055,
      "emphasis": []
    },
    {
      "text": "いただくことで左右の",
      "startSec": 52.940000000000055,
      "endSec": 54.940000000000055,
      "emphasis": []
    },
    {
      "text": "バランスをうまく",
      "startSec": 54.940000000000055,
      "endSec": 55.686666666666724,
      "emphasis": []
    },
    {
      "text": "とるとか体幹を",
      "startSec": 55.686666666666724,
      "endSec": 56.34000000000003,
      "emphasis": []
    },
    {
      "text": "維持するような",
      "startSec": 56.34000000000003,
      "endSec": 56.83000000000004,
      "emphasis": []
    },
    {
      "text": "力っていうのが",
      "startSec": 56.83000000000004,
      "endSec": 57.32000000000005,
      "emphasis": []
    },
    {
      "text": "出てきますので",
      "startSec": 57.32000000000005,
      "endSec": 58.47733333333338,
      "emphasis": []
    },
    {
      "text": "ここもねしっかり",
      "startSec": 58.47733333333338,
      "endSec": 59.799999999999955,
      "emphasis": []
    },
    {
      "text": "ポートフォリオに",
      "startSec": 59.799999999999955,
      "endSec": 60.61777777777775,
      "emphasis": []
    },
    {
      "text": "組み込んでいただくと",
      "startSec": 60.61777777777775,
      "endSec": 61.639999999999986,
      "emphasis": []
    },
    {
      "text": "ただただあの",
      "startSec": 61.639999999999986,
      "endSec": 62.489230769230744,
      "emphasis": []
    },
    {
      "text": "使えない筋肉が",
      "startSec": 62.489230769230744,
      "endSec": 63.48000000000002,
      "emphasis": []
    },
    {
      "text": "増えただけというかですね",
      "startSec": 63.48000000000002,
      "endSec": 64.75999999999999,
      "emphasis": []
    },
    {
      "text": "怪我しやすい",
      "startSec": 64.77999999999997,
      "endSec": 65.5,
      "emphasis": []
    },
    {
      "text": "体を作るという",
      "startSec": 65.5,
      "endSec": 66.34000000000003,
      "emphasis": []
    },
    {
      "text": "ことではなくてちゃんと",
      "startSec": 66.34000000000003,
      "endSec": 67.80235294117654,
      "emphasis": []
    },
    {
      "text": "こう安定性を",
      "startSec": 67.80235294117654,
      "endSec": 68.60000000000002,
      "emphasis": []
    },
    {
      "text": "持った状態で",
      "startSec": 68.60000000000002,
      "endSec": 69.58000000000004,
      "emphasis": []
    },
    {
      "text": "筋肉を増やしていく",
      "startSec": 69.58000000000004,
      "endSec": 70.84000000000003,
      "emphasis": []
    },
    {
      "text": "ことができるという",
      "startSec": 70.84000000000003,
      "endSec": 72.15294117647068,
      "emphasis": []
    },
    {
      "text": "ことなのでここも",
      "startSec": 72.15294117647068,
      "endSec": 73.32000000000005,
      "emphasis": []
    },
    {
      "text": "意識してもらうと",
      "startSec": 73.32000000000005,
      "endSec": 73.98823529411766,
      "emphasis": []
    },
    {
      "text": "いいかなと思います",
      "startSec": 73.98823529411766,
      "endSec": 74.74000000000001,
      "emphasis": []
    }
  ],

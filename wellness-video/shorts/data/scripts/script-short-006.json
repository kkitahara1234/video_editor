{
  "shortId": "short-006",
  "title": "医療の新たな形",
  "startSec": 1781.46,
  "endSec": 1871.62,
  "telops": [
    {
      "text": "もう一つの観点はですね",
      "startSec": 0,
      "endSec": 1.417777777777701,
      "emphasis": []
    },
    {
      "text": "プロアクティブ",
      "startSec": 1.417777777777701,
      "endSec": 2.3199999999999363,
      "emphasis": [
        {
          "start": 0,
          "end": 7,
          "label": "プロアクティブ"
        }
      ]
    },
    {
      "text": "かリアクティブかという",
      "startSec": 2.3199999999999363,
      "endSec": 3.4400000000000546,
      "emphasis": []
    },
    {
      "text": "考え方ですけれども",
      "startSec": 3.4400000000000546,
      "endSec": 5.1177777777777465,
      "emphasis": []
    },
    {
      "text": "一般的な今までの",
      "startSec": 5.1177777777777465,
      "endSec": 6.460000000000036,
      "emphasis": []
    },
    {
      "text": "医療ですねさっき話した",
      "startSec": 6.460000000000036,
      "endSec": 7.680000000000064,
      "emphasis": []
    },
    {
      "text": "通り保険診療のもとで",
      "startSec": 7.680000000000064,
      "endSec": 8.957777777777892,
      "emphasis": []
    },
    {
      "text": "提供されますので",
      "startSec": 8.957777777777892,
      "endSec": 9.980000000000018,
      "emphasis": []
    },
    {
      "text": "基本的には",
      "startSec": 9.980000000000018,
      "endSec": 10.618461538461588,
      "emphasis": []
    },
    {
      "text": "リアクティブです",
      "startSec": 10.618461538461588,
      "endSec": 11.639999999999873,
      "emphasis": [
        {
          "start": 0,
          "end": 6,
          "label": "リアクティブ"
        }
      ]
    },
    {
      "text": "要は患者さんが来た時に",
      "startSec": 11.639999999999873,
      "endSec": 13.82899999999995,
      "emphasis": []
    },
    {
      "text": "それに反応する形で",
      "startSec": 13.82899999999995,
      "endSec": 15.61999999999989,
      "emphasis": []
    },
    {
      "text": "医療を提供",
      "startSec": 15.61999999999989,
      "endSec": 16.078823529411693,
      "emphasis": []
    },
    {
      "text": "させていただくというのが",
      "startSec": 16.078823529411693,
      "endSec": 17.180000000000064,
      "emphasis": []
    },
    {
      "text": "リアクティブな医療ですね",
      "startSec": 17.200000000000045,
      "endSec": 18.279999999999973,
      "emphasis": [
        {
          "start": 0,
          "end": 6,
          "label": "リアクティブ"
        }
      ]
    },
    {
      "text": "皆さんかかりつけ医いるよ",
      "startSec": 18.279999999999973,
      "endSec": 20.00235294117647,
      "emphasis": []
    },
    {
      "text": "って言うと",
      "startSec": 20.00235294117647,
      "endSec": 20.720000000000027,
      "emphasis": []
    },
    {
      "text": "あくまで風邪をひいた時に",
      "startSec": 20.720000000000027,
      "endSec": 21.958399999999983,
      "emphasis": []
    },
    {
      "text": "かかっている先生が",
      "startSec": 21.958399999999983,
      "endSec": 22.887199999999893,
      "emphasis": []
    },
    {
      "text": "いるとか",
      "startSec": 22.887199999999893,
      "endSec": 23.299999999999955,
      "emphasis": []
    },
    {
      "text": "血圧が高いから血圧の",
      "startSec": 23.299999999999955,
      "endSec": 26.319999999999936,
      "emphasis": []
    },
    {
      "text": "薬をもらいに",
      "startSec": 26.319999999999936,
      "endSec": 26.934999999999945,
      "emphasis": []
    },
    {
      "text": "行っている先生がいる",
      "startSec": 26.934999999999945,
      "endSec": 27.960000000000036,
      "emphasis": []
    },
    {
      "text": "みたいなことを",
      "startSec": 27.960000000000036,
      "endSec": 28.864615384615263,
      "emphasis": []
    },
    {
      "text": "かかりつけ医",
      "startSec": 28.864615384615263,
      "endSec": 29.639999999999873,
      "emphasis": []
    },
    {
      "text": "っていうふうに",
      "startSec": 29.639999999999873,
      "endSec": 30.211941176470418,
      "emphasis": []
    },
    {
      "text": "言ってると思います",
      "startSec": 30.211941176470418,
      "endSec": 30.94729411764706,
      "emphasis": []
    },
    {
      "text": "ただこれはあくまで問題が",
      "startSec": 30.94729411764706,
      "endSec": 32.51999999999998,
      "emphasis": []
    },
    {
      "text": "起きた部分に対して",
      "startSec": 32.51999999999998,
      "endSec": 34.103999999999814,
      "emphasis": []
    },
    {
      "text": "定期的に見て",
      "startSec": 34.103999999999814,
      "endSec": 35.159999999999854,
      "emphasis": []
    },
    {
      "text": "もらっているって",
      "startSec": 35.159999999999854,
      "endSec": 35.75,
      "emphasis": []
    },
    {
      "text": "いうことを言っているって",
      "startSec": 35.75,
      "endSec": 36.86571428571415,
      "emphasis": []
    },
    {
      "text": "ことだと思うんですね",
      "startSec": 36.86571428571415,
      "endSec": 38.180000000000064,
      "emphasis": []
    },
    {
      "text": "僕らはですね",
      "startSec": 38.180000000000064,
      "endSec": 38.94285714285729,
      "emphasis": []
    },
    {
      "text": "プロアクティブに",
      "startSec": 38.94285714285729,
      "endSec": 39.960000000000036,
      "emphasis": [
        {
          "start": 0,
          "end": 7,
          "label": "プロアクティブ"
        }
      ]
    },
    {
      "text": "介入します",
      "startSec": 39.960000000000036,
      "endSec": 40.460000000000036,
      "emphasis": []
    },
    {
      "text": "つまり能動的に",
      "startSec": 40.460000000000036,
      "endSec": 41.25333333333333,
      "emphasis": [
        {
          "start": 3,
          "end": 6,
          "label": "能動的"
        }
      ]
    },
    {
      "text": "介入していきます",
      "startSec": 41.25333333333333,
      "endSec": 42.159999999999854,
      "emphasis": []
    },
    {
      "text": "なので今症状があるか",
      "startSec": 42.8599999999999,
      "endSec": 44.471111111110986,
      "emphasis": []
    },
    {
      "text": "どうかとか検査で",
      "startSec": 44.471111111110986,
      "endSec": 45.75999999999999,
      "emphasis": []
    },
    {
      "text": "明らかな異常が",
      "startSec": 45.75999999999999,
      "endSec": 46.59066666666672,
      "emphasis": []
    },
    {
      "text": "あるかどうかって",
      "startSec": 46.59066666666672,
      "endSec": 47.539999999999964,
      "emphasis": []
    },
    {
      "text": "いうだけではなくてですね",
      "startSec": 47.539999999999964,
      "endSec": 48.5,
      "emphasis": []
    },
    {
      "text": "今後この",
      "startSec": 48.92000000000007,
      "endSec": 49.445000000000164,
      "emphasis": []
    },
    {
      "text": "ままいったらどういう風な",
      "startSec": 49.445000000000164,
      "endSec": 51.01999999999998,
      "emphasis": []
    },
    {
      "text": "病気になるリスクが高いか",
      "startSec": 51.01999999999998,
      "endSec": 52.54941176470584,
      "emphasis": []
    },
    {
      "text": "あるいは",
      "startSec": 52.54941176470584,
      "endSec": 53.01999999999998,
      "emphasis": []
    },
    {
      "text": "◯◯さんの場合は",
      "startSec": 53.01999999999998,
      "endSec": 53.98000000000002,
      "emphasis": []
    },
    {
      "text": "どういうリスクが",
      "startSec": 53.98000000000002,
      "endSec": 54.940000000000055,
      "emphasis": []
    },
    {
      "text": "高いからどこの検査を",
      "startSec": 54.940000000000055,
      "endSec": 56.039999999999964,
      "emphasis": []
    },
    {
      "text": "受けた方がいいか",
      "startSec": 56.039999999999964,
      "endSec": 56.92000000000007,
      "emphasis": []
    },
    {
      "text": "みたいなことをですね",
      "startSec": 56.92000000000007,
      "endSec": 58.56352941176465,
      "emphasis": []
    },
    {
      "text": "問題が起こる",
      "startSec": 58.56352941176465,
      "endSec": 59.460000000000036,
      "emphasis": []
    },
    {
      "text": "前の段階から",
      "startSec": 59.460000000000036,
      "endSec": 60.200000000000045,
      "emphasis": []
    },
    {
      "text": "しっかり関わっていくって",
      "startSec": 60.200000000000045,
      "endSec": 61.680000000000064,
      "emphasis": []
    },
    {
      "text": "いうのが",
      "startSec": 61.680000000000064,
      "endSec": 62.147692307692296,
      "emphasis": []
    },
    {
      "text": "特徴になっていますなので",
      "startSec": 62.147692307692296,
      "endSec": 64.22000000000003,
      "emphasis": []
    },
    {
      "text": "かかりつけ医いるからとか",
      "startSec": 64.22000000000003,
      "endSec": 65.89999999999986,
      "emphasis": []
    },
    {
      "text": "医者の",
      "startSec": 65.89999999999986,
      "endSec": 66.16076923076912,
      "emphasis": []
    },
    {
      "text": "友達いるからっていう",
      "startSec": 66.16076923076912,
      "endSec": 67.02999999999997,
      "emphasis": []
    },
    {
      "text": "ことではなくてですね",
      "startSec": 67.02999999999997,
      "endSec": 68.83277777777789,
      "emphasis": []
    },
    {
      "text": "自分の体全体の",
      "startSec": 68.83277777777789,
      "endSec": 69.98000000000002,
      "emphasis": []
    },
    {
      "text": "健康データを把握",
      "startSec": 69.98000000000002,
      "endSec": 71.29555555555567,
      "emphasis": []
    },
    {
      "text": "した上で一緒に将来の",
      "startSec": 71.29555555555567,
      "endSec": 72.94000000000005,
      "emphasis": []
    },
    {
      "text": "健康を守るための戦略を",
      "startSec": 72.94000000000005,
      "endSec": 74.37999999999988,
      "emphasis": []
    },
    {
      "text": "立てていくっていうのが",
      "startSec": 74.37999999999988,
      "endSec": 75.31999999999994,
      "emphasis": []
    },
    {
      "text": "我々パーソナルドクター",
      "startSec": 75.31999999999994,
      "endSec": 76.46782608695639,
      "emphasis": [
        {
          "start": 2,
          "end": 11,
          "label": "パーソナルドクター"
        }
      ]
    },
    {
      "text": "の仕事になっていますので",
      "startSec": 76.46782608695639,
      "endSec": 77.72000000000003,
      "emphasis": []
    },
    {
      "text": "ただかかりつけ医が",
      "startSec": 77.72000000000003,
      "endSec": 79.33999999999992,
      "emphasis": []
    },
    {
      "text": "いるということと",
      "startSec": 79.33999999999992,
      "endSec": 80.52588235294115,
      "emphasis": []
    },
    {
      "text": "は全く違う話ですと",
      "startSec": 80.52588235294115,
      "endSec": 81.8599999999999,
      "emphasis": []
    },
    {
      "text": "なのでですねまぁ",
      "startSec": 81.8599999999999,
      "endSec": 82.74470588235295,
      "emphasis": []
    },
    {
      "text": "健康に豊かな人生を送るか",
      "startSec": 82.74470588235295,
      "endSec": 84.19200000000001,
      "emphasis": []
    },
    {
      "text": "送りたいと思っている方は",
      "startSec": 84.19200000000001,
      "endSec": 86,
      "emphasis": []
    },
    {
      "text": "もちろんね",
      "startSec": 86,
      "endSec": 86.77250000000004,
      "emphasis": []
    },
    {
      "text": "調子が悪くなった時に",
      "startSec": 86.77250000000004,
      "endSec": 88.05999999999995,
      "emphasis": []
    },
    {
      "text": "相談できる",
      "startSec": 88.05999999999995,
      "endSec": 88.44749999999999,
      "emphasis": []
    },
    {
      "text": "医者がいるっていうのは",
      "startSec": 88.44749999999999,
      "endSec": 89.29999999999995,
      "emphasis": []
    },
    {
      "text": "素晴らしいことだと思うん",
      "startSec": 89.29999999999995,
      "endSec": 90.15999999999985,
      "emphasis": []
    }
  ],
  "cameraSwitches": [
    {
      "atSec": 0,

{
  "shortId": "short-001",
  "title": "筋力トレーニングの重要性",
  "startSec": 426.9,
  "endSec": 497.5,
  "telops": [
    {
      "text": "ビタミンDって",
      "startSec": 0,
      "endSec": 1.3400000000000318,
      "emphasis": []
    },
    {
      "text": "いうのはですね",
      "startSec": 1.3400000000000318,
      "endSec": 1.9437500000000227,
      "emphasis": []
    },
    {
      "text": "紫外線を浴びてこう皮膚で",
      "startSec": 1.9437500000000227,
      "endSec": 3.1440000000000055,
      "emphasis": []
    },
    {
      "text": "産生されるんですけれども",
      "startSec": 3.1440000000000055,
      "endSec": 4.840000000000032,
      "emphasis": []
    },
    {
      "text": "これ自体も欠乏している",
      "startSec": 4.840000000000032,
      "endSec": 5.720000000000027,
      "emphasis": [
        {
          "start": 5,
          "end": 7,
          "label": "欠乏"
        }
      ]
    },
    {
      "text": "ビタミンDが欠乏すると",
      "startSec": 5.720000000000027,
      "endSec": 7.240000000000009,
      "emphasis": [
        {
          "start": 6,
          "end": 8,
          "label": "欠乏"
        }
      ]
    },
    {
      "text": "カルシウムの腸管で",
      "startSec": 7.240000000000009,
      "endSec": 8.78000000000003,
      "emphasis": []
    },
    {
      "text": "の吸収だったりとか",
      "startSec": 8.78000000000003,
      "endSec": 10.32000000000005,
      "emphasis": []
    },
    {
      "text": "骨にですねカルシウムを",
      "startSec": 10.32000000000005,
      "endSec": 11.439999999999998,
      "emphasis": []
    },
    {
      "text": "定着させていくところの",
      "startSec": 11.439999999999998,
      "endSec": 12.466666666666697,
      "emphasis": []
    },
    {
      "text": "がまずうまくいかない",
      "startSec": 12.466666666666697,
      "endSec": 13.400000000000034,
      "emphasis": []
    },
    {
      "text": "でかつ",
      "startSec": 13.400000000000034,
      "endSec": 13.922857142857197,
      "emphasis": []
    },
    {
      "text": "運動もなかなかしないで",
      "startSec": 13.922857142857197,
      "endSec": 15.840000000000032,
      "emphasis": []
    },
    {
      "text": "ですねずっとこう",
      "startSec": 15.840000000000032,
      "endSec": 16.395294117647097,
      "emphasis": []
    },
    {
      "text": "デスクワークとかを",
      "startSec": 16.395294117647097,
      "endSec": 17.02000000000004,
      "emphasis": []
    },
    {
      "text": "していると",
      "startSec": 17.02000000000004,
      "endSec": 17.92352941176472,
      "emphasis": []
    },
    {
      "text": "骨に刺激も入らないので",
      "startSec": 17.92352941176472,
      "endSec": 19.58000000000004,
      "emphasis": []
    },
    {
      "text": "そうするとですね",
      "startSec": 19.58000000000004,
      "endSec": 20.380000000000052,
      "emphasis": []
    },
    {
      "text": "どんどんの骨密度が",
      "startSec": 20.380000000000052,
      "endSec": 21.28000000000003,
      "emphasis": [
        {
          "start": 5,
          "end": 8,
          "label": "骨密度"
        }
      ]
    },
    {
      "text": "脆い人たちという",
      "startSec": 21.28000000000003,
      "endSec": 22.122666666666703,
      "emphasis": [
        {
          "start": 0,
          "end": 2,
          "label": "脆い"
        }
      ]
    },
    {
      "text": "のがですねあの",
      "startSec": 22.122666666666703,
      "endSec": 22.860000000000014,
      "emphasis": []
    },
    {
      "text": "増えてきてまして",
      "startSec": 22.860000000000014,
      "endSec": 23.961176470588214,
      "emphasis": []
    },
    {
      "text": "最近だと本当僕の",
      "startSec": 23.961176470588214,
      "endSec": 24.939999999999998,
      "emphasis": []
    },
    {
      "text": "クライアントでもですね",
      "startSec": 24.939999999999998,
      "endSec": 26.105999999999995,
      "emphasis": []
    },
    {
      "text": "20〜30代とかの",
      "startSec": 26.105999999999995,
      "endSec": 27.060000000000002,
      "emphasis": []
    },
    {
      "text": "バリバリ動いている",
      "startSec": 27.060000000000002,
      "endSec": 27.948750000000018,
      "emphasis": []
    },
    {
      "text": "経営者とかでも",
      "startSec": 27.948750000000018,
      "endSec": 28.640000000000043,
      "emphasis": []
    },
    {
      "text": "やっぱり日中デスク",
      "startSec": 28.640000000000043,
      "endSec": 29.800000000000068,
      "emphasis": []
    },
    {
      "text": "ワークで夜酒飲んで",
      "startSec": 29.800000000000068,
      "endSec": 30.960000000000036,
      "emphasis": []
    },
    {
      "text": "運動しない",
      "startSec": 30.960000000000036,
      "endSec": 31.672500000000014,
      "emphasis": []
    },
    {
      "text": "みたいな人だとですね",
      "startSec": 31.672500000000014,
      "endSec": 32.860000000000014,
      "emphasis": []
    },
    {
      "text": "本当にあの60歳",
      "startSec": 32.860000000000014,
      "endSec": 33.948000000000036,
      "emphasis": []
    },
    {
      "text": "70歳ぐらいの",
      "startSec": 33.948000000000036,
      "endSec": 34.900000000000034,
      "emphasis": []
    },
    {
      "text": "骨密度みたいな人も",
      "startSec": 34.900000000000034,
      "endSec": 35.82000000000005,
      "emphasis": []
    },
    {
      "text": "結構いたりしますと",
      "startSec": 35.82000000000005,
      "endSec": 36.74000000000001,
      "emphasis": []
    },
    {
      "text": "でその中でまぁ",
      "startSec": 36.74000000000001,
      "endSec": 38.660000000000025,
      "emphasis": []
    },
    {
      "text": "ここ筋力トレーニングとか",
      "startSec": 38.660000000000025,
      "endSec": 39.518947368421095,
      "emphasis": []
    },
    {
      "text": "ですねしっかり",
      "startSec": 39.518947368421095,
      "endSec": 40.02000000000004,
      "emphasis": []
    },
    {
      "text": "やりながら一定の",
      "startSec": 40.02000000000004,
      "endSec": 41.04857142857145,
      "emphasis": []
    },
    {
      "text": "負荷をかけて",
      "startSec": 41.04857142857145,
      "endSec": 41.82000000000005,
      "emphasis": []
    },
    {
      "text": "あげるということは",
      "startSec": 41.82000000000005,
      "endSec": 42.900000000000034,
      "emphasis": []
    },
    {
      "text": "この骨密度の維持にも",
      "startSec": 42.900000000000034,
      "endSec": 44.10000000000002,
      "emphasis": []
    },
    {
      "text": "非常に重要ですし",
      "startSec": 44.10000000000002,
      "endSec": 45.31846153846158,
      "emphasis": [
        {
          "start": 3,
          "end": 5,
          "label": "重要"
        }
      ]
    },
    {
      "text": "この筋力を",
      "startSec": 45.31846153846158,
      "endSec": 46.08000000000004,
      "emphasis": []
    },
    {
      "text": "維持しておくということ",
      "startSec": 46.08000000000004,
      "endSec": 47.02000000000004,
      "emphasis": []
    },
    {
      "text": "自体がですね将来的な",
      "startSec": 47.02000000000004,
      "endSec": 48.460000000000036,
      "emphasis": []
    },
    {
      "text": "サルコペニアとかって",
      "startSec": 48.460000000000036,
      "endSec": 49.360000000000014,
      "emphasis": []
    },
    {
      "text": "言いますけどその",
      "startSec": 49.360000000000014,
      "endSec": 50.08000000000004,
      "emphasis": []
    },
    {
      "text": "筋力が落ちてしまって",
      "startSec": 50.08000000000004,
      "endSec": 50.460000000000036,
      "emphasis": []
    },
    {
      "text": "動けなくなってくる",
      "startSec": 50.620000000000005,
      "endSec": 52.20400000000001,
      "emphasis": []
    },
    {
      "text": "日常の動作が",
      "startSec": 52.20400000000001,
      "endSec": 53.26000000000005,
      "emphasis": []
    },
    {
      "text": "できなくなってくる",
      "startSec": 53.26000000000005,
      "endSec": 54.013750000000016,
      "emphasis": []
    },
    {
      "text": "みたいなことの",
      "startSec": 54.013750000000016,
      "endSec": 54.60000000000002,
      "emphasis": []
    },
    {
      "text": "予防において",
      "startSec": 54.60000000000002,
      "endSec": 55.59076923076924,
      "emphasis": []
    },
    {
      "text": "すごく重要になっていますね",
      "startSec": 55.59076923076924,
      "endSec": 57.625454545454545,
      "emphasis": [
        {
          "start": 3,
          "end": 5,
          "label": "重要"
        }
      ]
    },
    {
      "text": "結構ね最近はまああの",
      "startSec": 57.625454545454545,
      "endSec": 59.68000000000001,
      "emphasis": []
    },
    {
      "text": "経営者会話でもですね",
      "startSec": 59.68000000000001,
      "endSec": 60.92666666666668,
      "emphasis": []
    },
    {
      "text": "筋トレ頑張ってやる人",
      "startSec": 60.92666666666668,
      "endSec": 62.036,
      "emphasis": []
    },
    {
      "text": "増えてると思うんですけど",
      "startSec": 62.036,
      "endSec": 63.30000000000001,
      "emphasis": []
    },
    {
      "text": "まずですねこの",
      "startSec": 63.30000000000001,
      "endSec": 64.01866666666666,
      "emphasis": []
    },
    {
      "text": "筋力をしっかりと",
      "startSec": 64.01866666666666,
      "endSec": 64.84000000000003,
      "emphasis": []
    },
    {
      "text": "維持していく",
      "startSec": 64.84000000000003,
      "endSec": 65.56,
      "emphasis": []
    },
    {
      "text": "筋トレをしていくという",
      "startSec": 65.70000000000005,
      "endSec": 66.76000000000005,
      "emphasis": []
    },
    {
      "text": "ことですねは",
      "startSec": 66.76000000000005,
      "endSec": 67.5152941176471,
      "emphasis": []
    },
    {
      "text": "まあすごく重要な要素の",
      "startSec": 67.5152941176471,
      "endSec": 68.90000000000003,
      "emphasis": []
    },
    {
      "text": "一つになります",
      "startSec": 68.90000000000003,
      "endSec": 70.56,
      "emphasis": [
        {
          "start": 0,
          "end": 6,
          "label": "重要"
        }
      ]
    }
  ],
  "cameraSwitches": [
    {
      "atSec": 0,

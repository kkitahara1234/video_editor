{
  "shortId": "short-007",
  "title": "健康管理の重要性",
  "startSec": 2001.42,
  "endSec": 2168.86,
  "telops": [
    {
      "text": "そもそも今は",
      "startSec": 0,
      "endSec": 1.033333333333303,
      "emphasis": []
    },
    {
      "text": "異常値はなかったけれども",
      "startSec": 1.033333333333303,
      "endSec": 3.099999999999909,
      "emphasis": []
    },
    {
      "text": "これは同世代と",
      "startSec": 3.099999999999909,
      "endSec": 4.839999999999918,
      "emphasis": []
    },
    {
      "text": "比べてどうだとか過去の",
      "startSec": 4.839999999999918,
      "endSec": 6.129999999999882,
      "emphasis": []
    },
    {
      "text": "自分と比べてどうだとか",
      "startSec": 6.129999999999882,
      "endSec": 7.419999999999845,
      "emphasis": []
    },
    {
      "text": "このまま行くと今後",
      "startSec": 7.779999999999973,
      "endSec": 8.628571428571377,
      "emphasis": []
    },
    {
      "text": "将来的にこういうリスクが",
      "startSec": 8.628571428571377,
      "endSec": 9.759999999999991,
      "emphasis": []
    },
    {
      "text": "出てくるだろうという",
      "startSec": 9.759999999999991,
      "endSec": 10.740000000000009,
      "emphasis": []
    },
    {
      "text": "ことをですね",
      "startSec": 10.740000000000009,
      "endSec": 11.728749999999991,
      "emphasis": []
    },
    {
      "text": "いろんな分析をして",
      "startSec": 11.728749999999991,
      "endSec": 13,
      "emphasis": []
    },
    {
      "text": "それをもとにですね",
      "startSec": 13,
      "endSec": 14.367999999999938,
      "emphasis": []
    },
    {
      "text": "自分にあった",
      "startSec": 14.367999999999938,
      "endSec": 15.279999999999973,
      "emphasis": []
    },
    {
      "text": "健康戦略を",
      "startSec": 15.279999999999973,
      "endSec": 15.829999999999927,
      "emphasis": []
    },
    {
      "text": "立てて健康を守りに行く",
      "startSec": 15.829999999999927,
      "endSec": 17.039999999999964,
      "emphasis": []
    },
    {
      "text": "というそんなことを",
      "startSec": 17.199999999999818,
      "endSec": 18.480000000000018,
      "emphasis": []
    },
    {
      "text": "やらせていただいています",
      "startSec": 18.480000000000018,
      "endSec": 20.039999999999964,
      "emphasis": []
    },
    {
      "text": "よくですね",
      "startSec": 20.039999999999964,
      "endSec": 21.16571428571433,
      "emphasis": []
    },
    {
      "text": "あの僕人間ドックで",
      "startSec": 21.16571428571433,
      "endSec": 22.854285714285652,
      "emphasis": []
    },
    {
      "text": "A判定だから",
      "startSec": 22.854285714285652,
      "endSec": 23.980000000000018,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "A判定"
        }
      ]
    },
    {
      "text": "大丈夫なんですよ",
      "startSec": 23.980000000000018,
      "endSec": 24.899999999999864,
      "emphasis": []
    },
    {
      "text": "みたいにいう方も",
      "startSec": 24.899999999999864,
      "endSec": 26.299999999999955,
      "emphasis": []
    },
    {
      "text": "多いんですけれども",
      "startSec": 26.299999999999955,
      "endSec": 27.799999999999955,
      "emphasis": []
    },
    {
      "text": "そもそも",
      "startSec": 27.799999999999955,
      "endSec": 28.399999999999864,
      "emphasis": []
    },
    {
      "text": "A判定で何なのって",
      "startSec": 28.399999999999864,
      "endSec": 29.27599999999984,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "A判定"
        }
      ]
    },
    {
      "text": "言うとですね",
      "startSec": 29.27599999999984,
      "endSec": 29.8599999999999,
      "emphasis": []
    },
    {
      "text": "今回受けた検査の",
      "startSec": 30.159999999999854,
      "endSec": 31.377777777777737,
      "emphasis": []
    },
    {
      "text": "中においてあなたには",
      "startSec": 31.377777777777737,
      "endSec": 32.899999999999864,
      "emphasis": []
    },
    {
      "text": "異常な所見を",
      "startSec": 32.899999999999864,
      "endSec": 33.584705882352864,
      "emphasis": []
    },
    {
      "text": "見られませんでしたって",
      "startSec": 33.584705882352864,
      "endSec": 34.83999999999992,
      "emphasis": []
    },
    {
      "text": "意味なんですね",
      "startSec": 34.83999999999992,
      "endSec": 36.13999999999987,
      "emphasis": []
    },
    {
      "text": "なんですけれども",
      "startSec": 36.13999999999987,
      "endSec": 37.112307692307695,
      "emphasis": []
    },
    {
      "text": "当たり前の",
      "startSec": 37.112307692307695,
      "endSec": 37.72000000000003,
      "emphasis": []
    },
    {
      "text": "話しますけれども",
      "startSec": 37.72000000000003,
      "endSec": 38.79555555555544,
      "emphasis": []
    },
    {
      "text": "10個の検査を受けて",
      "startSec": 38.79555555555544,
      "endSec": 40.13999999999987,
      "emphasis": []
    },
    {
      "text": "A判定だったのか",
      "startSec": 40.13999999999987,
      "endSec": 41.363999999999805,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "A判定"
        }
      ]
    },
    {
      "text": "100個の検査を受けて",
      "startSec": 41.363999999999805,
      "endSec": 42.8599999999999,
      "emphasis": [
        {
          "start": 0,
          "end": 1,
          "label": "A判定"
        }
      ]
    },
    {
      "text": "A判定だったのか",
      "startSec": 42.8599999999999,
      "endSec": 44.25428571428574,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "A判定"
        }
      ]
    },
    {
      "text": "によって全然",
      "startSec": 44.25428571428574,
      "endSec": 45.299999999999955,
      "emphasis": []
    },
    {
      "text": "制度違いますよね",
      "startSec": 45.299999999999955,
      "endSec": 46.399999999999864,
      "emphasis": []
    },
    {
      "text": "もっとわかりやすい",
      "startSec": 46.79999999999973,
      "endSec": 47.763529411764466,
      "emphasis": []
    },
    {
      "text": "例で言うと例えば",
      "startSec": 47.763529411764466,
      "endSec": 48.61999999999989,
      "emphasis": []
    },
    {
      "text": "受験勉強とか皆さんもね",
      "startSec": 48.61999999999989,
      "endSec": 50.899999999999636,
      "emphasis": []
    },
    {
      "text": "あの高校受験とか大学",
      "startSec": 50.899999999999636,
      "endSec": 52.22999999999956,
      "emphasis": []
    },
    {
      "text": "受験とかされた方",
      "startSec": 52.22999999999956,
      "endSec": 53.179999999999836,
      "emphasis": []
    },
    {
      "text": "多いと思いますけれども",
      "startSec": 53.179999999999836,
      "endSec": 54,
      "emphasis": []
    },
    {
      "text": "そういう",
      "startSec": 54.38000000000011,
      "endSec": 54.894285714285616,
      "emphasis": []
    },
    {
      "text": "時にですねやっぱその",
      "startSec": 54.894285714285616,
      "endSec": 56.179999999999836,
      "emphasis": []
    },
    {
      "text": "学校によって",
      "startSec": 56.179999999999836,
      "endSec": 57.19294117647041,
      "emphasis": []
    },
    {
      "text": "抜けなければいけない",
      "startSec": 57.19294117647041,
      "endSec": 58.63999999999987,
      "emphasis": []
    },
    {
      "text": "科目って違いますよね",
      "startSec": 58.63999999999987,
      "endSec": 59.73999999999978,
      "emphasis": []
    },
    {
      "text": "英語数学だけで受かる",
      "startSec": 59.79999999999973,
      "endSec": 61.5,
      "emphasis": []
    },
    {
      "text": "大学もあればもう",
      "startSec": 61.5,
      "endSec": 62.86000000000013,
      "emphasis": []
    },
    {
      "text": "英語も数学も",
      "startSec": 62.86000000000013,
      "endSec": 63.79599999999982,
      "emphasis": []
    },
    {
      "text": "国語も理科も社会も",
      "startSec": 63.79599999999982,
      "endSec": 65.19999999999982,
      "emphasis": []
    },
    {
      "text": "小論文も",
      "startSec": 65.19999999999982,
      "endSec": 65.51999999999998,
      "emphasis": []
    },
    {
      "text": "やらなきゃいけない",
      "startSec": 65.51999999999998,
      "endSec": 66.23999999999978,
      "emphasis": []
    },
    {
      "text": "みたいな大学も",
      "startSec": 66.23999999999978,
      "endSec": 67.42461538461521,
      "emphasis": []
    },
    {
      "text": "あるわけです",
      "startSec": 67.42461538461521,
      "endSec": 68.44000000000005,
      "emphasis": []
    },
    {
      "text": "でそのどの",
      "startSec": 68.44000000000005,
      "endSec": 69.18615384615396,
      "emphasis": []
    },
    {
      "text": "テストを受けたか",
      "startSec": 69.18615384615396,
      "endSec": 70.38000000000011,
      "emphasis": []
    },
    {
      "text": "によってですね",
      "startSec": 70.38000000000011,
      "endSec": 71.41111111111104,
      "emphasis": []
    },
    {
      "text": "なんて言うんでしょう",
      "startSec": 71.41111111111104,
      "endSec": 72.69999999999982,
      "emphasis": []
    },
    {
      "text": "判定の出方って",
      "startSec": 72.69999999999982,
      "endSec": 73.55999999999995,
      "emphasis": []
    },
    {
      "text": "変わりますよね",
      "startSec": 73.55999999999995,
      "endSec": 74.42000000000007,
      "emphasis": []
    },
    {
      "text": "例えば英語と数学が",
      "startSec": 74.42000000000007,
      "endSec": 75.65882352941162,
      "emphasis": []
    },
    {
      "text": "すごい得意な方が",
      "startSec": 75.65882352941162,
      "endSec": 76.75999999999976,
      "emphasis": []
    },
    {
      "text": "いた時に英語と",
      "startSec": 76.75999999999976,
      "endSec": 77.8882352941173,
      "emphasis": []
    },
    {
      "text": "数学だけの模擬試験を",
      "startSec": 77.8882352941173,
      "endSec": 79.5,
      "emphasis": []
    },
    {
      "text": "受けたらあなたは",
      "startSec": 79.5,
      "endSec": 80.57058823529405,
      "emphasis": []
    },
    {
      "text": "A判定ですって",
      "startSec": 80.57058823529405,
      "endSec": 81.31999999999971,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "A判定"
        }
      ]
    },
    {
      "text": "出ると思うんですね",
      "startSec": 81.31999999999971,
      "endSec": 82.38000000000011,
      "emphasis": []
    },
    {
      "text": "なんですけどじゃあこの",
      "startSec": 82.38000000000011,
      "endSec": 83.65999999999985,
      "emphasis": []
    },
    {
      "text": "6科目全部のですね",
      "startSec": 83.65999999999985,
      "endSec": 85.31333333333305,
      "emphasis": []
    },
    {
      "text": "模擬試験を",
      "startSec": 85.31333333333305,
      "endSec": 86.13999999999987,
      "emphasis": []
    },
    {
      "text": "受けたらどうなるか",
      "startSec": 86.13999999999987,
      "endSec": 87.20045248868746,
      "emphasis": []
    },
    {
      "text": "というと英数は",
      "startSec": 87.20045248868746,
      "endSec": 88,
      "emphasis": []
    },
    {
      "text": "A判定だけれども",
      "startSec": 88,
      "endSec": 89.10933333333332,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "A判定"
        }
      ]
    },
    {
      "text": "結局他の科目が",
      "startSec": 89.10933333333332,
      "endSec": 90.07999999999993,
      "emphasis": []
    },
    {
      "text": "ダメだったので実際には",
      "startSec": 90.07999999999993,
      "endSec": 91.77999999999975,
      "emphasis": []
    },
    {
      "text": "E判定です",
      "startSec": 91.77999999999975,
      "endSec": 92.5738461538458,
      "emphasis": []
    },
    {
      "text": "みたいなことに",
      "startSec": 92.5738461538458,
      "endSec": 93.5,
      "emphasis": []
    },
    {
      "text": "なり得るわけですよ",
      "startSec": 93.5,
      "endSec": 94.40000000000009,
      "emphasis": []
    },
    {
      "text": "当たり前の話ですよね",
      "startSec": 94.40000000000009,
      "endSec": 96.38000000000011,
      "emphasis": []
    },
    {
      "text": "なので検査で",
      "startSec": 96.38000000000011,
      "endSec": 97.46000000000004,
      "emphasis": []
    },
    {
      "text": "A判定というのは",
      "startSec": 97.46000000000004,
      "endSec": 98.40999999999985,
      "emphasis": []
    },
    {
      "text": "全くと言っていい",
      "startSec": 98.40999999999985,
      "endSec": 99.36000000000013,
      "emphasis": []
    },
    {
      "text": "ほど意味がないです",
      "startSec": 99.36000000000013,
      "endSec": 100.65999999999985,
      "emphasis": []
    },
    {
      "text": "あくまで自分が受けるべき",
      "startSec": 100.65999999999985,
      "endSec": 102.65999999999985,
      "emphasis": []
    },
    {
      "text": "検査を",
      "startSec": 102.65999999999985,
      "endSec": 103.13755102040795,
      "emphasis": []
    },
    {
      "text": "しっかり受けられたのか",
      "startSec": 103.13755102040795,
      "endSec": 104.88857142857114,
      "emphasis": []
    },
    {
      "text": "でその範囲に",
      "startSec": 104.88857142857114,
      "endSec": 105.77999999999975,
      "emphasis": []
    },
    {
      "text": "おいて本当に",
      "startSec": 105.77999999999975,
      "endSec": 106.63599999999997,
      "emphasis": []
    },
    {
      "text": "問題がなかったのか",
      "startSec": 106.63599999999997,
      "endSec": 107.92000000000007,
      "emphasis": []
    },
    {
      "text": "あるいは将来的に",
      "startSec": 107.92000000000007,
      "endSec": 109.14666666666653,
      "emphasis": []
    },
    {
      "text": "本当に今リスクがある",
      "startSec": 109.14666666666653,
      "endSec": 110.67999999999984,
      "emphasis": []
    },
    {
      "text": "状態じゃないのか",
      "startSec": 110.67999999999984,
      "endSec": 111.76999999999998,
      "emphasis": []
    },
    {
      "text": "自分に弱み強みは",
      "startSec": 111.76999999999998,
      "endSec": 112.86000000000013,
      "emphasis": []
    },
    {
      "text": "ないのか",
      "startSec": 112.86000000000013,
      "endSec": 113.30285714285719,
      "emphasis": []
    },
    {
      "text": "っていうことですね",
      "startSec": 113.30285714285719,
      "endSec": 114.09999999999991,
      "emphasis": []
    },
    {
      "text": "しっかり分析してこそ",
      "startSec": 114.09999999999991,
      "endSec": 115.54761904761881,
      "emphasis": []
    },
    {
      "text": "検査には意味があるので",
      "startSec": 115.54761904761881,
      "endSec": 117.13999999999987,
      "emphasis": []
    },
    {
      "text": "A判定とかですねなんとか",
      "startSec": 117.53999999999996,
      "endSec": 119.0929411764705,
      "emphasis": []
    },
    {
      "text": "判定とかで",
      "startSec": 119.0929411764705,
      "endSec": 119.73999999999978,
      "emphasis": []
    },
    {
      "text": "一喜一憂",
      "startSec": 119.73999999999978,
      "endSec": 120.26307692307682,
      "emphasis": []
    },
    {
      "text": "しないということがすごく",
      "startSec": 120.26307692307682,
      "endSec": 121.75266233766251,
      "emphasis": []
    },
    {
      "text": "大事ですしやっぱりこう",
      "startSec": 121.75266233766251,
      "endSec": 122.89909090909077,
      "emphasis": []
    },
    {
      "text": "データをですね",
      "startSec": 122.89909090909077,
      "endSec": 123.57999999999993,
      "emphasis": []
    },
    {
      "text": "プロと一緒に",
      "startSec": 123.57999999999993,
      "endSec": 124.34000000000015,
      "emphasis": []
    },
    {
      "text": "紐解いていって今の",
      "startSec": 124.34000000000015,
      "endSec": 125.48000000000002,
      "emphasis": []
    },
    {
      "text": "自分の体の",
      "startSec": 125.48000000000002,
      "endSec": 126.25692307692316,
      "emphasis": []
    },
    {
      "text": "本当の課題は何か",
      "startSec": 126.25692307692316,
      "endSec": 127.5,
      "emphasis": []
    },
    {
      "text": "将来的に",
      "startSec": 127.5,
      "endSec": 127.92461538461521,
      "emphasis": []
    },
    {
      "text": "抱えているリスクは",
      "startSec": 127.92461538461521,
      "endSec": 128.8800000000001,
      "emphasis": []
    },
    {
      "text": "何なのか",
      "startSec": 128.8800000000001,
      "endSec": 129.5237500000003,
      "emphasis": []
    },
    {
      "text": "それを防いでいくために",
      "startSec": 129.5237500000003,
      "endSec": 130.94000000000005,
      "emphasis": []
    },
    {
      "text": "どんな検査を今後",
      "startSec": 130.94000000000005,
      "endSec": 131.8800000000001,
      "emphasis": []
    },
    {
      "text": "受けていくべきで",
      "startSec": 131.8800000000001,
      "endSec": 132.8199999999997,
      "emphasis": []
    },
    {
      "text": "どういう食事運動を",
      "startSec": 132.8199999999997,
      "endSec": 133.84375,
      "emphasis": []
    },
    {
      "text": "してどの数値を",
      "startSec": 133.84375,
      "endSec": 134.63999999999987,
      "emphasis": []
    },
    {
      "text": "どれぐらいの数値に",
      "startSec": 134.63999999999987,
      "endSec": 135.57999999999993,
      "emphasis": []
    },
    {
      "text": "コントロール",
      "startSec": 135.57999999999993,
      "endSec": 136.14800000000014,
      "emphasis": []
    },
    {
      "text": "していくべきなのか",
      "startSec": 136.14800000000014,
      "endSec": 137,
      "emphasis": []
    },
    {
      "text": "こういうことですね",
      "startSec": 137,
      "endSec": 138.04399999999987,
      "emphasis": []
    },
    {
      "text": "考えることに",
      "startSec": 138.04399999999987,
      "endSec": 138.73999999999978,
      "emphasis": []
    },
    {
      "text": "意味があるということです",
      "startSec": 138.73999999999978,
      "endSec": 140.53999999999996,
      "emphasis": []
    },
    {
      "text": "模擬試験もですね",
      "startSec": 140.53999999999996,
      "endSec": 141.65999999999985,
      "emphasis": []
    },
    {
      "text": "あのやった",
      "startSec": 141.65999999999985,
      "endSec": 142.36000000000013,
      "emphasis": []
    },
    {
      "text": "A判定だったでってあの",
      "startSec": 142.36000000000013,
      "endSec": 144.84000000000015,
      "emphasis": []
    },
    {
      "text": "何にもですね",
      "startSec": 144.84000000000015,
      "endSec": 145.58399999999983,
      "emphasis": []
    },
    {
      "text": "振り返らなかったら",
      "startSec": 145.58399999999983,
      "endSec": 146.69999999999982,
      "emphasis": []
    },
    {
      "text": "みんなに",
      "startSec": 146.69999999999982,
      "endSec": 147.36000000000013,
      "emphasis": []
    },
    {
      "text": "抜かれていっちゃいますし",
      "startSec": 147.36000000000013,
      "endSec": 148.65999999999985,
      "emphasis": []
    },
    {

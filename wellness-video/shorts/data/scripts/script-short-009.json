{
  "shortId": "short-009",
  "title": "健康データの重要性",
  "startSec": 2860.7,
  "endSec": 3050.1,
  "telops": [
    {
      "text": "Wellness",
      "startSec": 0.01999999999998181,
      "endSec": 0.8035294117648846,
      "emphasis": []
    },
    {
      "text": "Appではですね",
      "startSec": 0.8035294117648846,
      "endSec": 1.5,
      "emphasis": []
    },
    {
      "text": "まず一つの特徴は",
      "startSec": 1.5,
      "endSec": 2.6555555555555657,
      "emphasis": []
    },
    {
      "text": "この統合医療データを",
      "startSec": 2.6555555555555657,
      "endSec": 4.100000000000364,
      "emphasis": []
    },
    {
      "text": "管理できるということです",
      "startSec": 4.100000000000364,
      "endSec": 5.580000000000382,
      "emphasis": []
    },
    {
      "text": "要はですね",
      "startSec": 5.580000000000382,
      "endSec": 6.656923076923249,
      "emphasis": []
    },
    {
      "text": "全ての自分の体に",
      "startSec": 6.656923076923249,
      "endSec": 8.38000000000011,
      "emphasis": []
    },
    {
      "text": "関する情報をこの",
      "startSec": 8.38000000000011,
      "endSec": 9.508888888889032,
      "emphasis": []
    },
    {
      "text": "アプリケーション内で",
      "startSec": 9.508888888889032,
      "endSec": 10.920000000000073,
      "emphasis": []
    },
    {
      "text": "一括で管理できます",
      "startSec": 10.920000000000073,
      "endSec": 11.720000000000255,
      "emphasis": []
    },
    {
      "text": "なので食事のデータ",
      "startSec": 12.480000000000018,
      "endSec": 13.8100000000004,
      "emphasis": []
    },
    {
      "text": "運動のデータ睡眠の",
      "startSec": 13.8100000000004,
      "endSec": 15.140000000000327,
      "emphasis": []
    },
    {
      "text": "データみたいなですね",
      "startSec": 15.140000000000327,
      "endSec": 16.10923076923109,
      "emphasis": []
    },
    {
      "text": "日々の",
      "startSec": 16.10923076923109,
      "endSec": 16.40000000000009,
      "emphasis": []
    },
    {
      "text": "ライフスタイルのデータも",
      "startSec": 16.40000000000009,
      "endSec": 17.602499999999964,
      "emphasis": []
    },
    {
      "text": "ここにすべて統合",
      "startSec": 17.602499999999964,
      "endSec": 18.559999999999945,
      "emphasis": [
        {
          "start": 3,
          "end": 6,
          "label": "すべて"
        }
      ]
    },
    {
      "text": "することができますし",
      "startSec": 18.559999999999945,
      "endSec": 19.920000000000073,
      "emphasis": []
    },
    {
      "text": "もちろん我々の",
      "startSec": 19.920000000000073,
      "endSec": 20.713333333333594,
      "emphasis": []
    },
    {
      "text": "サービスを通じて",
      "startSec": 20.713333333333594,
      "endSec": 21.620000000000346,
      "emphasis": []
    },
    {
      "text": "受けていた",
      "startSec": 21.620000000000346,
      "endSec": 22.09857142857163,
      "emphasis": []
    },
    {
      "text": "だいた人間ドックのデータ",
      "startSec": 22.09857142857163,
      "endSec": 23.519999999999982,
      "emphasis": []
    },
    {
      "text": "定期的な採血",
      "startSec": 23.519999999999982,
      "endSec": 24.360000000000127,
      "emphasis": []
    },
    {
      "text": "検査のデータも",
      "startSec": 24.360000000000127,
      "endSec": 25.340000000000146,
      "emphasis": []
    },
    {
      "text": "入りますし",
      "startSec": 25.340000000000146,
      "endSec": 26.700000000000273,
      "emphasis": []
    },
    {
      "text": "過去にですね",
      "startSec": 26.700000000000273,
      "endSec": 27.4050000000002,
      "emphasis": []
    },
    {
      "text": "皆さんが今受けてきた",
      "startSec": 27.4050000000002,
      "endSec": 28.580000000000382,
      "emphasis": []
    },
    {
      "text": "検査のデータも",
      "startSec": 28.580000000000382,
      "endSec": 29.362352941176596,
      "emphasis": []
    },
    {
      "text": "あればですねそういう",
      "startSec": 29.362352941176596,
      "endSec": 30.480000000000018,
      "emphasis": []
    },
    {
      "text": "ものもすべて",
      "startSec": 30.480000000000018,
      "endSec": 31.04777777777781,
      "emphasis": [
        {
          "start": 3,
          "end": 6,
          "label": "すべて"
        }
      ]
    },
    {
      "text": "インプット",
      "startSec": 31.04777777777781,
      "endSec": 31.43372549019614,
      "emphasis": []
    },
    {
      "text": "できるようになっています",
      "startSec": 31.43372549019614,
      "endSec": 32.36000000000013,
      "emphasis": []
    },
    {
      "text": "この健康データっていう",
      "startSec": 33.220000000000255,
      "endSec": 34.29555555555544,
      "emphasis": [
        {
          "start": 2,
          "end": 7,
          "label": "健康データ"
        }
      ]
    },
    {
      "text": "のはですねもう",
      "startSec": 34.29555555555544,
      "endSec": 34.98000000000002,
      "emphasis": []
    },
    {
      "text": "本当に過去に",
      "startSec": 34.98000000000002,
      "endSec": 35.91600000000017,
      "emphasis": []
    },
    {
      "text": "はね戻れませんから",
      "startSec": 35.91600000000017,
      "endSec": 37.320000000000164,
      "emphasis": []
    },
    {
      "text": "過去のデータとかも",
      "startSec": 37.320000000000164,
      "endSec": 38.600000000000364,
      "emphasis": []
    },
    {
      "text": "含めてですね非常に重要な",
      "startSec": 38.600000000000364,
      "endSec": 40.440000000000055,
      "emphasis": [
        {
          "start": 9,
          "end": 12,
          "label": "重要な"
        }
      ]
    },
    {
      "text": "資産なんですね",
      "startSec": 40.440000000000055,
      "endSec": 40.960000000000036,
      "emphasis": []
    },
    {
      "text": "健康資産を",
      "startSec": 41.600000000000364,
      "endSec": 42.30000000000018,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "健康資産"
        }
      ]
    },
    {
      "text": "守っていく上で自分の体が",
      "startSec": 42.30000000000018,
      "endSec": 43.98000000000002,
      "emphasis": []
    },
    {
      "text": "どう変化してきたのか",
      "startSec": 43.98000000000002,
      "endSec": 45.02705882352939,
      "emphasis": []
    },
    {
      "text": "っていう情報は",
      "startSec": 45.02705882352939,
      "endSec": 45.76000000000022,
      "emphasis": []
    },
    {
      "text": "すごく大事ですし",
      "startSec": 45.76000000000022,
      "endSec": 47.36000000000013,
      "emphasis": []
    },
    {
      "text": "自分の体が全体としてど",
      "startSec": 47.36000000000013,
      "endSec": 48.52416666666659,
      "emphasis": []
    },
    {
      "text": "うなっているか",
      "startSec": 48.52416666666659,
      "endSec": 49.26499999999987,
      "emphasis": []
    },
    {
      "text": "ということを",
      "startSec": 49.26499999999987,
      "endSec": 49.90000000000009,
      "emphasis": []
    },
    {
      "text": "考えるということが",
      "startSec": 49.90000000000009,
      "endSec": 50.88000000000011,
      "emphasis": []
    },
    {
      "text": "ものすごく大事なんですが",
      "startSec": 50.88000000000011,
      "endSec": 52.608000000000175,
      "emphasis": []
    },
    {
      "text": "基本的な世の中の",
      "startSec": 52.608000000000175,
      "endSec": 53.76000000000022,
      "emphasis": []
    },
    {
      "text": "健康アプリとかだと例えば",
      "startSec": 53.76000000000022,
      "endSec": 55.38000000000011,
      "emphasis": []
    },
    {
      "text": "運動データだけに対して",
      "startSec": 55.38000000000011,
      "endSec": 56.77764705882373,
      "emphasis": []
    },
    {
      "text": "こうした方が",
      "startSec": 56.77764705882373,
      "endSec": 57.539999999999964,
      "emphasis": []
    },
    {
      "text": "いいですよとか",
      "startSec": 57.539999999999964,
      "endSec": 58.5600000000004,
      "emphasis": []
    },
    {
      "text": "人間ドックの",
      "startSec": 58.88000000000011,
      "endSec": 59.54399999999987,
      "emphasis": []
    },
    {
      "text": "データだけに対して",
      "startSec": 59.54399999999987,
      "endSec": 60.539999999999964,
      "emphasis": []
    },
    {
      "text": "こうした方が",
      "startSec": 60.539999999999964,
      "endSec": 61.12153846153842,
      "emphasis": []
    },
    {
      "text": "いいですよって",
      "startSec": 61.12153846153842,
      "endSec": 61.80000000000018,
      "emphasis": []
    },
    {
      "text": "いうですね",
      "startSec": 61.80000000000018,
      "endSec": 62.40857142857158,
      "emphasis": []
    },
    {
      "text": "点のアドバイスになっ",
      "startSec": 62.40857142857158,
      "endSec": 63.21529411764732,
      "emphasis": []
    },
    {
      "text": "ちゃうんですね",
      "startSec": 63.21529411764732,
      "endSec": 63.7800000000002,
      "emphasis": []
    },
    {
      "text": "これを我々の",
      "startSec": 63.7800000000002,
      "endSec": 64.404,
      "emphasis": []
    },
    {
      "text": "アプリケーション",
      "startSec": 64.404,
      "endSec": 65.23599999999988,
      "emphasis": []
    },
    {
      "text": "内ではですね",
      "startSec": 65.23599999999988,
      "endSec": 65.86000000000013,
      "emphasis": []
    },
    {
      "text": "全てのデータを",
      "startSec": 65.86000000000013,
      "endSec": 67.19538461538468,
      "emphasis": []
    },
    {
      "text": "統合して常に",
      "startSec": 67.19538461538468,
      "endSec": 68.34000000000015,
      "emphasis": []
    },
    {
      "text": "タイムリーに",
      "startSec": 68.34000000000015,
      "endSec": 68.82124999999996,
      "emphasis": []
    },
    {
      "text": "チェックを",
      "startSec": 68.82124999999996,
      "endSec": 69.24164835164856,
      "emphasis": []
    },
    {
      "text": "することができて",
      "startSec": 69.24164835164856,
      "endSec": 69.91428571428605,
      "emphasis": []
    },
    {
      "text": "パーソナルドクターと",
      "startSec": 69.91428571428605,
      "endSec": 71.10000000000036,
      "emphasis": [
        {
          "start": 0,
          "end": 9,
          "label": "パーソナルドクター"
        }
      ]
    },
    {
      "text": "定期的な面談を通じて",
      "startSec": 71.10000000000036,
      "endSec": 72.17692307692323,
      "emphasis": []
    },
    {
      "text": "ですね実際に自分の体が",
      "startSec": 72.17692307692323,
      "endSec": 73.33764705882368,
      "emphasis": []
    },
    {
      "text": "どういうトレンドで",
      "startSec": 73.33764705882368,
      "endSec": 74.2800000000002,
      "emphasis": []
    },
    {
      "text": "変化をしていて",
      "startSec": 74.2800000000002,
      "endSec": 75.20444444444456,
      "emphasis": []
    },
    {
      "text": "今後どういうリスクが",
      "startSec": 75.20444444444456,
      "endSec": 76.36000000000013,
      "emphasis": []
    },
    {
      "text": "想定されてそれを",
      "startSec": 76.36000000000013,
      "endSec": 77.25599999999986,
      "emphasis": []
    },
    {
      "text": "防ぐために何を",
      "startSec": 77.25599999999986,
      "endSec": 78.03999999999996,
      "emphasis": []
    },
    {
      "text": "すべきなのかということを",
      "startSec": 78.03999999999996,
      "endSec": 79.38000000000011,
      "emphasis": []
    },
    {
      "text": "ちゃんとデータを",
      "startSec": 79.38000000000011,
      "endSec": 79.95411764705887,
      "emphasis": []
    },
    {
      "text": "もとに判断していく",
      "startSec": 79.95411764705887,
      "endSec": 80.60000000000036,
      "emphasis": []
    },
    {
      "text": "ということができるように",
      "startSec": 80.60000000000036,
      "endSec": 81.46000000000004,
      "emphasis": []
    },
    {
      "text": "なっています",
      "startSec": 81.46000000000004,
      "endSec": 82.71125000000029,
      "emphasis": []
    },
    {
      "text": "なのでですね一部の",
      "startSec": 82.71125000000029,
      "endSec": 84.32000000000016,
      "emphasis": []
    },
    {
      "text": "データだけで",
      "startSec": 84.32000000000016,
      "endSec": 84.98000000000047,
      "emphasis": []
    },
    {
      "text": "はなくて自分の健康に",
      "startSec": 84.98000000000047,
      "endSec": 86.08000000000038,
      "emphasis": []
    },
    {
      "text": "関するあらゆる",
      "startSec": 86.08000000000038,
      "endSec": 86.93000000000029,
      "emphasis": []
    },
    {
      "text": "情報を連携して",
      "startSec": 86.93000000000029,
      "endSec": 87.7800000000002,
      "emphasis": []
    },
    {
      "text": "統合できる",
      "startSec": 87.7800000000002,
      "endSec": 88.36000000000013,
      "emphasis": []
    },
    {
      "text": "かつデータは",
      "startSec": 88.36000000000013,
      "endSec": 89.24000000000024,
      "emphasis": []
    },
    {
      "text": "あるだけでは意味が",
      "startSec": 89.24000000000024,
      "endSec": 90.5600000000004,
      "emphasis": []
    },
    {
      "text": "ありませんから",
      "startSec": 90.5600000000004,
      "endSec": 91.4960000000001,
      "emphasis": []
    },
    {
      "text": "実際にそのデータをですね",
      "startSec": 91.4960000000001,
      "endSec": 92.90000000000009,
      "emphasis": []
    },
    {
      "text": "一緒に判断してくれるこの",
      "startSec": 92.90000000000009,
      "endSec": 94.16000000000031,
      "emphasis": []
    },
    {
      "text": "パーソナルドクター",
      "startSec": 94.16000000000031,
      "endSec": 94.88900000000012,
      "emphasis": [
        {
          "start": 0,
          "end": 9,
          "label": "パーソナルドクター"
        }
      ]
    },
    {
      "text": "というドクターがついて",
      "startSec": 94.88900000000012,
      "endSec": 95.7800000000002,
      "emphasis": []
    },
    {
      "text": "データをもとに",
      "startSec": 96.01999999999998,
      "endSec": 97.02153846153851,
      "emphasis": []
    },
    {
      "text": "健康の戦略を",
      "startSec": 97.02153846153851,
      "endSec": 97.88000000000011,
      "emphasis": []
    },
    {
      "text": "アップデート",
      "startSec": 97.88000000000011,
      "endSec": 98.26250000000027,
      "emphasis": []
    },
    {
      "text": "していくことができる",
      "startSec": 98.26250000000027,
      "endSec": 98.90000000000009,
      "emphasis": []
    },
    {
      "text": "というのが",
      "startSec": 98.90000000000009,
      "endSec": 99.88571428571413,
      "emphasis": []
    },
    {
      "text": "特徴になっています",
      "startSec": 99.88571428571413,
      "endSec": 101.65999999999985,
      "emphasis": []
    },
    {
      "text": "あとはですね我々この",
      "startSec": 101.65999999999985,
      "endSec": 103.5,
      "emphasis": []
    },
    {
      "text": "PHR20って",
      "startSec": 103.5,
      "endSec": 104.15578947368431,
      "emphasis": []
    },
    {
      "text": "言っているんですけれども",
      "startSec": 104.15578947368431,
      "endSec": 105.2800000000002,
      "emphasis": []
    },
    {
      "text": "この",
      "startSec": 105.2800000000002,
      "endSec": 105.54444444444471,
      "emphasis": []
    },
    {
      "text": "パーソナルヘルスケアレコード",
      "startSec": 105.54444444444471,
      "endSec": 107.3955555555558,
      "emphasis": []
    },
    {
      "text": "上であらゆる課題が",
      "startSec": 107.3955555555558,
      "endSec": 108.78823529411784,
      "emphasis": []
    },
    {
      "text": "解決するということを",
      "startSec": 108.78823529411784,
      "endSec": 110.40000000000009,
      "emphasis": []
    },
    {
      "text": "目指しています",
      "startSec": 110.40000000000009,
      "endSec": 111.43000000000029,
      "emphasis": []
    },
    {
      "text": "例えばですねこの",
      "startSec": 111.43000000000029,
      "endSec": 112.46000000000004,
      "emphasis": []
    },
    {
      "text": "アプリ内で実際に自分の",
      "startSec": 112.46000000000004,
      "endSec": 114.40000000000009,
      "emphasis": []
    },
    {
      "text": "パーソナルドクター",
      "startSec": 114.40000000000009,
      "endSec": 115,
      "emphasis": []
    },
    {
      "text": "との相談というのもできる",
      "startSec": 115,
      "endSec": 115.80400000000054,
      "emphasis": []
    },
    {
      "text": "ようになっているんですね",
      "startSec": 115.80400000000054,
      "endSec": 116.62000000000035,
      "emphasis": []
    },
    {
      "text": "本当に友達とLINEを",
      "startSec": 116.62000000000035,
      "endSec": 117.80000000000018,
      "emphasis": []
    },
    {
      "text": "するような感じでですね",
      "startSec": 117.80000000000018,
      "endSec": 118.98555555555595,
      "emphasis": []
    },
    {
      "text": "今日ここ調子が",
      "startSec": 118.98555555555595,
      "endSec": 119.74000000000024,
      "emphasis": []
    },
    {
      "text": "悪いよとか",
      "startSec": 119.74000000000024,
      "endSec": 120.26000000000022,
      "emphasis": []
    },
    {
      "text": "このサプリ会食で",
      "startSec": 120.51999999999998,
      "endSec": 121.50823529411764,
      "emphasis": []
    },
    {
      "text": "勧められたんだけど",
      "startSec": 121.50823529411764,
      "endSec": 122.62000000000035,
      "emphasis": []
    },
    {
      "text": "これ自分にも合っていると",
      "startSec": 122.62000000000035,
      "endSec": 124.24000000000024,
      "emphasis": []
    },
    {
      "text": "思いますかとかですね",
      "startSec": 124.24000000000024,
      "endSec": 125.26235294117669,
      "emphasis": []
    },
    {
      "text": "まあそういう",
      "startSec": 125.26235294117669,
      "endSec": 125.82000000000016,
      "emphasis": []
    },
    {
      "text": "相談を気軽にできるように",
      "startSec": 125.82000000000016,
      "endSec": 126.82000000000016,
      "emphasis": []
    },
    {
      "text": "なっていましてそして",
      "startSec": 126.82000000000016,
      "endSec": 128.00947368421066,
      "emphasis": []
    },
    {
      "text": "その相談をしたログ",
      "startSec": 128.00947368421066,
      "endSec": 129.08000000000038,
      "emphasis": []
    },
    {
      "text": "実際に自分が",
      "startSec": 129.08000000000038,
      "endSec": 129.9600000000005,
      "emphasis": []
    },
    {
      "text": "いつどういう症状を",
      "startSec": 129.9600000000005,
      "endSec": 131.2800000000002,
      "emphasis": []
    },
    {
      "text": "抱えていたかっていうログ",
      "startSec": 131.2800000000002,
      "endSec": 133.05411764705923,
      "emphasis": []
    },
    {
      "text": "こういう",
      "startSec": 133.05411764705923,
      "endSec": 133.60000000000036,
      "emphasis": []
    },
    {
      "text": "相談のデータというのも",
      "startSec": 133.60000000000036,
      "endSec": 134.3800000000001,
      "emphasis": []
    },
    {
      "text": "すべて記録として",
      "startSec": 134.3800000000001,
      "endSec": 135.03684210526308,
      "emphasis": []
    },
    {
      "text": "残るようになっています",
      "startSec": 135.03684210526308,
      "endSec": 135.94000000000005,
      "emphasis": []
    },
    {
      "text": "なのでただ検査を",
      "startSec": 136.64000000000033,
      "endSec": 137.86352941176483,
      "emphasis": []
    },
    {

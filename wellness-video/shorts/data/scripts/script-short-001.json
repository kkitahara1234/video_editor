{
  "shortId": "short-001",
  "title": "医療アクセスの最適化",
  "startSec": 2315.2,
  "endSec": 2403.82,
  "telops": [
    {
      "text": "戦略的予防医療",
      "startSec": 0.03999999999996362,
      "endSec": 1.4200000000000728,
      "emphasis": [
        {
          "start": 0,
          "end": 7,
          "label": "戦略的予防医療"
        }
      ]
    },
    {
      "text": "というものです",
      "startSec": 1.4200000000000728,
      "endSec": 2.800000000000182,
      "emphasis": []
    },
    {
      "text": "で2つ目の価値はですね",
      "startSec": 2.800000000000182,
      "endSec": 4.539047619047778,
      "emphasis": []
    },
    {
      "text": "医療アクセシビリティ",
      "startSec": 4.539047619047778,
      "endSec": 6.120000000000346,
      "emphasis": [
        {
          "start": 0,
          "end": 10,
          "label": "医療アクセシビリティ"
        }
      ]
    },
    {
      "text": "の最適化っていうふうに",
      "startSec": 6.120000000000346,
      "endSec": 7.480000000000018,
      "emphasis": []
    },
    {
      "text": "言っているんですけれども",
      "startSec": 7.480000000000018,
      "endSec": 8.953333333333376,
      "emphasis": []
    },
    {
      "text": "まあ",
      "startSec": 8.953333333333376,
      "endSec": 9.180000000000291,
      "emphasis": []
    },
    {
      "text": "今皆さんがですねちょっと",
      "startSec": 9.180000000000291,
      "endSec": 10.5600000000004,
      "emphasis": []
    },
    {
      "text": "体調悪いなって",
      "startSec": 10.5600000000004,
      "endSec": 11.610000000000127,
      "emphasis": []
    },
    {
      "text": "思うと病院をですね",
      "startSec": 11.610000000000127,
      "endSec": 12.960000000000036,
      "emphasis": []
    },
    {
      "text": "Google",
      "startSec": 12.960000000000036,
      "endSec": 13.644444444444616,
      "emphasis": [
        {
          "start": 0,
          "end": 6,
          "label": "Google"
        }
      ]
    },
    {
      "text": "とかいろんなサービスで",
      "startSec": 13.644444444444616,
      "endSec": 14.720000000000255,
      "emphasis": []
    },
    {
      "text": "検索をして実際に予約を",
      "startSec": 14.720000000000255,
      "endSec": 17,
      "emphasis": []
    },
    {
      "text": "とってですね",
      "startSec": 17,
      "endSec": 18.054117647058774,
      "emphasis": []
    },
    {
      "text": "で行って予約",
      "startSec": 18.054117647058774,
      "endSec": 18.913725490196157,
      "emphasis": []
    },
    {
      "text": "してたはずなんだけど何分",
      "startSec": 18.913725490196157,
      "endSec": 20.632941176470922,
      "emphasis": []
    },
    {
      "text": "何時間と待たされて",
      "startSec": 20.632941176470922,
      "endSec": 21.840000000000146,
      "emphasis": []
    },
    {
      "text": "でやっと辿り",
      "startSec": 21.840000000000146,
      "endSec": 22.986249999999927,
      "emphasis": []
    },
    {
      "text": "着けたけれども結局",
      "startSec": 22.986249999999927,
      "endSec": 24.460000000000036,
      "emphasis": []
    },
    {
      "text": "3分でじゃあ",
      "startSec": 24.460000000000036,
      "endSec": 25.082499999999982,
      "emphasis": []
    },
    {
      "text": "これだったらこういう",
      "startSec": 25.082499999999982,
      "endSec": 26.120000000000346,
      "emphasis": []
    },
    {
      "text": "薬出すねで終わって",
      "startSec": 26.120000000000346,
      "endSec": 27.039999999999964,
      "emphasis": []
    },
    {
      "text": "しまうみたいなことが",
      "startSec": 27.039999999999964,
      "endSec": 28.093333333333703,
      "emphasis": []
    },
    {
      "text": "ですねまあ",
      "startSec": 28.093333333333703,
      "endSec": 28.620000000000346,
      "emphasis": []
    },
    {
      "text": "今世の中の医療で",
      "startSec": 28.620000000000346,
      "endSec": 29.54571428571444,
      "emphasis": []
    },
    {
      "text": "は残念ながら",
      "startSec": 29.54571428571444,
      "endSec": 30.240000000000236,
      "emphasis": []
    },
    {
      "text": "残っているんですが",
      "startSec": 30.240000000000236,
      "endSec": 31.360000000000127,
      "emphasis": []
    },
    {
      "text": "こういう体験を",
      "startSec": 31.360000000000127,
      "endSec": 32.30000000000018,
      "emphasis": []
    },
    {
      "text": "するとですね",
      "startSec": 32.30000000000018,
      "endSec": 33.14000000000033,
      "emphasis": []
    },
    {
      "text": "お忙しい人たちほど病院に",
      "startSec": 33.14000000000033,
      "endSec": 34.820000000000164,
      "emphasis": []
    },
    {
      "text": "行かなくなるんですね",
      "startSec": 34.820000000000164,
      "endSec": 36.407142857142844,
      "emphasis": []
    },
    {
      "text": "結果的にですね",
      "startSec": 36.407142857142844,
      "endSec": 37.277500000000146,
      "emphasis": []
    },
    {
      "text": "あのちょっとおかしいな",
      "startSec": 37.277500000000146,
      "endSec": 38.45214285714292,
      "emphasis": []
    },
    {
      "text": "と思っていてもですね",
      "startSec": 38.45214285714292,
      "endSec": 39.51999999999998,
      "emphasis": []
    },
    {
      "text": "いやでも時間もないし",
      "startSec": 39.51999999999998,
      "endSec": 40.60750000000007,
      "emphasis": []
    },
    {
      "text": "打ち合わせも",
      "startSec": 40.60750000000007,
      "endSec": 41.26000000000022,
      "emphasis": []
    },
    {
      "text": "いっぱいあるし",
      "startSec": 41.26000000000022,
      "endSec": 42.26000000000022,
      "emphasis": []
    },
    {
      "text": "明日も会食だし",
      "startSec": 42.26000000000022,
      "endSec": 43.26000000000022,
      "emphasis": []
    },
    {
      "text": "もう行く時間作れないって",
      "startSec": 43.26000000000022,
      "endSec": 44.87454545454557,
      "emphasis": []
    },
    {
      "text": "なってですね結果的に",
      "startSec": 44.87454545454557,
      "endSec": 46.220000000000255,
      "emphasis": []
    },
    {
      "text": "バタッと",
      "startSec": 46.220000000000255,
      "endSec": 46.717142857143244,
      "emphasis": []
    },
    {
      "text": "倒れて周りが救急車を",
      "startSec": 46.717142857143244,
      "endSec": 47.960000000000036,
      "emphasis": []
    },
    {
      "text": "呼ぶって",
      "startSec": 47.960000000000036,
      "endSec": 48.220000000000255,
      "emphasis": []
    },
    {
      "text": "いうようなですねことも",
      "startSec": 48.220000000000255,
      "endSec": 49.276000000000295,
      "emphasis": []
    },
    {
      "text": "たくさん",
      "startSec": 49.276000000000295,
      "endSec": 49.66000000000031,
      "emphasis": []
    },
    {
      "text": "起きています",
      "startSec": 49.66000000000031,
      "endSec": 50.433333333333394,
      "emphasis": []
    },
    {
      "text": "こういうのを",
      "startSec": 50.433333333333394,
      "endSec": 51.09619047619071,
      "emphasis": []
    },
    {
      "text": "防ぐためにですね",
      "startSec": 51.09619047619071,
      "endSec": 51.98000000000002,
      "emphasis": []
    },
    {
      "text": "365日ですねもう友達と",
      "startSec": 51.98000000000002,
      "endSec": 55.14000000000033,
      "emphasis": []
    },
    {
      "text": "連絡を取るような感覚で",
      "startSec": 55.14000000000033,
      "endSec": 56.47466666666696,
      "emphasis": []
    },
    {
      "text": "いつでも",
      "startSec": 56.47466666666696,
      "endSec": 56.960000000000036,
      "emphasis": []
    },
    {
      "text": "チャットで",
      "startSec": 56.960000000000036,
      "endSec": 57.46555555555551,
      "emphasis": []
    },
    {
      "text": "コミュニケーション",
      "startSec": 57.46555555555551,
      "endSec": 58.37555555555582,
      "emphasis": []
    },
    {
      "text": "をできる",
      "startSec": 58.37555555555582,
      "endSec": 58.7800000000002,
      "emphasis": []
    },
    {
      "text": "パーソナルドクター",
      "startSec": 58.7800000000002,
      "endSec": 59.73624999999993,
      "emphasis": [
        {
          "start": 0,
          "end": 9,
          "label": "パーソナルドクター"
        }
      ]
    },
    {
      "text": "っていう自分の",
      "startSec": 59.73624999999993,
      "endSec": 60.48000000000002,
      "emphasis": []
    },
    {
      "text": "体のデータを",
      "startSec": 60.48000000000002,
      "endSec": 61.14857142857136,
      "emphasis": []
    },
    {
      "text": "全部わかっている",
      "startSec": 61.14857142857136,
      "endSec": 62.039999999999964,
      "emphasis": []
    },
    {
      "text": "お医者さんと",
      "startSec": 62.039999999999964,
      "endSec": 62.897142857142626,
      "emphasis": []
    },
    {
      "text": "365日24時間",
      "startSec": 62.897142857142626,
      "endSec": 64.03999999999996,
      "emphasis": []
    },
    {
      "text": "アクセスが取れる",
      "startSec": 64.03999999999996,
      "endSec": 64.84000000000015,
      "emphasis": []
    },
    {
      "text": "状態っていうのをまず",
      "startSec": 64.84000000000015,
      "endSec": 65.84000000000015,
      "emphasis": []
    },
    {
      "text": "提供していますと",
      "startSec": 65.84000000000015,
      "endSec": 67.02000000000044,
      "emphasis": []
    },
    {
      "text": "これによってですね",
      "startSec": 67.02000000000044,
      "endSec": 68.20000000000027,
      "emphasis": []
    },
    {
      "text": "そもそも病院で検査を",
      "startSec": 68.20000000000027,
      "endSec": 69.90000000000009,
      "emphasis": []
    },
    {
      "text": "受けるべきなのかとか",
      "startSec": 69.90000000000009,
      "endSec": 70.90000000000009,
      "emphasis": []
    },
    {
      "text": "これは病院に行ったら",
      "startSec": 71.60000000000036,
      "endSec": 72.65000000000055,
      "emphasis": []
    },
    {
      "text": "どういう薬が出るもので",
      "startSec": 72.65000000000055,
      "endSec": 73.86529629629649,
      "emphasis": []
    },
    {
      "text": "これは市販薬で",
      "startSec": 73.86529629629649,
      "endSec": 74.63866666666672,
      "emphasis": []
    },
    {
      "text": "は解決できない",
      "startSec": 74.63866666666672,
      "endSec": 75.46000000000004,
      "emphasis": []
    },
    {
      "text": "課題なのか",
      "startSec": 75.46000000000004,
      "endSec": 76.09529411764697,
      "emphasis": []
    },
    {
      "text": "とかですねまあそういう",
      "startSec": 76.09529411764697,
      "endSec": 77.26000000000022,
      "emphasis": []
    },
    {
      "text": "ちょっとした壁打ちを",
      "startSec": 77.26000000000022,
      "endSec": 78.60166666666692,
      "emphasis": []
    },
    {
      "text": "365日24時間",
      "startSec": 78.60166666666692,
      "endSec": 79.67500000000018,
      "emphasis": []
    },
    {
      "text": "できますよと",
      "startSec": 79.67500000000018,
      "endSec": 80.48000000000002,
      "emphasis": []
    },
    {
      "text": "それによって",
      "startSec": 80.48000000000002,
      "endSec": 81.3760000000002,
      "emphasis": []
    },
    {
      "text": "この時間がないとか",
      "startSec": 81.3760000000002,
      "endSec": 82.72000000000025,
      "emphasis": []
    },
    {
      "text": "めんどくさいとか",
      "startSec": 82.72000000000025,
      "endSec": 83.95230769230784,
      "emphasis": []
    },
    {
      "text": "こういう",
      "startSec": 83.95230769230784,
      "endSec": 84.5,
      "emphasis": []
    },
    {
      "text": "理由でですね",
      "startSec": 84.5,
      "endSec": 85.24769230769243,
      "emphasis": []
    },
    {
      "text": "医療を後回しに",
      "startSec": 85.24769230769243,
      "endSec": 86.12000000000035,
      "emphasis": []
    },
    {
      "text": "してしまうということを",
      "startSec": 86.12000000000035,
      "endSec": 87.73764705882377,
      "emphasis": []
    },
    {
      "text": "防いでいます",
      "startSec": 87.73764705882377,
      "endSec": 88.62000000000035,
      "emphasis": []
    }
  ],
  "cameraSwitches": [
    {
      "atSec": 0,
      "camera": "front"
    }
  ]
}
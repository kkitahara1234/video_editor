{
  "shortId": "short-011",
  "title": "投資対効果の真実",
  "startSec": 2735.26,
  "endSec": 2798.5,
  "telops": [
    {
      "text": "というのが",
      "startSec": 0,
      "endSec": 1.1071428571426623,
      "emphasis": []
    },
    {
      "text": "特徴になっています普通に",
      "startSec": 1.1071428571426623,
      "endSec": 3.7199999999998,
      "emphasis": []
    },
    {
      "text": "いい人間ドック",
      "startSec": 3.7199999999998,
      "endSec": 4.601176470588143,
      "emphasis": []
    },
    {
      "text": "受けるだけでもですね",
      "startSec": 4.601176470588143,
      "endSec": 5.859999999999673,
      "emphasis": []
    },
    {
      "text": "20万円",
      "startSec": 5.859999999999673,
      "endSec": 6.294285714285252,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "20万円"
        }
      ]
    },
    {
      "text": "30万円とかしますし",
      "startSec": 6.294285714285252,
      "endSec": 7.379999999999654,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "30万円"
        }
      ]
    },
    {
      "text": "学んだらね高級",
      "startSec": 7.379999999999654,
      "endSec": 8.434117647058429,
      "emphasis": []
    },
    {
      "text": "会員制人間ドックとか",
      "startSec": 8.434117647058429,
      "endSec": 9.9399999999996,
      "emphasis": [
        {
          "start": 0,
          "end": 8,
          "label": "会員制人間ドック"
        }
      ]
    },
    {
      "text": "だと検査だけで",
      "startSec": 9.9399999999996,
      "endSec": 10.799999999999727,
      "emphasis": []
    },
    {
      "text": "年間50万円",
      "startSec": 10.799999999999727,
      "endSec": 11.444999999999709,
      "emphasis": [
        {
          "start": 0,
          "end": 6,
          "label": "年間50万円"
        }
      ]
    },
    {
      "text": "60万円するところも",
      "startSec": 11.444999999999709,
      "endSec": 12.519999999999982,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "60万円"
        }
      ]
    },
    {
      "text": "たくさんありますので",
      "startSec": 12.519999999999982,
      "endSec": 13.630999999999858,
      "emphasis": []
    },
    {
      "text": "まあそういうふうに",
      "startSec": 13.630999999999858,
      "endSec": 14.539999999999964,
      "emphasis": []
    },
    {
      "text": "考えるとですね",
      "startSec": 14.539999999999964,
      "endSec": 15.379999999999654,
      "emphasis": []
    },
    {
      "text": "このただ検査を",
      "startSec": 15.379999999999654,
      "endSec": 16.310588235293835,
      "emphasis": []
    },
    {
      "text": "するだけではなくその",
      "startSec": 16.310588235293835,
      "endSec": 17.639999999999873,
      "emphasis": []
    },
    {
      "text": "データをもとにしっかりと",
      "startSec": 17.639999999999873,
      "endSec": 18.919999999999618,
      "emphasis": []
    },
    {
      "text": "フィードバックを受けて",
      "startSec": 18.919999999999618,
      "endSec": 19.799999999999727,
      "emphasis": []
    },
    {
      "text": "健康のPDCA",
      "startSec": 19.799999999999727,
      "endSec": 20.81333333333305,
      "emphasis": []
    },
    {
      "text": "を回していける",
      "startSec": 20.81333333333305,
      "endSec": 21.699999999999818,
      "emphasis": []
    },
    {
      "text": "ことだったりとか",
      "startSec": 21.699999999999818,
      "endSec": 22.139999999999873,
      "emphasis": []
    },
    {
      "text": "365日ですねこの",
      "startSec": 22.83999999999969,
      "endSec": 24.419999999999618,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "365日"
        }
      ]
    },
    {
      "text": "コンシェルジュデスクとか",
      "startSec": 24.419999999999618,
      "endSec": 26.073333333332812,
      "emphasis": []
    },
    {
      "text": "間を挟まずに",
      "startSec": 26.073333333332812,
      "endSec": 26.899999999999636,
      "emphasis": []
    },
    {
      "text": "直接ドクターとやり取り",
      "startSec": 26.899999999999636,
      "endSec": 28.078571428571195,
      "emphasis": []
    },
    {
      "text": "できる",
      "startSec": 28.078571428571195,
      "endSec": 28.399999999999636,
      "emphasis": []
    },
    {
      "text": "スムーズさだったりとか",
      "startSec": 28.399999999999636,
      "endSec": 29.5962499999996,
      "emphasis": []
    },
    {
      "text": "そしてこの",
      "startSec": 29.5962499999996,
      "endSec": 30.139999999999873,
      "emphasis": []
    },
    {
      "text": "素晴らしい",
      "startSec": 30.139999999999873,
      "endSec": 30.771578947368198,
      "emphasis": []
    },
    {
      "text": "Longevity",
      "startSec": 30.771578947368198,
      "endSec": 31.90842105263164,
      "emphasis": [
        {
          "start": 0,
          "end": 9,
          "label": "Longevity"
        }
      ]
    },
    {
      "text": "健康寿命を",
      "startSec": 31.90842105263164,
      "endSec": 32.539999999999964,
      "emphasis": []
    },
    {
      "text": "伸ばすということに対して",
      "startSec": 32.539999999999964,
      "endSec": 33.73999999999978,
      "emphasis": []
    },
    {
      "text": "関心の高い素敵な会員様の",
      "startSec": 33.73999999999978,
      "endSec": 35.59999999999991,
      "emphasis": []
    },
    {
      "text": "コミュニティも",
      "startSec": 35.59999999999991,
      "endSec": 36.35599999999977,
      "emphasis": []
    },
    {
      "text": "あるというふうに",
      "startSec": 36.35599999999977,
      "endSec": 37.2199999999998,
      "emphasis": []
    },
    {
      "text": "考えるとですね",
      "startSec": 37.2199999999998,
      "endSec": 38.58533333333298,
      "emphasis": []
    },
    {
      "text": "まあ非常にあの",
      "startSec": 38.58533333333298,
      "endSec": 39.779999999999745,
      "emphasis": []
    },
    {
      "text": "リーズナブルな投資になる",
      "startSec": 39.779999999999745,
      "endSec": 40.64399999999978,
      "emphasis": []
    },
    {
      "text": "んじゃないかな",
      "startSec": 40.64399999999978,
      "endSec": 41.14799999999968,
      "emphasis": []
    },
    {
      "text": "というふうに",
      "startSec": 41.14799999999968,
      "endSec": 41.57999999999993,
      "emphasis": []
    },
    {
      "text": "考えています",
      "startSec": 41.57999999999993,
      "endSec": 42.63999999999987,
      "emphasis": []
    },
    {
      "text": "もちろん月額5万円てね",
      "startSec": 42.63999999999987,
      "endSec": 44.314444444444234,
      "emphasis": []
    },
    {
      "text": "聞くと安くない",
      "startSec": 44.314444444444234,
      "endSec": 45.379999999999654,
      "emphasis": []
    },
    {
      "text": "金額だとは",
      "startSec": 45.379999999999654,
      "endSec": 46.21760683760658,
      "emphasis": []
    },
    {
      "text": "思いますけれども",
      "startSec": 46.21760683760658,
      "endSec": 47.557777777777574,
      "emphasis": []
    },
    {
      "text": "確実にね",
      "startSec": 47.557777777777574,
      "endSec": 48.179999999999836,
      "emphasis": []
    },
    {
      "text": "中長期で見た時に",
      "startSec": 48.179999999999836,
      "endSec": 49.345714285714166,
      "emphasis": []
    },
    {
      "text": "投資対効果が",
      "startSec": 49.345714285714166,
      "endSec": 50.2199999999998,
      "emphasis": []
    },
    {
      "text": "あってくるもの",
      "startSec": 50.2199999999998,
      "endSec": 50.96374999999989,
      "emphasis": []
    },
    {
      "text": "だと思っていますしこの",
      "startSec": 50.96374999999989,
      "endSec": 52.31384615384604,
      "emphasis": []
    },
    {
      "text": "コミュニティだったりとか",
      "startSec": 52.31384615384604,
      "endSec": 53.542769230768954,
      "emphasis": []
    },
    {
      "text": "ねまあ",
      "startSec": 53.542769230768954,
      "endSec": 53.849999999999454,
      "emphasis": []
    },
    {
      "text": "定期的な検査という部分に",
      "startSec": 53.849999999999454,
      "endSec": 55.25999999999976,
      "emphasis": []
    },
    {
      "text": "関してはもう目の前でも",
      "startSec": 55.25999999999976,
      "endSec": 56.45999999999958,
      "emphasis": []
    },
    {
      "text": "リターンが得られ",
      "startSec": 56.45999999999958,
      "endSec": 57.2519999999995,
      "emphasis": []
    },
    {
      "text": "るものになっていますので",
      "startSec": 57.2519999999995,
      "endSec": 58.41999999999962,
      "emphasis": []
    },
    {
      "text": "ぜひですねまあ",
      "startSec": 58.83999999999969,
      "endSec": 59.811249999999745,
      "emphasis": []
    },
    {
      "text": "健康に豊かな人生を",
      "startSec": 59.811249999999745,
      "endSec": 61.059999999999945,
      "emphasis": []
    }
  ],
  "cameraSwitches": [
    {
      "atSec": 0,

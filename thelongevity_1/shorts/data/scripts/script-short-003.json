{
  "shortId": "short-003",
  "title": "効果的なトレーニング法",
  "startSec": 951.3,
  "endSec": 1022.3,
  "telops": [
    {
      "text": "ということをまあ意識して",
      "startSec": 0.04000000000007731,
      "endSec": 1.1600000000000819,
      "emphasis": []
    },
    {
      "text": "やっていまして",
      "startSec": 1.1600000000000819,
      "endSec": 2.3333333333333712,
      "emphasis": []
    },
    {
      "text": "具体的にはですねまぁ",
      "startSec": 2.3333333333333712,
      "endSec": 3.800000000000068,
      "emphasis": []
    },
    {
      "text": "坂道トレーニングですね",
      "startSec": 3.800000000000068,
      "endSec": 4.780000000000086,
      "emphasis": []
    },
    {
      "text": "だいたいまあ傾斜をね",
      "startSec": 4.780000000000086,
      "endSec": 7.1200000000000045,
      "emphasis": []
    },
    {
      "text": "トレッドミルとか",
      "startSec": 7.1200000000000045,
      "endSec": 8.07000000000005,
      "emphasis": []
    },
    {
      "text": "だとつけられると思う",
      "startSec": 8.07000000000005,
      "endSec": 9.319019607843188,
      "emphasis": []
    },
    {
      "text": "んですけれども",
      "startSec": 9.319019607843188,
      "endSec": 10.193333333333385,
      "emphasis": []
    },
    {
      "text": "おすすめは",
      "startSec": 10.193333333333385,
      "endSec": 10.780000000000086,
      "emphasis": []
    },
    {
      "text": "だいたい10から",
      "startSec": 10.780000000000086,
      "endSec": 12.033333333333417,
      "emphasis": [
        {
          "start": 4,
          "end": 6,
          "label": "10"
        }
      ]
    },
    {
      "text": "12ぐらいのまぁ少し",
      "startSec": 12.033333333333417,
      "endSec": 13.600000000000023,
      "emphasis": [
        {
          "start": 0,
          "end": 2,
          "label": "12"
        }
      ]
    },
    {
      "text": "ちょっと坂だなっていう",
      "startSec": 13.600000000000023,
      "endSec": 14.796249999999986,
      "emphasis": []
    },
    {
      "text": "感じですね",
      "startSec": 14.796249999999986,
      "endSec": 15.340000000000032,
      "emphasis": []
    },
    {
      "text": "の傾斜で",
      "startSec": 15.340000000000032,
      "endSec": 15.5,
      "emphasis": []
    },
    {
      "text": "時速5キロから",
      "startSec": 15.590000000000032,
      "endSec": 17.04600000000005,
      "emphasis": []
    },
    {
      "text": "調子が良いときで",
      "startSec": 17.04600000000005,
      "endSec": 18.710000000000036,
      "emphasis": []
    },
    {
      "text": "6キロ以下ぐらいの",
      "startSec": 18.710000000000036,
      "endSec": 20.09888888888895,
      "emphasis": []
    },
    {
      "text": "スピードで歩いて",
      "startSec": 20.09888888888895,
      "endSec": 21.210000000000036,
      "emphasis": []
    },
    {
      "text": "もらうとこれで",
      "startSec": 21.210000000000036,
      "endSec": 22.050000000000068,
      "emphasis": []
    },
    {
      "text": "40分ぐらい",
      "startSec": 22.050000000000068,
      "endSec": 22.63000000000011,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "40分"
        }
      ]
    },
    {
      "text": "じっくり歩くっていうのを",
      "startSec": 22.63000000000011,
      "endSec": 23.790000000000077,
      "emphasis": []
    },
    {
      "text": "週に3〜4回",
      "startSec": 23.790000000000077,
      "endSec": 24.129999999999995,
      "emphasis": [
        {
          "start": 0,
          "end": 6,
          "label": "週に3〜4回"
        }
      ]
    },
    {
      "text": "やるとこれは",
      "startSec": 24.129999999999995,
      "endSec": 25.790000000000077,
      "emphasis": []
    },
    {
      "text": "ゾーン2トレーニング",
      "startSec": 25.790000000000077,
      "endSec": 26.790000000000077,
      "emphasis": []
    },
    {
      "text": "ですねとして",
      "startSec": 26.790000000000077,
      "endSec": 27.3900000000001,
      "emphasis": []
    },
    {
      "text": "まさに脂肪酸",
      "startSec": 27.3900000000001,
      "endSec": 28.246000000000095,
      "emphasis": []
    },
    {
      "text": "代謝をうまく回して",
      "startSec": 28.246000000000095,
      "endSec": 29.530000000000086,
      "emphasis": []
    },
    {
      "text": "ミトコンドリアの",
      "startSec": 29.530000000000086,
      "endSec": 30.28555555555556,
      "emphasis": []
    },
    {
      "text": "機能を改善するために",
      "startSec": 30.28555555555556,
      "endSec": 31.230000000000018,
      "emphasis": []
    },
    {
      "text": "やっています",
      "startSec": 31.230000000000018,
      "endSec": 32.629999999999995,
      "emphasis": []
    },
    {
      "text": "あとはですねまぁ",
      "startSec": 32.629999999999995,
      "endSec": 34.23000000000002,
      "emphasis": []
    },
    {
      "text": "筋力トレーニングを",
      "startSec": 34.23000000000002,
      "endSec": 35.010000000000105,
      "emphasis": []
    },
    {
      "text": "まあだいたい",
      "startSec": 35.010000000000105,
      "endSec": 35.530000000000086,
      "emphasis": []
    },
    {
      "text": "週2から3回ですね",
      "startSec": 35.530000000000086,
      "endSec": 36.63117647058823,
      "emphasis": [
        {
          "start": 0,
          "end": 6,
          "label": "週2から3回"
        }
      ]
    },
    {
      "text": "まぁ部位で分けて",
      "startSec": 36.63117647058823,
      "endSec": 37.610000000000014,
      "emphasis": []
    },
    {
      "text": "実施してますけれども",
      "startSec": 37.610000000000014,
      "endSec": 37.81000000000006,
      "emphasis": []
    },
    {
      "text": "これまさに筋力を",
      "startSec": 37.81000000000006,
      "endSec": 39.870000000000005,
      "emphasis": []
    },
    {
      "text": "維持するということですね",
      "startSec": 39.870000000000005,
      "endSec": 41.26764705882351,
      "emphasis": []
    },
    {
      "text": "その中には",
      "startSec": 41.26764705882351,
      "endSec": 41.85000000000002,
      "emphasis": []
    },
    {
      "text": "ブルガリアンスクワット",
      "startSec": 41.85000000000002,
      "endSec": 42.986842105263236,
      "emphasis": []
    },
    {
      "text": "みたいなですね",
      "startSec": 42.986842105263236,
      "endSec": 43.65000000000009,
      "emphasis": []
    },
    {
      "text": "こうバランス感覚を整えて",
      "startSec": 43.65000000000009,
      "endSec": 46.47000000000003,
      "emphasis": []
    },
    {
      "text": "安定性保持するような",
      "startSec": 46.47000000000003,
      "endSec": 47.21117647058827,
      "emphasis": []
    },
    {
      "text": "トレーニングも",
      "startSec": 47.21117647058827,
      "endSec": 47.73000000000002,
      "emphasis": []
    },
    {
      "text": "しっかり組み込んでですね",
      "startSec": 47.73000000000002,
      "endSec": 48.55000000000007,
      "emphasis": []
    },
    {
      "text": "ただ筋肉を大きく",
      "startSec": 48.930000000000064,
      "endSec": 50.13000000000011,
      "emphasis": []
    },
    {
      "text": "するんじゃなくて",
      "startSec": 50.13000000000011,
      "endSec": 51.33000000000004,
      "emphasis": []
    },
    {
      "text": "動ける筋肉という",
      "startSec": 51.33000000000004,
      "endSec": 52.221428571428646,
      "emphasis": []
    },
    {
      "text": "のを意識して",
      "startSec": 52.221428571428646,
      "endSec": 52.8900000000001,
      "emphasis": []
    },
    {
      "text": "増やしていってますと",
      "startSec": 52.8900000000001,
      "endSec": 54.29000000000008,
      "emphasis": []
    },
    {
      "text": "でVO2max",
      "startSec": 54.29000000000008,
      "endSec": 54.91000000000008,
      "emphasis": [
        {
          "start": 1,
          "end": 7,
          "label": "VO2max"
        }
      ]
    },
    {
      "text": "トレーニングに",
      "startSec": 54.91000000000008,
      "endSec": 55.530000000000086,
      "emphasis": []
    },
    {
      "text": "関してはそうですね",
      "startSec": 55.530000000000086,
      "endSec": 56.30000000000007,
      "emphasis": []
    },
    {
      "text": "そのヒートとかをね",
      "startSec": 56.30000000000007,
      "endSec": 57.07000000000005,
      "emphasis": []
    },
    {
      "text": "取り入れて",
      "startSec": 57.07000000000005,
      "endSec": 58.00428571428574,
      "emphasis": []
    },
    {
      "text": "いけるとまあ理想",
      "startSec": 58.00428571428574,
      "endSec": 59.25,
      "emphasis": []
    },
    {
      "text": "なんですけれども",
      "startSec": 59.25,
      "endSec": 60.25923076923084,
      "emphasis": []
    },
    {
      "text": "なかなかね",
      "startSec": 60.25923076923084,
      "endSec": 60.8900000000001,
      "emphasis": []
    },
    {
      "text": "腰が重かったり",
      "startSec": 60.8900000000001,
      "endSec": 61.87933333333342,
      "emphasis": []
    },
    {
      "text": "するのでヒートを",
      "startSec": 61.87933333333342,
      "endSec": 63.00999999999999,
      "emphasis": []
    },
    {
      "text": "やるかもし難しければその",
      "startSec": 63.00999999999999,
      "endSec": 65.07000000000005,
      "emphasis": []
    },
    {
      "text": "ウォーキングの",
      "startSec": 65.07000000000005,
      "endSec": 65.55000000000007,
      "emphasis": []
    },
    {
      "text": "最後にですね",
      "startSec": 65.55000000000007,
      "endSec": 66.45125000000007,
      "emphasis": []
    },
    {
      "text": "1分間2分間ぐらい",
      "startSec": 66.45125000000007,
      "endSec": 67.61000000000001,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "1分間"
        }
      ]
    },
    {
      "text": "ちょっとバッと",
      "startSec": 67.61000000000001,
      "endSec": 68.18647058823535,
      "emphasis": []
    },
    {
      "text": "ダッシュするみたいな",
      "startSec": 68.18647058823535,
      "endSec": 69.00999999999999,
      "emphasis": []
    },
    {
      "text": "ことをやったりしています",
      "startSec": 69.00999999999999,
      "endSec": 70.97000000000003,
      "emphasis": []
    }
  ],

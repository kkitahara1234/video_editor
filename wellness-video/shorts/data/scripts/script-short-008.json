      "endSec": 91.23999999999978,
      "emphasis": []
    },
    {
      "text": "アクセス",
      "startSec": 91.23999999999978,
      "endSec": 91.54399999999987,
      "emphasis": []
    },
    {
      "text": "できるようにサポートを",
      "startSec": 91.54399999999987,

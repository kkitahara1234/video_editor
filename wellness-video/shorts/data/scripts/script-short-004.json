{
  "shortId": "short-004",
  "title": "早期発見の重要性",
  "startSec": 1198.94,
  "endSec": 1287.62,
  "telops": [
    {
      "text": "わかりやすい例で",
      "startSec": 0,
      "endSec": 1.0799999999999272,
      "emphasis": []
    },
    {
      "text": "言うとですね例えば",
      "startSec": 1.0799999999999272,
      "endSec": 1.849999999999909,
      "emphasis": []
    },
    {
      "text": "じゃあ大腸がんって",
      "startSec": 1.849999999999909,
      "endSec": 2.619999999999891,
      "emphasis": []
    },
    {
      "text": "いう病気が",
      "startSec": 2.619999999999891,
      "endSec": 3.0507692307692196,
      "emphasis": []
    },
    {
      "text": "ありますけれども",
      "startSec": 3.0507692307692196,
      "endSec": 3.740000000000009,
      "emphasis": []
    },
    {
      "text": "大腸がんってですね",
      "startSec": 3.740000000000009,
      "endSec": 4.919999999999845,
      "emphasis": []
    },
    {
      "text": "ステージ0とか",
      "startSec": 5.2000000000000455,
      "endSec": 6.049333333333379,
      "emphasis": []
    },
    {
      "text": "1で見つけることが",
      "startSec": 6.049333333333379,
      "endSec": 7.392339250493023,
      "emphasis": []
    },
    {
      "text": "できれば",
      "startSec": 7.392339250493023,
      "endSec": 7.989230769230744,
      "emphasis": []
    },
    {
      "text": "95%近く助かる",
      "startSec": 7.989230769230744,
      "endSec": 9.539999999999964,
      "emphasis": [
        {
          "start": 0,
          "end": 5,
          "label": "95%近く"
        }
      ]
    },
    {
      "text": "病気なんですね",
      "startSec": 9.539999999999964,
      "endSec": 10.460000000000036,
      "emphasis": []
    },
    {
      "text": "ところがステージ4ってね",
      "startSec": 10.460000000000036,
      "endSec": 12.440000000000055,
      "emphasis": []
    },
    {
      "text": "進行してしまったがんの",
      "startSec": 12.5,
      "endSec": 13.99285714285702,
      "emphasis": []
    },
    {
      "text": "状態になってしまうと",
      "startSec": 13.99285714285702,
      "endSec": 15.593846153846016,
      "emphasis": []
    },
    {
      "text": "残念ながら",
      "startSec": 15.593846153846016,
      "endSec": 16.339999999999918,
      "emphasis": [
        {
          "start": 0,
          "end": 5,
          "label": "残念ながら"
        }
      ]
    },
    {
      "text": "5年生存率っていう",
      "startSec": 16.339999999999918,
      "endSec": 17.472941176470613,
      "emphasis": []
    },
    {
      "text": "5年間生きられる",
      "startSec": 17.472941176470613,
      "endSec": 18.480000000000018,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "5年間"
        }
      ]
    },
    {
      "text": "確率が18%まで",
      "startSec": 18.480000000000018,
      "endSec": 19.40800000000013,
      "emphasis": []
    },
    {
      "text": "下がってきます",
      "startSec": 19.40800000000013,
      "endSec": 20.220000000000027,
      "emphasis": []
    },
    {
      "text": "なんでも5人に",
      "startSec": 20.419999999999845,
      "endSec": 21.44374999999991,
      "emphasis": []
    },
    {
      "text": "1人も生きられない",
      "startSec": 21.44374999999991,
      "endSec": 22.75999999999999,
      "emphasis": [
        {
          "start": 0,
          "end": 2,
          "label": "1人"
        }
      ]
    },
    {
      "text": "ということですね",
      "startSec": 22.75999999999999,
      "endSec": 24.665882352941026,
      "emphasis": []
    },
    {
      "text": "皆さんですねこの",
      "startSec": 24.665882352941026,
      "endSec": 26.3599999999999,
      "emphasis": []
    },
    {
      "text": "症状が出て体調が",
      "startSec": 26.3599999999999,
      "endSec": 27.539999999999964,
      "emphasis": []
    },
    {
      "text": "悪くなって病院に",
      "startSec": 27.539999999999964,
      "endSec": 28.720000000000027,
      "emphasis": []
    },
    {
      "text": "行ってそこからですね",
      "startSec": 28.720000000000027,
      "endSec": 29.8599999999999,
      "emphasis": []
    },
    {
      "text": "初めて病気が",
      "startSec": 29.8599999999999,
      "endSec": 30.819999999999936,
      "emphasis": []
    },
    {
      "text": "進行していることに",
      "startSec": 30.819999999999936,
      "endSec": 32.25999999999999,
      "emphasis": []
    },
    {
      "text": "気づいてですね",
      "startSec": 32.25999999999999,
      "endSec": 33.46533333333332,
      "emphasis": []
    },
    {
      "text": "もう何億円でも",
      "startSec": 33.46533333333332,
      "endSec": 34.51999999999998,
      "emphasis": []
    },
    {
      "text": "払うからいい先生を",
      "startSec": 34.51999999999998,
      "endSec": 35.549999999999955,
      "emphasis": []
    },
    {
      "text": "連れてきてくれとか",
      "startSec": 35.549999999999955,
      "endSec": 36.57999999999993,
      "emphasis": []
    },
    {
      "text": "最先端の治療を",
      "startSec": 36.659999999999854,
      "endSec": 37.38333333333321,
      "emphasis": []
    },
    {
      "text": "受けさせてくれっていう",
      "startSec": 37.38333333333321,
      "endSec": 38.51999999999998,
      "emphasis": []
    },
    {
      "text": "ふうに",
      "startSec": 38.51999999999998,
      "endSec": 38.81538461538457,
      "emphasis": []
    },
    {
      "text": "てんやわんやする方が",
      "startSec": 38.81538461538457,
      "endSec": 39.799999999999955,
      "emphasis": []
    },
    {
      "text": "すごく多いんですけれども",
      "startSec": 39.799999999999955,
      "endSec": 41.39529411764693,
      "emphasis": []
    },
    {
      "text": "当たり前の",
      "startSec": 41.39529411764693,
      "endSec": 42.059999999999945,
      "emphasis": []
    },
    {
      "text": "当たり前の",
      "startSec": 42.059999999999945,
      "endSec": 42.417142857142835,
      "emphasis": []
    },
    {
      "text": "話なんですけれども",
      "startSec": 42.417142857142835,
      "endSec": 43.059999999999945,
      "emphasis": []
    },
    {
      "text": "ステージ",
      "startSec": 43.27999999999997,
      "endSec": 43.72923076923075,
      "emphasis": []
    },
    {
      "text": "4というですねその",
      "startSec": 43.72923076923075,
      "endSec": 44.74000000000001,
      "emphasis": []
    },
    {
      "text": "進行したがんを",
      "startSec": 44.74000000000001,
      "endSec": 45.74624999999992,
      "emphasis": []
    },
    {
      "text": "世界一の医者に見て",
      "startSec": 45.74624999999992,
      "endSec": 47.039999999999964,
      "emphasis": []
    },
    {
      "text": "もらうよりもですね",
      "startSec": 47.039999999999964,
      "endSec": 48.98285714285703,
      "emphasis": []
    },
    {
      "text": "まあこの",
      "startSec": 48.98285714285703,
      "endSec": 49.75999999999999,
      "emphasis": []
    },
    {
      "text": "ステージ0とか1っていう",
      "startSec": 49.75999999999999,
      "endSec": 51.21142857142854,
      "emphasis": []
    },
    {
      "text": "早期のがんをですね",
      "startSec": 51.21142857142854,
      "endSec": 52.299999999999955,
      "emphasis": []
    },
    {
      "text": "ほんとその",
      "startSec": 52.299999999999955,
      "endSec": 53.21428571428555,
      "emphasis": [
        {
          "start": 0,
          "end": 3,
          "label": "ほんと"
        }
      ]
    },
    {
      "text": "辺にいると言ったら",
      "startSec": 53.21428571428555,
      "endSec": 54.8599999999999,
      "emphasis": []
    },
    {
      "text": "失礼ですけれども",
      "startSec": 54.8599999999999,
      "endSec": 56.36999999999989,
      "emphasis": []
    },
    {
      "text": "一般的な先生に見て",
      "startSec": 56.36999999999989,
      "endSec": 57.87999999999988,
      "emphasis": []
    },
    {
      "text": "もらった方がですね",
      "startSec": 57.87999999999988,
      "endSec": 59.02749999999992,
      "emphasis": []
    },
    {
      "text": "圧倒的に助かる",
      "startSec": 59.02749999999992,
      "endSec": 59.919999999999845,
      "emphasis": [
        {
          "start": 0,
          "end": 4,
          "label": "圧倒的に"
        }
      ]
    },
    {
      "text": "確率は高いんですね",
      "startSec": 59.919999999999845,
      "endSec": 60.8599999999999,
      "emphasis": []
    },
    {
      "text": "なので皆さん課題が",
      "startSec": 61.51999999999998,
      "endSec": 63.1717647058822,
      "emphasis": []
    },
    {
      "text": "顕在化して問題が",
      "startSec": 63.1717647058822,
      "endSec": 64.63999999999987,
      "emphasis": []
    },
    {
      "text": "起こってからですね",
      "startSec": 64.63999999999987,
      "endSec": 65.59999999999991,
      "emphasis": []
    },
    {
      "text": "ベストなソリューションを",
      "startSec": 65.59999999999991,
      "endSec": 67.01714285714274,
      "emphasis": []
    },
    {
      "text": "探すっていうことを",
      "startSec": 67.01714285714274,
      "endSec": 68.07999999999993,
      "emphasis": []
    },
    {
      "text": "考えがちなんですけれども",
      "startSec": 68.07999999999993,
      "endSec": 69.17999999999984,
      "emphasis": []
    },
    {
      "text": "目的から逆算",
      "startSec": 69.33999999999992,
      "endSec": 70.28499999999985,
      "emphasis": []
    },
    {
      "text": "したらですねそもそも",
      "startSec": 70.28499999999985,
      "endSec": 71.8599999999999,
      "emphasis": []
    },
    {
      "text": "病気を早く見つけるとか",
      "startSec": 71.8599999999999,
      "endSec": 73.69999999999982,
      "emphasis": []
    },
    {
      "text": "自分の",
      "startSec": 73.69999999999982,
      "endSec": 74.15999999999985,
      "emphasis": []
    },
    {
      "text": "リスクを事前にしてそも",
      "startSec": 74.15999999999985,
      "endSec": 75.23130434782593,
      "emphasis": []
    },
    {
      "text": "そも病気にならないように",
      "startSec": 75.23130434782593,
      "endSec": 76.39999999999986,
      "emphasis": []
    },
    {
      "text": "することの方が",
      "startSec": 76.39999999999986,
      "endSec": 77.25999999999976,
      "emphasis": [
        {
          "start": 0,
          "end": 6,
          "label": "圧倒的に"
        }
      ]
    },
    {
      "text": "圧倒的に価値が",
      "startSec": 77.25999999999976,
      "endSec": 78.11999999999989,
      "emphasis": []
    },
    {
      "text": "高いのでそういうね",
      "startSec": 78.11999999999989,
      "endSec": 79.61999999999989,
      "emphasis": []
    },
    {
      "text": "世界を僕らも",
      "startSec": 79.61999999999989,
      "endSec": 80.61999999999989,
      "emphasis": []
    },
    {
      "text": "実現していきたいですし",
      "startSec": 80.61999999999989,
      "endSec": 82.68666666666672,
      "emphasis": []
    },
    {
      "text": "そっちの方が",
      "startSec": 82.68666666666672,
      "endSec": 83.72000000000003,
      "emphasis": []
    },
    {
      "text": "圧倒的にですね皆様の",
      "startSec": 83.72000000000003,
      "endSec": 85.09999999999991,
      "emphasis": []
    },
    {
      "text": "良い人生を送るために",
      "startSec": 85.09999999999991,
      "endSec": 86.48000000000002,
      "emphasis": []
    },
    {
      "text": "お力になれる",
      "startSec": 86.48000000000002,
      "endSec": 87.01250000000005,
      "emphasis": []
    },
    {
      "text": "んじゃないかなという",
      "startSec": 87.01250000000005,
      "endSec": 87.89999999999986,
      "emphasis": []
    },
    {
      "text": "ふうに考えています",
      "startSec": 87.89999999999986,
      "endSec": 88.67999999999984,
      "emphasis": []
    }
  ],
